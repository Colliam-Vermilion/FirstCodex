ount="1393050901"><Base value="A" count="259645740"/><Base value="C" count="436892588"/><Base value="G" count="436778969"/><Base value="T" count="259733604"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6823435" alias="ESMetFM39"><IDENTIFIERS><PRIMARY_ID>SRX6823435</PRIMARY_ID></IDENTIFIERS><TITLE>metagenomics sequences of activated sludge bioreactor</TITLE><STUDY_REF accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA559245</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Libraries were sequenced at SCELSE facilities in one lane of an Illumina HiSeq2500 sequencer in rapid mode at a final concentration of 11pM and a read-length of 250 bp paired-end.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5365960"><IDENTIFIERS><PRIMARY_ID>SRS5365960</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12705045</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>ESMetFM39</LIBRARY_NAME><LIBRARY_STRATEGY>WGA</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Singapore Centre for Environmental Life Sciences E" center_name="NTU" accession="SRA959559" alias="SUB6273487"><IDENTIFIERS><PRIMARY_ID>SRA959559</PRIMARY_ID><SUBMITTER_ID namespace="NTU">SUB6273487</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>NTU</Name><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Contact email="esantillan@ucdavis.edu" sec_email="esantillan@ntu.edu.sg"><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Name><First>Ezequiel</First><Last>Santillan</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA559245" accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA559245</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Mesocosm reactors under sustained double organic loading disturbance (with controls), Metagenomes and 16S rRNA gene v3-v4 amplicon Metabarcodes</STUDY_TITLE><STUDY_TYPE existing_study_type="Metagenomics"/><STUDY_ABSTRACT>Sustained perturbations are of interest in microbial ecology as they can drive systems to alternative stable states. Here, we tested the effect of a sustained double organic loading perturbation on structure, assembly and function of activated sludge bacterial communities in sequencing batch bioreactors operated with intermittent aeration. We also focused on the effect of this perturbation in the nitrification function and nitrifiers.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>bioreactor sludge metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><URL_LINK><LABEL>Sustained organic loading perturbation inhibits nitrite oxidation in bioreactors, unveiling variable resistance and resilience of nitrification and nitrifiers</LABEL><URL>https://doi.org/10.1101/605733</URL></URL_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="Bioreactor (SBR) [day 110, level L, rep. 3] metagenomics" accession="SRS5365960"><IDENTIFIERS><PRIMARY_ID>SRS5365960</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12705045</EXTERNAL_ID><SUBMITTER_ID namespace="pda|esantillan" label="Sample name">Bioreactor (SBR) [day 110, level L, rep. 3] metagenomics</SUBMITTER_ID></IDENTIFIERS><TITLE>ESMetFM39</TITLE><SAMPLE_NAME><TAXON_ID>942017</TAXON_ID><SCIENTIFIC_NAME>activated sludge metagenome</SCIENT