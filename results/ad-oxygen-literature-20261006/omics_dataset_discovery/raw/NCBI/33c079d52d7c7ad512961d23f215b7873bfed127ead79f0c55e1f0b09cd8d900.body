</RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX22978664" alias="ESMetFM27"><IDENTIFIERS><PRIMARY_ID>SRX22978664</PRIMARY_ID></IDENTIFIERS><TITLE>metagenomics sequences of activated sludge bioreactor</TITLE><STUDY_REF accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA559245</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Libraries were sequenced at SCELSE facilities in one lane of an Illumina HiSeq2500 sequencer in rapid mode at a final concentration of 11pM and a read-length of 250 bp paired-end.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS19944293"><IDENTIFIERS><PRIMARY_ID>SRS19944293</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN38771214</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>ESMetFM27</LIBRARY_NAME><LIBRARY_STRATEGY>WGA</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Singapore Centre for Environmental Life Sciences E" center_name="Nanyang Technological University" accession="SRA1773018" alias="SUB14036562"><IDENTIFIERS><PRIMARY_ID>SRA1773018</PRIMARY_ID><SUBMITTER_ID namespace="Nanyang Technological University">SUB14036562</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="http://www.scelse.sg/"><Name>Nanyang Technological University</Name><Address postal_code="637551"><Department>Singapore Centre for Environmental Life Sciences Engineering</Department><Institution>Nanyang Technological University</Institution><Street>60 Nanyang Drive, SBS-B2n-27, Nanyang Technological University</Street><City>Singapore</City><Sub>State/Province</Sub><Country>Singapore</Country></Address><Contact email="esantillan@ntu.edu.sg" sec_email="ezequielsantillan@gmail.com"><Address postal_code="637551"><Department>Singapore Centre for Environmental Life Sciences Engineering</Department><Institution>Nanyang Technological University</Institution><Street>60 Nanyang Drive, SBS-B2n-27, Nanyang Technological University</Street><City>Singapore</City><Sub>State/Province</Sub><Country>Singapore</Country></Address><Name><First>Ezequiel</First><Last>Santillan</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA559245" accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA559245</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Mesocosm reactors under sustained double organic loading disturbance (with controls), Metagenomes and 16S rRNA gene v3-v4 amplicon Metabarcodes</STUDY_TITLE><STUDY_TYPE existing_study_type="Metagenomics"/><STUDY_ABSTRACT>Sustained perturbations are of interest in microbial ecology as they can drive systems to alternative stable states. Here, we tested the effect of a sustained double organic loading perturbation on structure, assembly and function of activated sludge bacterial communities in sequencing batch bioreactors operated with intermittent aeration. We also focused on the effect of this perturbation in the nitrification function and nitrifiers.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>bioreactor sludge metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><URL_LINK><LABEL>Sustained organic loading perturbation inhibits nitrite oxidation in bioreactors, unveiling variable resistance and resilience of nitrification and nitrifiers</LABEL><URL>https://doi.org/10.1101/605733</URL></URL_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="Bioreactor (SBR) [day 96, level H, rep. 4] metagenome" accession="SRS19944293"><IDENTIFIERS><PRIMARY_ID>SRS19944293</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN38771214</EXTERNAL_ID><SUBMITTER_ID namespace="pda|esantillan" label="Sa