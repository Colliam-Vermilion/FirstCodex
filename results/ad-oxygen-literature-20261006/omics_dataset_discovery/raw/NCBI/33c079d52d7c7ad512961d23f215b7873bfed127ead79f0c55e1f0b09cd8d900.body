 focused on the effect of this perturbation in the nitrification function and nitrifiers.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>bioreactor sludge metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><URL_LINK><LABEL>Sustained organic loading perturbation inhibits nitrite oxidation in bioreactors, unveiling variable resistance and resilience of nitrification and nitrifiers</LABEL><URL>https://doi.org/10.1101/605733</URL></URL_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="Bioreactor (SBR) [day 47, level A, rep. 1]" accession="SRS5354067"><IDENTIFIERS><PRIMARY_ID>SRS5354067</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12660327</EXTERNAL_ID><SUBMITTER_ID namespace="pda|esantillan" label="Sample name">Bioreactor (SBR) [day 47, level A, rep. 1]</SUBMITTER_ID></IDENTIFIERS><TITLE>ESMesFM005</TITLE><SAMPLE_NAME><TAXON_ID>942017</TAXON_ID><SCIENTIFIC_NAME>activated sludge metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>ESMesFM005</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>559245</ID><LABEL>PRJNA559245</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2016-09-27</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>anthropogenic environmental material</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>activated sludge</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>waste material</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Singapore</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>1.3451 N 103.6798 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>chem_oxygen_dem</TAG><VALUE>13</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>nitrate</TAG><VALUE>77.6</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>perturbation</TAG><VALUE>Acclimation period at low F:M and C:N</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>reactor_typ