IPTOR accession="SRS5354104"><IDENTIFIERS><PRIMARY_ID>SRS5354104</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12660383</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>ESMesFM097</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Singapore Centre for Environmental Life Sciences E" center_name="NTU" accession="SRA957318" alias="SUB6267323"><IDENTIFIERS><PRIMARY_ID>SRA957318</PRIMARY_ID><SUBMITTER_ID namespace="NTU">SUB6267323</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>NTU</Name><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Contact email="esantillan@ucdavis.edu" sec_email="esantillan@ntu.edu.sg"><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Name><First>Ezequiel</First><Last>Santillan</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA559245" accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA559245</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Mesocosm reactors under sustained double organic loading disturbance (with controls), Metagenomes and 16S rRNA gene v3-v4 amplicon Metabarcodes</STUDY_TITLE><STUDY_TYPE existing_study_type="Metagenomics"/><STUDY_ABSTRACT>Sustained perturbations are of interest in microbial ecology as they can drive systems to alternative stable states. Here, we tested the effect 