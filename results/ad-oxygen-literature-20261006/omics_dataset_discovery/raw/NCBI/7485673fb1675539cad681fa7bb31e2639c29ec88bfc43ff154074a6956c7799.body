<EXPERIMENT_PACKAGE_SET>
<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX32777761" alias="ZZ49"><IDENTIFIERS><PRIMARY_ID>SRX32777761</PRIMARY_ID></IDENTIFIERS><TITLE>ZZ49</TITLE><STUDY_REF accession="SRP689122"><IDENTIFIERS><PRIMARY_ID>SRP689122</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Using metagenomic sequencing, the diversity of antibiotic resistance genes (ARGs) and methane production mechanisms in samples from different stages of anaerobic digestion of cattle manure were analyzed. The TruSeq library construction, Illumina NovaSeq 6000 platform sequencing, MEGAHIT assembly, and MetaGeneMark gene prediction were employed, followed by functional and taxonomic annotation.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS28637655"><IDENTIFIERS><PRIMARY_ID>SRS28637655</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>ZZ49</LIBRARY_NAME><LIBRARY_STRATEGY>WGS</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>size fractionation</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq 6000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Department of Environmental Science and Engineerin" center_name="Lanzhou University of Technology" accession="SRA2366690" alias="SUB16101079"><IDENTIFIERS><PRIMARY_ID>SRA2366690</PRIMARY_ID><SUBMITTER_ID namespace="Lanzhou University of Technology">SUB16101079</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Lanzhou University of Technology</Name><Address postal_code="730050"><Department>Department of Environmental Science and Engineering</Department><Institution>Lanzhou University of Technology</Institution><Street>No. 36, Pengjiaping Road</Street><City>Lanzhou</City><Sub>Gansu</Sub><Country>China</Country></Address><Contact email="232083000001@lut.edu.cn" sec_email="1519566545@qq.com"><Address postal_code="730050"><Department>Department of Environmental Science and Engineering</Department><Institution>Lanzhou University of Technology</Institution><Street>No. 36, Pengjiaping Road</Street><City>Lanzhou</City><Sub>Gansu</Sub><Country>China</Country></Address><Name><First>Jiabei</First><Last>Shan</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1447957" accession="SRP689122"><IDENTIFIERS><PRIMARY_ID>SRP689122</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1447957</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Synchronously enhanced methanogenesis performance and reduced antibiotic resistance genes of cattle manure anaerobic digestion by air nanobubble water (Metagenome)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This study investigates the effects of adding Air-NBW on system performance during mesophilic and psychrotrophic AD of CM. Further analysis examined the regulatory role of Air-NBW in ARGs transfer, degradation, and ecological risk.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="ZZ49" accession="SRS28637655"><IDENTIFIERS><PRIMARY_ID>SRS28637655</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN57095356</EXTERNAL_ID><SUBMITTER_ID namespace="pda|shanjb99@orcid" label="Sample name">ZZ49</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1861841</TAXON_ID><SCIENTIFIC_NAME>feces metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1447957</ID><LABEL>PRJNA1447957</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Anaerobic digester</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2024-09-04</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China:Gansu</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>36.057 N 103.778 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_mat_process</TAG><VALUE>Fermentation products of