a-pub-zq-3/SRR34943241/SRR34943241.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-107/SRR34943241/SRR34943241.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="1" nspots="70410"><Read index="0" count="70410" average="412.60" stdev="10.97"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="70410"/><Elements count="29050879"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="29050879"><Base value="A" count="7976944"/><Base value="C" count="5624259"/><Base value="G" count="9265665"/><Base value="T" count="6184011"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX30065740" alias="Zhu003_AG3"><IDENTIFIERS><PRIMARY_ID>SRX30065740</PRIMARY_ID></IDENTIFIERS><TITLE>Amplicon sequence of single cell protein produced from different bioreactors with flour wastes</TITLE><STUDY_REF accession="SRP608063"><IDENTIFIERS><PRIMARY_ID>SRP608063</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>DNA from SCP in four food-waste bioreactors was extracted using the PowerSoil kit (MoBio) and quantified with a Nanodrop 2000. Samples (2348 ng/L) were sequenced (Illumina MiSeq) by Research and Testing Laboratories, targeting bacterial V1V3 (28F/519R) and archaeal (519wF/1017R) 16S rRNA.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS26133401"><IDENTIFIERS><PRIMARY_ID>SRS26133401</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Zhu003_AG3</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="The Zuckerberg Institute for Water Research" center_name="Ben Gurion University" accession="SRA2192415" alias="SUB15530209"><IDENTIFIERS><PRIMARY_ID>SRA2192415</PRIMARY_ID><SUBMITTER_ID namespace="Ben Gurion University">SUB15530209</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Ben Gurion University</Name><Address postal_code="8499000"><Department>The Zuckerberg Institute for Water Research</Department><Institution>Ben Gurion University</Institution><Street>Student dorm</Street><City>Midreshet Ben Gurion</City><Country>Israel</Country></Address><Contact email="liqiancaicai@gmail.com" sec_email="qianl@post.bgu.ac.il"><Address postal_code="8499000"><Department>The Zuckerberg Institute for Water Research</Department><Institution>Ben Gurion University</Institution><Street>Student dorm</Street><City>Midreshet Ben Gurion</City><Country>Israel</Country></Address><Name><First>Qian</First><Last>Li</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1304437" accession="SRP608063"><IDENTIFIERS><PRIMARY_ID>SRP608063</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1304437</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial community dynamics and functional potential in microaerophilic assimilation of carbohydrate rich food wastes for single cell protein production in recirculating aquaculture systems</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This project investigates the structure, interactions, and predicted functions of microbial communities involved in the conversion of carbohydrate rich food processing wastes into single cell protein (SCP) using a microaerophilic assimilation side reactor integrated with a recirculating aquaculture system (RAS). Four distinct waste types: potato starch waste, semolina, sugar waste, and wheat flour waste were used as carbon sources to drive microbial growth while recovering nutrients from aquaculture effluent. High throughput 16S rRNA gene amplicon sequencing was performed to characterize bacterial community composition under each treatment. Network and functional prediction analyses were used to identify key taxa and functional pathways involved in nutrient cycling and protein production. The findings provide insights into sustainable waste valorization strategies that simultaneously improve water quality and generate high protein microbial biomass for aquaculture feed.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="Zhu003_AG3" accession="SRS26133401"><IDENTIFIERS><PRIMARY_ID>SRS26133401</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN50557328</EXTERNAL_ID><SUBMITTER_ID namespace="pda|liqiancaicai@gmail.com" label="Sample name">Zhu003_AG3</SUBMITTER_ID></IDENTIFIERS><TITLE>BFW3-R1</TITLE><SAMPLE_NAME><TAXON_ID>1076179</TAXON_ID><SCIENTIFIC_NAME>bioreactor metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1304437</ID><LABEL>PRJNA1304437</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>Organic waste</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Bioreactor with food wastes and fish sludge--position 1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-09-15</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Israel: Midreshet Ben-Gurion</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>not provided</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accessi