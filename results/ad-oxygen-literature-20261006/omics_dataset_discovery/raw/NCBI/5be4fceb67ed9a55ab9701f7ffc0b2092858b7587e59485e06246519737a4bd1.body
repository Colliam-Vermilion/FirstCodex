DENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>DNA from SCP in four food-waste bioreactors was extracted using the PowerSoil kit (MoBio) and quantified with a Nanodrop 2000. Samples (2348 ng/L) were sequenced (Illumina MiSeq) by Research and Testing Laboratories, targeting bacterial V1V3 (28F/519R) and archaeal (519wF/1017R) 16S rRNA.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS26133407"><IDENTIFIERS><PRIMARY_ID>SRS26133407</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Zhu007_AG7</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="The Zuckerberg Institute for Water Research" center_name="Ben Gurion University" accession="SRA2192415" alias="SUB15530209"><IDENTIFIERS><PRIMARY_ID>SRA2192415</PRIMARY_ID><SUBMITTER_ID namespace="Ben Gurion University">SUB15530209</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Ben Gurion University</Name><Address postal_code="8499000"><Department>The Zuckerberg Institute for Water Research</Department><Institution>Ben Gurion University</Institution><Street>Student dorm</Street><City>Midreshet Ben Gurion</City><Country>Israel</Country></Address><Contact email="liqiancaicai@gmail.com" sec_email="qianl@post.bgu.ac.il"><Address postal_code="8499000"><Department>The Zuckerberg Institute for Water Research</Department><Institution>Ben Gurion University</Institution><Street>Student dorm</Street><City>Midreshet Ben Gurion</City><Country>Israel</Country></Address><Name><First>Qian</First><Last>Li</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1304437" accession="SRP608063"><IDENTIFIERS><PRIMARY_ID>SRP608063</PRIMARY_ID><EXTERNAL_ID namespace="BioPro