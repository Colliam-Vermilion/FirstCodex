MINA><INSTRUMENT_MODEL>NextSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="College of Mechanical and Electrical Engineering" center_name="Henan Agricultural University" accession="SRA2477057" alias="SUB16316162"><IDENTIFIERS><PRIMARY_ID>SRA2477057</PRIMARY_ID><SUBMITTER_ID namespace="Henan Agricultural University">SUB16316162</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Henan Agricultural University</Name><Address postal_code="450002"><Department>College of Mechanical and Electrical Engineering</Department><Institution>Henan Agricultural University</Institution><Street>No. 63 Nongye Road, Jinshui District</Street><City>Zhengzhou</City><Country>China</Country></Address><Contact email="zhangyb@stu.henau.edu.cn"><Address postal_code="450002"><Department>College of Mechanical and Electrical Engineering</Department><Institution>Henan Agricultural University</Institution><Street>No. 63 Nongye Road, Jinshui District</Street><City>Zhengzhou</City><Country>China</Country></Address><Name><First>Yibo</First><Last>Zhang</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1491653" accession="SRP716217"><IDENTIFIERS><PRIMARY_ID>SRP716217</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1491653</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial community dynamics during anaerobic digestion of high-ammonia livestock wastewater under different aeration pretreatments</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This BioProject contains Illumina 16S rRNA gene amplicon sequencing data generated to characterize bacterial and archaeal community dynamics during anaerobic digestion of high-ammonia livestock wastewater.Three pretreatment strategies were investigated, including nanobubble aeration pretreatment, conventional aeration pretreatment, and non-aerated control. Samples were collected from anaerobic digestion systems at different incubation stages.The V3-V4 region of bacterial 16S rRNA genes and archaeal 16S rRNA genes were amplified and sequenced separately. Sequencing data were used to investigate microbial succession, nitrogen transformation-related microorganisms, methanogenic archaea, and their relationships with methane production performance during anaerobic digestion.This dataset provides raw sequencing reads for studying microbial mechanisms involved in anaerobic treatment of livestock wastewater under different aeration strategies.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="D4" accession="SRS29816435"><IDENTIFIERS><PRIMARY_ID>SRS29816435</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN61468789</EXTERNAL_ID><SUBMITTER_ID namespace="pda|czw147369@outlook.com" label="Sample name">D4</SUBMITTER_ID></IDENTIFIERS><TITLE>Anaerobic digestion environmental sample D4</TITLE><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>Environmental sample from anaerobic digestion of high-ammonia livestock wastewater under different aeration pretreatments.</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1491653</ID><LABEL>PRJNA1491653</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>anaerobic digestion sludge and wastewater</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>not collected</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>not collected</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ref_biomaterial</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>not collected</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>not collected</VALUE></SAMPL