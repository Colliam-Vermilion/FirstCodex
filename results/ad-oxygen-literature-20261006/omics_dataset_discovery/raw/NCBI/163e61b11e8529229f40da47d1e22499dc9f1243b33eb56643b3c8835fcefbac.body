meta"><Rows count="48239"/><Elements count="29039878"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="29039878"><Base value="A" count="6269829"/><Base value="C" count="7880306"/><Base value="G" count="7930987"/><Base value="T" count="6931958"/><Base value="N" count="26798"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX34207622" alias="C1_Archaea_16S"><IDENTIFIERS><PRIMARY_ID>SRX34207622</PRIMARY_ID></IDENTIFIERS><TITLE>Archaeal 16S rRNA gene amplicon sequencing</TITLE><STUDY_REF accession="SRP716217"><IDENTIFIERS><PRIMARY_ID>SRP716217</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>16S rRNA gene archaeal region sequencing using primers 524F10extF and Arch958RmodR</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS29816434"><IDENTIFIERS><PRIMARY_ID>SRS29816434</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>C1_Archaea_16S</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>NextSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="College of Mechanical and Electrical Engineering" center_name="Henan Agricultural University" accession="SRA2477057" alias="SUB16316162"><IDENTIFIERS><PRIMARY_ID>SRA2477057</PRIMARY_ID><SUBMITTER_ID namespace="Henan Agricultural University">SUB16316162</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Henan Agricultural University</Name><Address postal_code="450002"><Department>College of Mechanical and Electrical Engineering</Department><Institution>Henan Agricultural University</Institution><Street>No. 63 Nongye Road, Jinshui District</Street><City>Zhengzhou</City><Country>China</Country></Address><Contact email="zhangyb@stu.henau.edu.cn"><Address postal_code="450002"><Department>College of Mechanical and Electrical Engineering</Department><Institution>Henan Agricultural University</Institution><Street>No. 63 Nongye Road, Jinshui District</Street><City>Zhengzhou</City><Country>China</Country></Address><Name><First>Yibo</First><Last>Zhang</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1491653" accession="SRP716217"><IDENTIFIERS><PRIMARY_ID>SRP716217</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1491653</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial community dynamics during anaerobic digestion of high-ammonia livestock wastewater under different aeration pretreatments</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This BioProject contains Illumina 16S rRNA gene amplicon sequencing data generated to characterize bacterial and archaeal community dynamics during anaerobic digestion of high-ammonia livestock wastewater.Three pretreatment strategies were investigated, including nanobubble aeration pretreatment, conventional aeration pretreatment, and non-aerated control. Samples were collected from anaerobic digestion systems at different incubation stages.The V3-V4 region of bacterial 16S rRNA genes and archaeal 16S rRNA genes were amplified and sequenced separately. Sequencing data were used to investigate microbial succession, nitrogen transformation-related microorganisms, methanogenic archaea, and their relationships with methane production performance during anaerobic digestion.This dataset provides raw sequencing reads for studying microbial mechanisms involved in anaerobic treatment of livestock wastewater under different aeration strategies.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="C1" accession="SRS29816434"><IDENTIFIERS><PRIMARY_ID>SRS29816434</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN61468790</EXTERNAL_ID><SUBMITTER_ID namespace="pda|czw147369@outlook.com" label="Sample name">C1</SUBMITTER_ID></IDENT