titute"><Name>Harbin Institute of Technology</Name><Address postal_code="150000"><Department>School of Environment</Department><Institution>Harbin Institute of Technology</Institution><Street>92 West Dazhi Street, Nangang District</Street><City>Harbin</City><Country>China</Country></Address><Contact email="lyq080429@126.com" sec_email="lyq080429@163.com"><Address postal_code="150000"><Department>School of Environment</Department><Institution>Harbin Institute of Technology</Institution><Street>92 West Dazhi Street, Nangang District</Street><City>Harbin</City><Country>China</Country></Address><Name><First>Yongqi</First><Last>Liang</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1123413" accession="SRP513612"><IDENTIFIERS><PRIMARY_ID>SRP513612</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1123413</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Dissolved oxygen regulated gradient treatment of ammonia-rich organic wastewater from Chinese medicine residues in an anaerobic-microaerobic-aerobic process</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Resource recovery processes from Chinese medicine residues (CMRs) produce substantial refractory wastewater. Herein, to effectively treat actual ammonia-rich CMR wastewater, we optimized an anaerobic-microaerobic two-stage expanded granular sludge bed (EGSB) and moving bed sequencing batch reactor (MBSBR) combined sys-tem. By controlling dissolved oxygen (DO) levels, impressive removal efficiencies for chemical oxygen demand (COD, 99.26%), ammonia nitrogen (NH4+-N, 98.92%), and total phosphorus (TP, 96.09%) were achieved. Microaeration, contrasting with anaerobic conditions, bolstered dehydrogenase activity and electron transfer, thereby augmenting the functional microorganism community. The heightened relative abundance of Synergistetes and Proteobacteria facilitated hydrolytic acidification, fostering nitrogen and phosphorus removal. Furthermore, we examined the impact of DO concentration in MBSBR on pollutant removal and microbial metabolic activity, pinpointing 2.5 mg L-1 as the optimal DO concentration for superior removal performance and energy conservation.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="E3" accession="SRS21603965"><IDENTIFIERS><PRIMARY_ID>SRS21603965</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41810411</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lyq080429@orcid" label="Sample name">E3</SUBMITTER_ID></IDENTIFIERS><TITLE>sludge sample3</TITLE><SAMPLE_NAME><TAXON_ID>1592332</TAXON_ID><SCIENTIFIC_NAME>sludge metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1123413</ID><LABEL>PRJNA1123413</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>microaerobic EGSB reactor</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-10-12</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China:Heilongjiang</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>45.75992 N 126.68257 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tmp</TAG><VALUE>mic1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21603965" sample_name="E3" sample_title="sludge sample3" spots="71653" bases="43135106" tax_id="1592332" organism="sludge metagenome"><IDENTIFIERS><PRIMARY_ID>SRS21603965</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41810411</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="43135106" spots="71653" bytes="13757519"><RUN accession="SRR29383612" alias="E3.515FmodF_806RmodR.R1.raw.fastq.gz" total_spots="71653" total_bases="43135106" size="13757519" load_done="true" publishe