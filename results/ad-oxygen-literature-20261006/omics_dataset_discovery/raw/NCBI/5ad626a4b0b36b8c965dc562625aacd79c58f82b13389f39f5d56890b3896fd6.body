S></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>P16_16S rRNA</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Geosciences" center_name="Princeton University" accession="SRA1896842" alias="SUB14507887"><IDENTIFIERS><PRIMARY_ID>SRA1896842</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB14507887</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Princeton University</Name><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Contact email="lreji@uchicago.edu"><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Name><First>Linta</First><Last>Reji</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1123272" accession="SRP513516"><IDENTIFIERS><PRIMARY_ID>SRP513516</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1123272</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial communities associated with oxygen shifts in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>The goal of this study was to investigate the effect of oxygen shifts on wetland methane emissions. Three types of wetlands were included in the study: a Sphagnum-dominated peatland within the New Jersey Pine Barrens, a freshwater marsh, and a saltmarsh. Laboratory microcosms of wetland slurries were either pre-treated with oxygen or kept continuously anoxic. Microbial community structure was examined at multiple timepoints during the incubation period using metaegnomes, metatranscriptomes, as well as amplicons of the 16S rRNA gene.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="P16" accession="SRS21598846"><IDENTIFIERS><PRIMARY_ID>SRS21598846</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41805615</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lreji@orcid" label="Sample name">P16</SUBMITTER_ID></IDENTIFIERS><TITLE>Peat Day 229, Anoxic rep1</TITLE><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1123272</ID><LABEL>PRJNA1123272</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>sample_info</TAG><VALUE>Peat Day 229, Anoxic rep1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0-10 cm</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>27 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>peatland[ENVO:00000044]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>sphagnum bog[ENVO:00002268]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>peat soil[ENVO:00005774]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: New Jersey Pine Barrens</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>39.922 N 74.591 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_method</TAG><VALUE>Subsampled from slurry used in microcosm incubation experiment.</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS215