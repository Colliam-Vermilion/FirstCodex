/><Base value="G" count="738955"/><Base value="T" count="752303"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24892365" alias="M22_16S rRNA"><IDENTIFIERS><PRIMARY_ID>SRX24892365</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA reads of freshwater marsh slurry subsample: M22</TITLE><STUDY_REF accession="SRP513516"><IDENTIFIERS><PRIMARY_ID>SRP513516</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Slurry subsamples were frozen at -80 until extraction. RNA and DNA were co-extracted using the QIAGEN PowerSoil Total RNA kit and the RNeasy PowerSoil DNA Elution Kit.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21598826"><IDENTIFIERS><PRIMARY_ID>SRS21598826</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>M22_16S rRNA</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Geosciences" center_name="Princeton University" accession="SRA1896842" alias="SUB14507887"><IDENTIFIERS><PRIMARY_ID>SRA1896842</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB14507887</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Princeton University</Name><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Contact email="lreji@uchicago.edu"><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Name><First>Linta</First><Last>Reji</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1123272" accession="SRP513516"><IDENTIFIERS><PRIMARY_ID>SRP513516</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1123272</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial communities associated with oxygen shifts in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>The goal of this study was to investigate the effect of oxygen shifts on wetland methane emissions. Three types of wetlands were included in the study: a Sphagnum-dominated peatland within the New Jersey Pine Barrens, a freshwater marsh, and a saltmarsh. Laboratory microcosms of wetland slurries were either pre-treated with oxygen or kept continuously anoxic. Microbial community structure was examined at multiple timepoints during the incubation period using metaegnomes, metatranscriptomes, as well as amplicons of the 16S rRNA gene.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="M22" accession="SRS21598826"><IDENTIFIERS><PRIMARY_ID>SRS21598826</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41805649</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lreji@orcid" label="Sample name">M22</SUBMITTER_ID></IDENTIFIERS><TITLE>Freshwater marsh Day 7, Anoxic rep1a</TITLE><SAMPLE_NAME><TAXON_ID>2805829</TAXON_ID><SCIENTIFIC_NAME>marsh metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1123272</ID><LABEL>PRJNA1123272</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>sample_info</TAG><VALUE>Freshwater marsh Day 7, Anoxic rep1a</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0-10 cm</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>17 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>marsh[ENVO:00000035]</VALUE></SAMPLE_ATTRIBUTE><SAMP