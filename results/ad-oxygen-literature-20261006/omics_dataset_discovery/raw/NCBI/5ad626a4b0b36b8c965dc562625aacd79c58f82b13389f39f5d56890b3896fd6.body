rovider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="12080"><Read index="0" count="12080" average="151" stdev="0"/><Read index="1" count="12080" average="151" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="12080"/><Elements count="3648160"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="3648160"><Base value="A" count="745378"/><Base value="C" count="982502"/><Base value="G" count="924262"/><Base value="T" count="996018"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24892414" alias="S12_16S rRNA"><IDENTIFIERS><PRIMARY_ID>SRX24892414</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA reads of salt marsh slurry subsample: S12</TITLE><STUDY_REF accession="SRP513516"><IDENTIFIERS><PRIMARY_ID>SRP513516</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Slurry subsamples were frozen at -80 until extraction. RNA and DNA were co-extracted using the QIAGEN PowerSoil Total RNA kit and the RNeasy PowerSoil DNA Elution Kit.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21598875"><IDENTIFIERS><PRIMARY_ID>SRS21598875</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>S12_16S rRNA</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Geosciences" center_name="Princeton University" accession="SRA1896842" alias="SUB14507887"><IDENTIFIERS><PRIMARY_ID>SRA1896842</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB14507887</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Princeton University</Name><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Contact email="lreji@uchicago.edu"><Address postal_code="08544"><Department>Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall, Washington Rd</Street><City>Princeton</City><Sub>NJ</Sub><Country>USA</Country></Address><Name><First>Linta</First><Last>Reji</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1123272" accession="SRP513516"><IDENTIFIERS><PRIMARY_ID>SRP513516</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1123272</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Microbial communities associated with oxygen shifts in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>The goal of this study was to investigate the effect of oxygen shifts on wetland methane emissions. Three types of wetlands were included in the study: a Sphagnum-dominated peatland within the New Jersey Pine Barrens, a freshwater marsh, and a saltmarsh. Laboratory microcosms of wetland slurries were either pre-treated with oxygen or kept continuously anoxic. Microbial community structure was examined at multiple timepoints during the incubation period using metaegnomes, metatranscriptomes, as well as amplicons of the 16S rRNA gene.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="S12" accession="SRS21598875"><IDENTIFIERS><PRIMARY_ID>SRS21598875</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41805665</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lreji@orcid" label="Sample name">S12</SUBMITTER_ID></IDENTIFIERS><TITLE>Saltmarsh Day 7, Oxygen-shifted rep3</TITLE><SAMPLE_NAME><TAXON_ID>1504975</TAXON_ID><SCIENTIFIC_NAME>salt marsh metagenome</SCIENTIFIC_NAME></SA