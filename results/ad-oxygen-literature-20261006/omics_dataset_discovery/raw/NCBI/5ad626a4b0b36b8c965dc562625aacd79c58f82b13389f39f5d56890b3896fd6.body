 during the incubation period using metaegnomes, metatranscriptomes, as well as amplicons of the 16S rRNA gene.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="M12" accession="SRS21598816"><IDENTIFIERS><PRIMARY_ID>SRS21598816</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41805640</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lreji@orcid" label="Sample name">M12</SUBMITTER_ID></IDENTIFIERS><TITLE>Freshwater marsh Day 7, Oxygen-shifted rep3</TITLE><SAMPLE_NAME><TAXON_ID>2805829</TAXON_ID><SCIENTIFIC_NAME>marsh metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1123272</ID><LABEL>PRJNA1123272</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>sample_info</TAG><VALUE>Freshwater marsh Day 7, Oxygen-shifted rep3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0-10 cm</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>17 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>marsh[ENVO:00000035]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>freshwater marsh[ENVO:00000053]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>muddy soil[ENVO:00005786</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: New Jersey Charles H. Rogers Wildlife Refuge</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>40.326 N 74.659 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_method</TAG><VALUE>Subsampled from slurry used in microcosm incubation experiment.</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21598816" samp