ift in the composition of the microbial community were observed due to either air or sound treatment. Rather, microbial diversity was enhanced relative to the control. It is likely that both treatments aid in waste breakdown and improve nutrient availability to promote growth and increase biogas production.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="FAESRU.JL.13" accession="SRS18813864"><IDENTIFIERS><PRIMARY_ID>SRS18813864</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN37298563</EXTERNAL_ID><SUBMITTER_ID namespace="pda|getahun.agga@usda.gov" label="Sample name">FAESRU.JL.13</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1263854</TAXON_ID><SCIENTIFIC_NAME>anaerobic digester metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1013451</ID><LABEL>PRJNA1013451</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>poultry litter feed</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-03-20</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Kentucky, Bowling Green</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>36.5854 N 86.2640 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Poultry Litter Feed, Week 6</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS18813864" sample_name="FAESRU.JL.13" spots="14464855" bases="4368386210" tax_id="1263854" organism="anaerobic digester metagenome"><IDENTIFIERS><PRIMARY_ID>SRS18813864</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN37298563</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="4368386210" spots="14464855" bytes="1358874767"><RUN accession="SRR25925561" alias="zr12237_1_R1.fastq.gz" total_spots="14464855" total_bases