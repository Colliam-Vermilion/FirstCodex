s aid in waste breakdown and improve nutrient availability to promote growth and increase biogas production.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="FAESRU.JL.3" accession="SRS18813876"><IDENTIFIERS><PRIMARY_ID>SRS18813876</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN37298553</EXTERNAL_ID><SUBMITTER_ID namespace="pda|getahun.agga@usda.gov" label="Sample name">FAESRU.JL.3</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1263854</TAXON_ID><SCIENTIFIC_NAME>anaerobic digester metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1013451</ID><LABEL>PRJNA1013451</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>anaerobic digestion of poultry litter</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-11-27</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Kentucky, Bowling Green</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>36.5854 N 86.2640 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Control, Week 42</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS18813876" sample_name="FAESRU.JL.3" spots="14538966" bases="4390767732" tax_id="1263854" organism="anaerobic digester metagenome"><IDENTIFIERS><PRIMARY_ID>SRS18813876</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN37298553</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="4390767732" spots="14538966" bytes="1522317935"><RUN accession="SRR25925553" alias="zr8971_3_R1.fastq.gz" total_spots="14538966" total_bases="4390767732" size="1522317935" load_done="true" published="2023-09-29 13:05:29" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR259