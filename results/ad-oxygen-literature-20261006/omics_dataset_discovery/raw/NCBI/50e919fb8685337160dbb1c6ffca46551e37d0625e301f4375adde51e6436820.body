 region (primers 515F and 806R) using the Illumina MiSeq paired-end sequencing platform via the v2 2x250 base pair kit (Illumina) following their standard protocol (Parada et al., 2016).</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS29574934"><IDENTIFIERS><PRIMARY_ID>SRS29574934</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>DB10SauceyJanB11</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="School of Marine Science &amp; Policy" center_name="University of Delaware" accession="SRA2460878" alias="SUB16261723"><IDENTIFIERS><PRIMARY_ID>SRA2460878</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB16261723</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19958"><Department>School of Marine Science &amp; Policy</Department><Institution>University of Delaware</Institution><Street>700 Pilottown Rd</Street><City>Lewes</City><Sub>Delaware</Sub><Country>USA</Country></Address><Contact email="maliquebow@gmail.com" sec_email="maliqueb@udel.edu"><Address postal_code="19958"><Department>School of Marine Science &amp; Policy</Department><Institution>University of Delaware</Institution><Street>700 Pilottown Rd</Street><City>Lewes</City><Sub>Delaware</Sub><Country>USA</Country></Address><Name><First>Malique</First><Last>Bowen</Last><Middle>R</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1479055" accession="SRP710139"><IDENTIFIERS><PRIMARY_ID>SRP710139</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1479055</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Redox Influence on Microbial Communities in Anaerobic Coastal Sediments</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>We inoculated anaerobic sediments from 3 different depths using two different reducing agents (sodium dithionite and titanium (III) citrate) at varied redoxes (-150, -300, -340, -380, and -570mV) over 150 days to assess longterm affects on microbial community composition.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="DB10SauceyJanB11_S183_L001_R1_001.fastq.gz" accession="SRS29574934"><IDENTIFIERS><PRIMARY_ID>SRS29574934</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN60939731</EXTERNAL_ID><SUBMITTER_ID namespace="pda|malbow" label="Sample name">DB10SauceyJanB11_S183_L001_R1_001.fastq.gz</SUBMITTER_ID></IDENTIFIERS><TITLE>DB10 30 Days</TITLE><SAMPLE_NAME><TAXON_ID>749907</TAXON_ID><SCIENTIFIC_NAME>sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1479055</ID><LABEL>PRJNA1479055</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Coastal Marine Sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-11-11</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Broadkill River, Delaware</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>38.80216 N 75.20326 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>anaerobe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Isolate</TAG><VALUE>DB10</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><RUN_SET runs="1" bases="13039952" spots="25976" bytes="8346978"><RUN accession="SRR39190664" alias="DB10SauceyJanB11_S183_L001_R1_001.fastq.gz" total_spots="25976" total_bases="13039952" size="8346978" load_done="true" published="2026-06-16 18:42:18" is_public="true" cluster_name="public" has_taxanalys