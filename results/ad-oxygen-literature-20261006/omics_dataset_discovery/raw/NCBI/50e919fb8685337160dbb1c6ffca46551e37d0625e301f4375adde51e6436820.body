TIFIERS><PRIMARY_ID>SRP710139</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Extracted DNA was sent to the UCONN MARS facility for amplicon sequencing of the 16S rRNA gene targeting the V4 region (primers 515F and 806R) using the Illumina MiSeq paired-end sequencing platform via the v2 2x250 base pair kit (Illumina) following their standard protocol (Parada et al., 2016).</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS29574919"><IDENTIFIERS><PRIMARY_ID>SRS29574919</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Con1OctSauceyJanA01</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="School of Marine Science &amp; Policy" center_name="University of Delaware" accession="SRA2460878" alias="SUB16261723"><IDENTIFIERS><PRIMARY_ID>SRA2460878</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB16261723</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19958"><Department>School of Marine Science &amp; Policy</Department><Institution>University of Delaware</Institution><Street>700 Pilottown Rd</Street><City>Lewes</City><Sub>Delaware</Sub><Country>USA</Country></Address><Contact email="maliquebow@gmail.com" sec_email="maliqueb@udel.edu"><Address postal_code="19958"><Department>School of Marine Science &amp; Policy</Department><Institution>University of Delaware</Institution><Street>700 Pilottown Rd</Street><City>Lewes</City><Sub>Delaware</Sub><Country>USA</Country></Address><Name><First>Malique</First><Last>Bowen</Last><Middle>R</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1479055" accession="SRP710139"><ID