NSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="College of Engineering" center_name="China Agricultural University" accession="SRA1909288" alias="SUB14564497"><IDENTIFIERS><PRIMARY_ID>SRA1909288</PRIMARY_ID><SUBMITTER_ID namespace="China Agricultural University">SUB14564497</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>China Agricultural University</Name><Address postal_code="10083"><Department>College of Engineering</Department><Institution>China Agricultural University</Institution><Street>Qinghua East Road</Street><City>beijing</City><Country>China</Country></Address><Contact email="wangenzhen2020@163.com" sec_email="bs20223070635@cau.edu.cn"><Address postal_code="10083"><Department>College of Engineering</Department><Institution>China Agricultural University</Institution><Street>Qinghua East Road</Street><City>beijing</City><Country>China</Country></Address><Name><First>enzhen</First><Last>wang</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1128434" accession="SRP516173"><IDENTIFIERS><PRIMARY_ID>SRP516173</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1128434</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomic reveals the metabolic mechanism of enhancing anaerobic digestion of lignocellulosic biomass mediated by CO2/O2-Nanobubble water</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Nanobubble water (NW) has been reported to enhance anaerobic digestion (AD), but its influence on the metabolic pathway of anaerobic microorganisms remains unclear. In this study, CO2NW and O2NW were employed as AD accelerants to enhance biomethane production from lignocellulosic biomass. The results indicated that the specific methane yields of rice straw in the CO2NW and O2NW treatments increased by 6.9% and 18.3%, respectively, compared with the DW treatment.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="B30" accession="SRS21756643"><IDENTIFIERS><PRIMARY_ID>SRS21756643</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN42050716</EXTERNAL_ID><SUBMITTER_ID namespace="pda|wangenzhen2020@163.com" label="Sample name">B30</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1592332</TAXON_ID><SCIENTIFIC_NAME>sludge metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1128434</ID><LABEL>PRJNA1128434</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>reactor sample</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-11-12</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>type</TAG><VALUE>2</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21756643" sample_name="B30" spots="91293" bases="54958386" tax_id="1592332" organism="sludge metagenome"><IDENTIFIERS><PRIMARY_ID>SRS21756643</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN42050716</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="54958386" spots="91293" bytes="19076867"><RUN accession="SRR29552648" alias="B30.338F_806R.R1.raw.fastq.gz" total_spots="91293" total_bases="54958386" size="19076867" load_done="true" published="2024-06-26 06:16:00" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR29552648</PRIMARY_ID><SUBMITTER_ID namespace="SUB14564497" label="1">B30.338F_806R.R1.raw.fastq.gz</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX25059803"><IDENTIFIERS><SUBMITTER_ID namespace="SUB14564497">B30-Ba