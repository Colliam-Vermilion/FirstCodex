16428">Journal Article</PublicationType></PublicationTypeList><ArticleDate DateType="Electronic"><Year>2026</Year><Month>03</Month><Day>17</Day></ArticleDate></Article><MedlineJournalInfo><Country>England</Country><MedlineTA>Environ Microbiome</MedlineTA><NlmUniqueID>101768168</NlmUniqueID><ISSNLinking>2524-6372</ISSNLinking></MedlineJournalInfo><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">Central dry Andes</Keyword><Keyword MajorTopicYN="N">Community assembly</Keyword><Keyword MajorTopicYN="N">Functional redundancy</Keyword><Keyword MajorTopicYN="N">Haloalkaline environments</Keyword><Keyword MajorTopicYN="N">MAGs - novel lineages</Keyword><Keyword MajorTopicYN="N">Polyextreme saline lakes</Keyword><Keyword MajorTopicYN="N">Polyextremotolerant microbes</Keyword></KeywordList><CoiStatement>Declarations. Competing interests: The authors declare no competing interests.</CoiStatement></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="received"><Year>2025</Year><Month>9</Month><Day>10</Day></PubMedPubDate><PubMedPubDate PubStatus="accepted"><Year>2026</Year><Month>2</Month><Day>13</Day></PubMedPubDate><PubMedPubDate PubStatus="medline"><Year>2026</Year><Month>3</Month><Day>18</Day><Hour>7</Hour><Minute>26</Minute></PubMedPubDate><PubMedPubDate PubStatus="pubmed"><Year>2026</Year><Month>3</Month><Day>18</Day><Hour>7</Hour><Minute>25</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2026</Year><Month>3</Month><Day>18</Day><Hour>0</Hour><Minute>57</Minute></PubMedPubDate><PubMedPubDate PubStatus="pmc-release"><Year>2026</Year><Month>3</Month><Day>17</Day></PubMedPubDate></History><PublicationStatus>epublish</PublicationStatus><ArticleIdList><ArticleId IdType="pubmed">41845521</ArticleId><ArticleId IdType="pmc">PMC13107660</ArticleId><ArticleId IdType="doi">10.1186/s40793-026-00868-w</ArticleId><ArticleId IdType="pii">10.1186/s40793-026-00868-w</ArticleId></ArticleIdList><ReferenceList><Reference><Citation>Rundel PW, Villagra PE. Arid an