g><DescriptorName UI="D010084" MajorTopicYN="N">Oxidation-Reduction</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D017905" MajorTopicYN="Y">Phosphites</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D008697" MajorTopicYN="Y">Methane</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D006859" MajorTopicYN="N">Hydrogen</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D019638" MajorTopicYN="Y">Methanomicrobiaceae</DescriptorName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading></MeshHeadingList><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">anaerobes</Keyword><Keyword MajorTopicYN="N">dissimilatory phosphite oxidation</Keyword><Keyword MajorTopicYN="N">lithosyntrophy</Keyword><Keyword MajorTopicYN="N">methanogenesis</Keyword><Keyword MajorTopicYN="N">syntrophy</Keyword></KeywordList><CoiStatement>Competing interests statement:The authors declare no competing interest.</CoiStatement></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="medline"><Year>2026</Year><Month>3</Month><Day>12</Day><Hour>7</Hour><Minute>3</Minute></PubMedPubDate><PubMedPubDate PubStatus="pubmed"><Year>2026</Year><Month>3</Month><Day>11</Day><Hour>19</Hour><Minute>0</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2026</Year><Month>3</Month><Day>11</Day><Hour>12</Hour><Minute>13</Minute></PubMedPubDate><PubMedPubDate PubStatus="pmc-release"><Year>2026</Year><Month>9</Month><Day>11</Day></PubMedPubDate></History><PublicationStatus>ppublish</PublicationStatus><ArticleIdList><ArticleId IdType="pubmed">41811448</ArticleId><ArticleId IdType="pmc">PMC12994167</ArticleId><ArticleId IdType="doi">10.1073/pnas.2523765123</ArticleId></ArticleIdList><ReferenceList><Reference