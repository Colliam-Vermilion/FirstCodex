<RecordSet><DocumentSummary uid="1224811">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJNA1224811" archive="NCBI" id="1224811"/>
            <LocalID>bp0</LocalID>
            <LocalID>bp0</LocalID>
        </ProjectID>
        <ProjectDescr>
            <Name>Aerobic granular sludge from wastewater treatment</Name>
            <Title>Aerobic granular sludge from wastewater treatment Raw sequence reads</Title>
            <Description>This study investigates the impact of intermittent aeration on the structure and microbial community of aerobic granular sludge in wastewater treatment. Four reactors were operated under different aeration strategies to evaluate the effects on granule compactness, organic matter, and nitrogen removal efficiency. The microbial diversity and abundance were assessed using 16S rDNA sequencing, with taxonomic classification based on the SILVA database. The findings contribute to understanding how operational conditions influence sludge granulation and microbial composition, providing insights for optimizing wastewater treatment processes.</Description>
            <Relevance>
                <Environmental>yes</Environmental>
            </Relevance>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eWhole" material="eGenome" sample_scope="eEnvironment">
                    <Organism species="1592332" taxID="1592332">
                        <OrganismName>sludge metagenome</OrganismName>
                        <Supergroup>eOther</Supergroup>
                    </Organism>
                </Target>
                <Method method_type="eSequencing"/>
                <Objectives>
                    <Data data_type="eRawSequenceReads"/>
                </Objectives>
                <IntendedDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
