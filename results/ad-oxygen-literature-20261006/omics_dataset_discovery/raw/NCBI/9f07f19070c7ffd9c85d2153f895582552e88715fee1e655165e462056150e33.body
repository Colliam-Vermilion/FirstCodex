lls, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_DESCRIPTION></DESCRIPTOR><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>ENA-FIRST-PUBLIC</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE><STUDY_ATTRIBUTE><TAG>ENA-LAST-UPDATE</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="SAMEA114301804" accession="ERS16291027"><IDENTIFIERS><PRIMARY_ID>ERS16291027</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114301804</EXTERNAL_ID></IDENTIFIERS><TITLE>A14_T3_SA2_se_reads</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>SA_RNA_T3_rep2</DESCRIPTION><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>INSDC center name</TAG><VALUE>Norwegian University of Life Sciences</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Submitter Id</TAG><VALUE>A14_T3_SA2_se_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location (country and/or sea)</TAG><VALUE>Norway</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sample name</TAG><VALUE>A14_T3_SA2_se_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>scientific_name</TAG><VALUE>soil metagenome</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="ERS16291027" sample_name="SAMEA114301804" sample_title="A14_T3_SA2_se_reads" spots="11075556" bases="1772088960" tax_id="410658" organism="soil metagenome"><IDENTIFIERS><PRIMARY_ID>ERS16291027</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114301804</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="1772088960" spots="11075556" bytes="767416495"><RUN accession="ERR11905705" alias="ena-RUN-TAB-29-08-2023-15:12:14:821-14889" center_name="norwegian university of life sciences" total_spots="11075556" total_bases="1772088960" size="767