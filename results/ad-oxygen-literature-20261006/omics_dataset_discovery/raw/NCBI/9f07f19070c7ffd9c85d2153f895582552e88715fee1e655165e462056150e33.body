age cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_DESCRIPTION></DESCRIPTOR><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>ENA-FIRST-PUBLIC</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE><STUDY_ATTRIBUTE><TAG>ENA-LAST-UPDATE</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="SAMEA114306363" accession="ERS16295436"><IDENTIFIERS><PRIMARY_ID>ERS16295436</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306363</EXTERNAL_ID></IDENTIFIERS><TITLE>JC005_O2_reads</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>JC005_O2_reads</DESCRIPTION><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>INSDC center name</TAG><VALUE>Norwegian University of Life Sciences</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Submitter Id</TAG><VALUE>JC005_O2_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location (country and/or sea)</TAG><VALUE>Norway</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sample name</TAG><VALUE>JC005_O2_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>scientific_name</TAG><VALUE>soil metagenome</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="ERS16295436" sample_name="SAMEA114306363" sample_title="JC005_O2_reads" spots="9666879" bases="1952709558" tax_id="410658" organism="soil metagenome"><IDENTIFIERS><PRIMARY_ID>ERS16295436</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306363</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="1952709558