"/><Elements count="2076810076"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="2076810076"><Base value="A" count="362209502"/><Base value="C" count="664061208"/><Base value="G" count="661653443"/><Base value="T" count="364959705"/><Base value="N" count="23926218"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="ERX11290014" alias="ena-EXPERIMENT-TAB-29-08-2023-15:12:35:543-18619" center_name="norwegian university of life sciences"><IDENTIFIERS><PRIMARY_ID>ERX11290014</PRIMARY_ID></IDENTIFIERS><TITLE>Illumina HiSeq 1000 paired end sequencing</TITLE><STUDY_REF accession="ERP150268"><IDENTIFIERS><PRIMARY_ID>ERP150268</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJEB65123</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="ERS16295435"><IDENTIFIERS><PRIMARY_ID>ERS16295435</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306362</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>O2_LEGACY_DNA</LIBRARY_NAME><LIBRARY_STRATEGY>OTHER</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>unspecified</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION accession="ERA27067248" alias="ena-SUBMISSION-TAB-29-08-2023-15:12:35:544-18627" center_name="norwegian university of life sciences" lab_name="European Nucleotide Archive"><IDENTIFIERS><PRIMARY_ID>ERA27067248</PRIMARY_ID><SUBMITTER_ID namespace="norwegian university of life sciences">ena-SUBMISSION-TAB-29-08-2023-15:12:35:544-18627</SUBMITTER_ID></IDENTIFIERS><TITLE>Submitted by norwegian university of life sciences on 29-AUG-2023</TITLE></SUBMISSION><Organization type="center"><Name abbr="NORWEGIAN UNIVERSITY OF LIFE SCIENCES">NORWEGIAN UNIVERSITY OF LIFE SCIENCES</Name></Organization><STUDY accession="ERP150268" alias="1caf4b04-8da6-4c1a-8f42-40ba38ce631d" center_name="norwegian university of life sciences"><IDENTIFIERS><PRIMARY_ID>ERP150268</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJEB65123</EXTERNAL_ID><SUBMITTER_ID namespace="norwegian university of life sciences">1caf4b04-8da6-4c1a-8f42-40ba38ce631d</SUBMITTER_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Determining how oxygen legacy affects the trajectories of denitrifier function and structure in soil</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_ABSTRACT><STUDY_DESCRIPTION>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_DESCRIPTION></DESCRIPTOR><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>ENA-FIRST-PUBLIC</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE><STUDY_ATTRIBUTE><TAG>ENA-LAST-UPDATE</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="SAMEA114306362" accession="ERS16295435"><IDENTIFIERS><PRIMARY_ID>ERS16295435</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306362</EXTERNAL_ID></IDENTIFIERS><TITLE>JC004_O1_reads</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>JC004_O1_reads</DESCRIPTION><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>INSDC center name</TAG><VALUE>Norwegian University of Life Sciences</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Submitter Id</TAG><VALUE>JC004_O1_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location (country and/or sea)</TAG><VALUE>Norway</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sample name</TAG><VALUE>JC004_O1_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>scientific_name</TAG><VALUE>soil metagenome</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="ERS16295435" sample_name="SAMEA114306362" sample_title="JC004_O1_reads" spots="9192706" bases="1856926612" tax_id="410658" organism="soil metagenome"><IDENTIFIERS><PRIMARY_ID>ERS16295435</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306362</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="1856926612" spots="9192706" bytes="1203165041"><RUN accession="ERR11905727" alias="ena-RUN-TAB-29-08-2023-15:12:35:543-18620" center_name="norwegian university of life sciences" total_spots="9192706" total_bases="1856926612" size="1203165041" load_done="true" published="2023-09-25 17:33:37" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENT