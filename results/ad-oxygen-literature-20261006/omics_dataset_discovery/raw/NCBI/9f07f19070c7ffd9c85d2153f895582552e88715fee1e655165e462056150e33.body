atoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/ERR011/11905/ERR11905714/ERR11905714.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-8/ERR11905714/ERR11905714.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-103/ERR11905714/ERR11905714.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="1" nspots="12617328"><Read index="0" count="12617328" average="160" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="12617328"/><Elements count="2018772480"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="2018772480"><Base value="A" count="467768065"/><Base value="C" count="590264581"/><Base value="G" count="474504507"/><Base value="T" count="486001951"/><Base value="N" count="233376"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="ERX11290009" alias="ena-EXPERIMENT-TAB-29-08-2023-15:12:35:542-18609" center_name="norwegian university of life sciences"><IDENTIFIERS><PRIMARY_ID>ERX11290009</PRIMARY_ID></IDENTIFIERS><TITLE>Illumina HiSeq 1000 paired end sequencing</TITLE><STUDY_REF accession="ERP150268"><IDENTIFIERS><PRIMARY_ID>ERP150268</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJEB65123</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="ERS16295440"><IDENTIFIERS><PRIMARY_ID>ERS16295440</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306367</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>O2_LEGACY_DNA</LIBRARY_NAME><LIBRARY_STRATEGY>OTHER</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>unspecified</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION accession="ERA27067248" alias="ena-SUBMISSION-TAB-29-08-2023-15:12:35:544-18627" center_name="norwegian university of life sciences" lab_name="European Nucleotide Archive"><IDENTIFIERS><PRIMARY_ID>ERA27067248</PRIMARY_ID><SUBMITTER_ID namespace="norwegian university of life sciences">ena-SUBMISSION-TAB-29-08-2023-15:12:35:544-18627</SUBMITTER_ID></IDENTIFIERS><TITLE>Submitted by norwegian university of life sciences on 29-AUG-2023</TITLE></SUBMISSION><Organization type="center"><Name abbr="NORWEGIAN UNIVERSITY OF LIFE SCIENCES">NORWEGIAN UNIVERSITY OF LIFE SCIENCES</Name></Organization><STUDY accession="ERP150268" alias="1caf4b04-8da6-4c1a-8f42-40ba38ce631d" center_name="norwegian university of life sciences"><IDENTIFIERS><PRIMARY_ID>ERP150268</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJEB65123</EXTERNAL_ID><SUBMITTER_ID namespace="norwegian university of life sciences">1caf4b04-8da6-4c1a-8f42-40ba38ce631d</SUBMITTER_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Determining how oxygen legacy affects the trajectories of denitrifier function and structure in soil</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_ABSTRACT><STUDY_DESCRIPTION>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_DESCRIPTION></DESCRIPTOR><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>ENA-FIRST-PUBLIC</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE><STUDY_ATTRIBUTE><TAG>ENA-LAST-UPDATE</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE accession="ERS16295440" alias="JC009_SA3_reads" center_name="Norwegian University of Life Sciences"><IDENTIFIERS><PRIMARY_ID>ERS16295440</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306367</EXTERNAL_ID><SUBMITTER_ID namespace="Norwegian University of Life Sciences">JC009_SA3_reads</SUBMITTER_ID></IDENTIFIERS><TITLE>JC009_SA3_reads</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>JC009_SA3_reads</DESCRIPTION><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>organism</TAG><VALUE>soil metagenome</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>scientific_name</TAG><