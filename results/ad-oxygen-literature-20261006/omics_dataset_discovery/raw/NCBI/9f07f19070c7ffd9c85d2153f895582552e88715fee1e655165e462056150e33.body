tion type="center"><Name abbr="NORWEGIAN UNIVERSITY OF LIFE SCIENCES">NORWEGIAN UNIVERSITY OF LIFE SCIENCES</Name></Organization><STUDY accession="ERP150268" alias="1caf4b04-8da6-4c1a-8f42-40ba38ce631d" center_name="norwegian university of life sciences"><IDENTIFIERS><PRIMARY_ID>ERP150268</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJEB65123</EXTERNAL_ID><SUBMITTER_ID namespace="norwegian university of life sciences">1caf4b04-8da6-4c1a-8f42-40ba38ce631d</SUBMITTER_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Determining how oxygen legacy affects the trajectories of denitrifier function and structure in soil</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_ABSTRACT><STUDY_DESCRIPTION>Denitrification, a key microbial metabolism in the global nitrogen cycle and a main source of the greenhouse gas N2O, is intricately controlled by oxygen. While the regulatory biology during the transition from aerobic respiration to denitrification is comprehensively studied, the understanding of how denitrifiers manage cyclic shifts between oxic and anoxic conditions – prevalent in most natural and engineered environments – remains limited. In a four-week experiment, grassland soil samples were subjected to frequent short anoxic spells, prolonged anoxic spells, or consistently oxic conditions, followed by a final anoxic incubation where denitrification kinetics and meta-genomics/transcriptomics were analyzed.</STUDY_DESCRIPTION></DESCRIPTOR><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>ENA-FIRST-PUBLIC</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE><STUDY_ATTRIBUTE><TAG>ENA-LAST-UPDATE</TAG><VALUE>2023-08-29</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="SAMEA114306366" accession="ERS16295439"><IDENTIFIERS><PRIMARY_ID>ERS16295439</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306366</EXTERNAL_ID></IDENTIFIERS><TITLE>JC008_SA2_reads</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>JC008_SA2_reads</DESCRIPTION><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>INSDC center name</TAG><VALUE>Norwegian University of Life Sciences</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Submitter Id</TAG><VALUE>JC008_SA2_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection date</TAG><VALUE>2021</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location (country and/or sea)</TAG><VALUE>Norway</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sample name</TAG><VALUE>JC008_SA2_reads</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>scientific_name</TAG><VALUE>soil metagenome</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="ERS16295439" sample_name="SAMEA114306366" sample_title="JC008_SA2_reads" spots="8788658" bases="1775308916" tax_id="410658" organism="soil metagenome"><IDENTIFIERS><PRIMARY_ID>ERS16295439</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMEA114306366</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="1775308916" spots="8788658" bytes="1152701932"><RUN accession="ERR11905723" alias="ena-RUN-TAB-29-08-2023-15:12:35:542-18612" center_name="norwegian university of life sciences" total_spots="8788658" total_bases="1775308916" size="1152701932" 