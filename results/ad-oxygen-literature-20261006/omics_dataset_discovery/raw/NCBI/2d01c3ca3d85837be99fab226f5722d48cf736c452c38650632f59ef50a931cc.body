<EXPERIMENT_PACKAGE_SET>
<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6810089" alias="ESMesFM033"><IDENTIFIERS><PRIMARY_ID>SRX6810089</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene v3-v4 amplicon of activated sludge bioreactor</TITLE><STUDY_REF accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA559245</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Bacterial 16S rRNA amplicon sequencing was done in two steps. Primer set 341f/785r targeted the V3-V4 variable regions of the 16S rRNA gene. The libraries were sequenced on an Illumina MiSeq platform (v.3) with 20% PhiX spike-in and at a read-length of 300 bp paired-end.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5354055"><IDENTIFIERS><PRIMARY_ID>SRS5354055</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12660373</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>ESMesFM033</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Singapore Centre for Environmental Life Sciences E" center_name="NTU" accession="SRA957318" alias="SUB6267323"><IDENTIFIERS><PRIMARY_ID>SRA957318</PRIMARY_ID><SUBMITTER_ID namespace="NTU">SUB6267323</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>NTU</Name><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Contact email="esantillan@ucdavis.edu" sec_email="esantillan@ntu.edu.sg"><Address postal_code="637551"><Department>SCELSE</Department><Institution>NTU</Institution><Street>60 Nanyang Drive, SBS-01N-27</Street><City>Singapore</City><Country>Singapore</Country></Address><Name><First>Ezequiel</First><Last>Santillan</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA559245" accession="SRP220571"><IDENTIFIERS><PRIMARY_ID>SRP220571</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA559245</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Mesocosm reactors under sustained double organic loading disturbance (with controls), Metagenomes and 16S rRNA gene v3-v4 amplicon Metabarcodes</STUDY_TITLE><STUDY_TYPE existing_study_type="Metagenomics"/><STUDY_ABSTRACT>Sustained perturbations are of interest in microbial ecology as they can drive systems to alternative stable states. Here, we tested the effect of a sustained double organic loading perturbation on structure, assembly and function of activated sludge bacterial communities in sequencing batch bioreactors operated with intermittent aeration. We also focused on the effect of this perturbation in the nitrification function and nitrifiers.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>bioreactor sludge metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><URL_LINK><LABEL>Sustained organic loading perturbation inhibits nitrite oxidation in bioreactors, unveiling variable resistance and resilience of nitrification and nitrifiers</LABEL><URL>https://doi.org/10.1101/605733</URL></URL_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="Bioreactor (SBR) [day 110, level L, rep. 1]" accession="SRS5354055"><IDENTIFIERS><PRIMARY_ID>SRS5354055</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12660373</EXTERNAL_ID><SUBMITTER_ID namespace="pda|esantillan" label="Sample name">Bioreactor (SBR) [day 110, level L, rep. 1]</SUBMITTER_ID></IDENTIFIERS><TITLE>ESMesFM033</TITLE><SAMPLE_NAME><TAXON_ID>942017</TAXON_ID><SCIENTIFIC_NAME>activated sludge metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>ESMesFM033</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>559245</ID><LABEL>PRJNA559245</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2016-11-29</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>anthropogenic environmental material</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>activated sludge</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>waste material</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Singapore</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>1.3451 N 103.6798 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>chem_oxygen_dem</TAG><VALUE>8</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>nitrate</TAG><VALUE>90</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>perturbation</TAG><VALUE>Undisturbed level at low F:M and C:N</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>reactor_type</TAG><VALUE>batch, multistage</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>aerobe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>cryogenic tube</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_mat_process</TAG><VALUE>flash freezing with liquid nitrogen</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_size</TAG><VALUE>0.5 mL</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_store_loc</TAG><VALUE>Singapore Centre for Environmental Life Sciences Engineering</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_store_temp</TAG><VALUE>-80 °C</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>secondary_treatment</TAG><VALUE>activated sludge</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sewage_type</TAG><VALUE>complex synthetic wastewater</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sludge_retent_time</TAG><VALUE>12.8 days</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>suspend_solids</TAG><VALUE>1.48-1.98</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>temp</TAG><VALUE>30 °C</VALUE></SAMPLE_