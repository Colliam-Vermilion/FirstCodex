broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA092244"><IDENTIFIERS><PRIMARY_ID>SRA092244</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE48585</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">Gene Expression Omnibus</Name></Organization><STUDY center_name="GEO" alias="GSE48585" accession="SRP026606"><IDENTIFIERS><PRIMARY_ID>SRP026606</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA210753</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE48585</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Response of Burkholderia cenocepacia H111 to micro-oxia</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>B. cenocepacia is an opportunistic human pathogen that is particularly problematic for patients suffering from cystic fibrosis (CF). In the CF lung, bacteria grow to high densities within the viscous mucus that is limited in oxygen. Pseudomonas aeruginosa, the dominant pathogen in CF patients, is known to grow and survive under oxygen-limited to anaerobic conditions by using micro-oxic respiration, denitrification and fermentative pathways. In contrast, inspection of the genome sequences of available B. cenocepacia strains suggested that B. cenocepacia is an obligate aerobic and non-fermenting bacterium. In accordance with the bioinformatics analysis, we observed that B. cenocepacia H111 is able to grow with as little as 0.1% O2 but not under strictly anoxic conditions. Phenotypic analyses revealed that H111 produced larger amounts of biofilm, pellicle and proteases under micro-oxic conditions (0.5% - 5% O2, i.e. conditions that mimic those encountered in CF lung infection), and was more resistant to several antibiotics. RNA-Seq and shotgun proteomics analyses of cultures of B. cenocepacia H111 grown under micro-oxic and aerobic conditions showed up-regulation of genes involved in the synthesis of the exopolysaccharide (EPS) cepacian as well as several proteases, two isocitrate lyases and other genes potentially important for life in micro-oxia. Overall design: Oxygen regulation in Burkholderia cenocepacia was investigated using RNA-Seq of cells grown under aerobic or micro-oxic conditions.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>Burkholderia cenocepacia H111</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>24023794</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE center_name="GEO" alias="GSM1181833" accession="SRS455461"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN02228109</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1181833</EXTERNAL_ID></IDENTIFIERS><TITLE>H111 wt aeobic</TITLE><SAMPLE_NAME><TAXON_ID>1055524</TAXON_ID><SCIENTIFIC_NAME>Burkholderia cenocepacia H111</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>210753</ID><LABEL>PRJNA210753</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Bc H111 planktonic cells, aerobic conditions</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain/background</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype/variation</TAG><VALUE>wild-type</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>growth condition</TAG><VALUE>aerobic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>cell type</TAG><VALUE>planktonic cells, OD600 equal 0.8</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>medium</TAG><VALUE>complex medium LB</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS455461" sample_name="GSM1181833" sample_title="H111 wt aeobic" spots="3019150" bases="274742650" tax_id="1055524" organism="Burkholderia cenocepacia H111"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN0222