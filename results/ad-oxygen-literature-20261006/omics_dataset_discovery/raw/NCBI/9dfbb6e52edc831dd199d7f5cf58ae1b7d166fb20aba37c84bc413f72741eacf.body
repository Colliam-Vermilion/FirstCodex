<EXPERIMENT_PACKAGE_SET>
<EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3176826" accession="SRX4169533"><IDENTIFIERS><PRIMARY_ID>SRX4169533</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3176826: seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Methyl-Seq Replicate 3; Oryza sativa; Bisulfite-Seq</TITLE><STUDY_REF accession="SRP149824" refname="GSE115372"><IDENTIFIERS><PRIMARY_ID>SRP149824</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3381478"><IDENTIFIERS><PRIMARY_ID>SRS3381478</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176826</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>Bisulfite-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>GENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>gDNA was extracted from the seeds/seedlings using the Qiagen DNeasy Plant minikit and 600ng of purified gDNA was used for MethylC-seq library preparation after spiking in 0.5% lambda DNA (N6-methyladenine-free) (New England BioLabs). MethylC-seq library preparation was carried out as described previously (Urich et al., 2015 - http://www.nature.com/nprot/journal/v10/n3/full/nprot.2014.114.html).</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176826</ID><LABEL>GSM3176826</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176826</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115372" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715446"><IDENTIFIERS><PRIMARY_ID>SRA715446</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115372</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115372" accession="SRP149824"><IDENTIFIERS><PRIMARY_ID>SRP149824</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474723</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115372</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (Methyl-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>methylC-seq profiling of seeds, at 0 h and 24 h after imbibition and following 4-d of growth under aerobic and anerobic conditions, as well as following re-oxygenation (3dN1dA) in rice. Overall design: gDNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 24 h and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115372</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176826" accession="SRS3381478"><IDENTIFIERS><PRIMARY_ID>SRS3381478</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371439</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176826</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Methyl-Seq Replicate 3</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAME>Oryza sativa</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>474723</ID><LABEL>PRJNA474723</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>De-hulled sterilised seeds were grown in MES culture medium bubbled with nitrogen gas (anaerobic-N) at 30 C in the dark for 3 d, the gas was then switched to air for 1 d (3dN1dA).</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381478" sample_name="GSM3176826" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Methyl-Seq Replicate 3" spots="72746239" bases="14694740278" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381478</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371439</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176826</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="14694740278" spots="72746239" bytes="6844292924"><RUN alias="GSM3176826_r1" accession="SRR7265438" total_spots="72746239" total_bases="14694740278" size="6844292924" load_done="true" published="2018-06-12 16:06:15" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265438</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176826_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169533" refname="GSM3176826"/><Pool><Member member_name="" accession="SRS3381478" sample_name="GSM3176826" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Methyl-Seq Replicate 3" spots="72746239" bases="14