<EXPERIMENT_PACKAGE_SET>
<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX1161750" alias="T1"><IDENTIFIERS><PRIMARY_ID>SRX1161750</PRIMARY_ID></IDENTIFIERS><TITLE>metatranscriptomic study of marine coastal sediment : negative control</TITLE><STUDY_REF accession="SRP062708"><IDENTIFIERS><PRIMARY_ID>SRP062708</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA293548</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>ribosomal RNA depletion</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS1042643"><IDENTIFIERS><PRIMARY_ID>SRS1042643</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>T1</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="Mediterranean Institute of Oceanography" accession="SRA290481" alias="SUB1070121"><IDENTIFIERS><PRIMARY_ID>SRA290481</PRIMARY_ID><SUBMITTER_ID namespace="Mediterranean Institute of Oceanography">SUB1070121</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="contact.institution_url"><Name>Mediterranean Institute of Oceanography</Name><Address postal_code="13009"><Department>environmental microbiology &amp; biotechnology</Department><Institution>Mediterranean Institute of Oceanography</Institution><Street>163 avenue de Luminy</Street><City>Marseille</City><Country>France</Country></Address><Contact email="alexandre.atkinson@mio.osupytheas.fr" sec_email="alexandre.atkinson@gmail.com"><Address postal_code="13009"><Department>environmental microbiology &amp; biotechnology</Department><Institution>Mediterranean Institute of Oceanography</Institution><Street>163 avenue de Luminy</Street><City>Marseille</City><Country>France</Country></Address><Name><First>Alexandre</First><Last>ATKINSON</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA293548" accession="SRP062708"><IDENTIFIERS><PRIMARY_ID>SRP062708</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA293548</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>identification of the microbial genes and pathway induced in response to petroleum and oxygen oscillations in marine coastal sediments</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Identification of the genes induced in response to petroleum by metatranscriptomic approach: this characterization will be performed on simplified microbial communities focusing on anaerobic prokaryotes inhabiting the hydrocarbon compounds (HC)-degrading bacterial communities with special interest on the sulfate reducing prokaryotes (SRP). These bacterial communities will be characterized by metatranscriptomic approaches in order to characterize the specific genes induced according the crucial adaptative steps to pollutant and redox conditions.We perform the analysis at whole community and functional groups levels, an innovative approach that allows understanding the overall assembly and functioning of the bacterial communities. Although the partners have a long experience on determining gene diversity and expression level, the challenge is to combine the information obtained at several organization levels from several bacterial communities. Thus, through the main structuring groups, their relationships and their behavior against oxygen and redox oscillations, we will be able to describe the global functioning of sediments’ bacterial communities. Furthermore the comparisons of the behavior of the different bacterial communities will provide valuable information to understand the structuring of microbial communities exposed to petroleum under oxygen and redox oscillations.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>marine sediment metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><URL_LINK><LABEL>Project presentation</LABEL><URL>http://iprem-eem.univ-pau.fr/live/DECAPAGE</URL></URL_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="sediment_control_replicate1" accession="SRS1042643"><IDENTIFIERS><PRIMARY_ID>SRS1042643</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN04005489</EXTERNAL_ID><SUBMITTER_ID namespace="pda|hoxus" label="Sample name">sediment_control_replicate1</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>412755</TAXON_ID><SCIENTIFIC_NAME>marine sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>293548</ID><LABEL>PRJNA293548</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>marine sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2011-11-13</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>France</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>48.553847 N 4.535771 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>sediment trapping device</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS1042643" sample_name="sediment_control_replicate1" spots="14893001" bases="2978600200" tax_id="412755" organism="marine sediment metagenome"><IDENTIFIERS><PRIMARY_ID>SRS1042643</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN04005489</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="2978600200" spots="14893001" bytes="1981571463"><RUN accession="SRR2177835" alias="T2-1_TAGCTT_L003_R2.fastq.bz2" total_spots="14893001" total_bases="2978600200" size="1981571463" load_done="true" published="2015-09-15 00:00:00" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR2177835<