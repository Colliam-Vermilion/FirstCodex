/PRIMARY_ID><SUBMITTER_ID namespace="SUB1070121" label="9">3-1_ATCACG_L003_R1.fastq.bz2</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX1161749"><IDENTIFIERS><SUBMITTER_ID namespace="SUB1070121">HCN1</SUBMITTER_ID></IDENTIFIERS></EXPERIMENT_REF><Pool><Member member_name="" accession="SRS1042639" sample_name="sediment_nereis_HC_replicate1" sample_title="sediment with both petroleum and nereis added" spots="15037705" bases="3007541000" tax_id="412755" organism="marine sediment metagenome"><IDENTIFIERS><PRIMARY_ID>SRS1042639</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN04005783</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="3-1_ATCACG_L003_R1.fastq.bz2" size="888935120" date="2020-04-24 15:25:04" md5="aad7aa6bfb90b5c482212a61cb37625a" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-6/SRR2177834/3-1_ATCACG_L003_R1.fastq.bz2" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="3-1_ATCACG_L003_R2.fastq.bz2" size="902280416" date="2020-04-24 15:25:04" md5="36b3b9d6774a4a339c1a504159f0d28f" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-5/SRR2177834/3-1_ATCACG_L003_R2.fastq.bz2" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR2177834" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR2177834/SRR2177834" size="2007055709" date="2015-08-21 13:29:11" md5="9812ef894a5e191533d1a8c59a09e539" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR2177834/SRR2177834" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR2177834.sralite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR002/177/SRR2177834/SRR2177834