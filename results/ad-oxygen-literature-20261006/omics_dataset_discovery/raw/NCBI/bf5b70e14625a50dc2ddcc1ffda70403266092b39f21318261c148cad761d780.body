/SRR7804020/NG-136-0007_S21_L004_R2_001.fastq.gz" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR7804020" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR7804020/SRR7804020" size="717821808" date="2018-09-07 12:38:01" md5="3109e496b12d74a039df8125c664f515" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR7804020/SRR7804020" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR7804020.sralite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR007/804/SRR7804020/SRR7804020.sralite.1" size="404015396" date="2020-06-22 10:34:35" md5="d13f268de9ba06e34a9ad2d689d336b3" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR007/804/SRR7804020/SRR7804020.sralite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-1/SRR7804020/SRR7804020.sralite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-101/SRR7804020/SRR7804020.zq.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="5705133"><Read index="0" count="5705133" average="133.09" stdev="27.54"/><Read index="1" count="5705133" average="134.23" stdev="27.01"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="5705133"/><Elements count="1525084954"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="1525084954"><Base value="A" count="352096552"/><Base value="C" count="403475601"/><Base value="G" count="425217170"/><Base value="T" count="344072294"/><Base value="N" count="223337"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3380035" accession="SRX4655770"><IDENTIFIERS><PRIMARY_ID>SRX4655770</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3380035: 12CLamp; aquifer metagenome; RNA-Seq</TITLE><STUDY_REF accession="SRP160141" refname="GSE119644"><IDENTIFIERS><PRIMARY_ID>SRP160141</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3753226"><IDENTIFIERS><PRIMARY_ID>SRS3753226</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3380035</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA was extracted with the Powersoil RNA isolation kit from QIAgen. Heavy (representing microbes that metabolized toluene) and light (microbes that did not metabolize toluene) RNA was separated by isopycnic centrifugation. Additionally, subsamples of RNA from Heavy and Light fractions underwent linear amplification with the MessageAmp II Bacteria kit from Thermofisher to compare the effects of amplification against unamplified samples. Libraries were produced according to manufacturer instruction using the Illumina TruSeq® Stranded mRNA HT kit.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>NextSeq 500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303380035</ID><LABEL>GSM3380035</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3380035</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE119644" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA769942"><IDENTIFIERS><PRIMARY_ID>SRA769942</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE119644</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE119644" accession="SRP160141"><IDENTIFIERS><PRIMARY_ID>SRP160141</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA489848</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE119644</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Transcriptome-stable isotope probing provides targeted functional and taxonomic insights into hypoxic pollutant-degrading aquifer microbiota</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>We investigated a contaminant-degrading microbial community by sequencing total RNA (without rRNA depletion) from microcosms containing sediment from a hypoxic contaminated aquifer fed with isotopically labeled toluene. Overall design: Microcosms were made using sediment from a hypoxic, hydrocarbon-contaminated aquifer in Siklos, Hungary. They were incubated under hypoxic/microoxic conditions and provided with isotopically-labeled toluene as a substrate. RNA was extracted and subjected to isopycnic centrifugation to separated heavy (isotopically labeled) and light (unlabeled) RNA, representing microbes which did or did not metabolize toluene, respectively. Total RNA was sequenced to provide both taxonimic (16S) and functional (mRNA) data on this microbiota, the first instance of total-RNA-stable isotope probing used to investigate a contaminated environment.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE119644</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>30483229</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="GSM3380035" accession="SRS3753226"><IDENTIFIERS><PRIMARY_ID>SRS3753226</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09990290</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3380035</EXTERNAL_ID></IDENTIFIERS><TITLE>12CLamp</TITLE><SAMPLE_NAME><TAXON_ID>1704045</TAXON_ID><SCIENTIFIC_NAME>aquifer metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>489848</ID><LABEL>PRJNA489848</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Aquifer sediment (Environmental microbial community)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location</TAG><VALUE>Hungary: Siklos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment</TAG><VALUE>Linear amplification</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>density</TAG><VALUE>Light</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm set</TAG><VALUE>Control (12C-toluene)</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3753226" sample_name="GSM3380035" sample_title="12CLamp" spots="29895190" bases="7794740352" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIERS><PRIMARY_ID>SRS3753226</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09990290</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3380035</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="4" bases="7794740352" spots="29895190" bytes="3599537796"><RUN alias="GSM3380035_r1" accession="SRR7804013" total_spots="7620131" total_bases="1985926284" size="908233942" load_done="true" published="2018-09-25 18:20:14" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7804013</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3380035_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4655770" refname="GSM3380035"/><Pool><Member member_name="" acc