ue="G" count="290592776"/><Base value="T" count="237432912"/><Base value="N" count="142812"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3380036" accession="SRX4655771"><IDENTIFIERS><PRIMARY_ID>SRX4655771</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3380036: 13CHamp; aquifer metagenome; RNA-Seq</TITLE><STUDY_REF accession="SRP160141" refname="GSE119644"><IDENTIFIERS><PRIMARY_ID>SRP160141</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3753229"><IDENTIFIERS><PRIMARY_ID>SRS3753229</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3380036</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA was extracted with the Powersoil RNA isolation kit from QIAgen. Heavy (representing microbes that metabolized toluene) and light (microbes that did not metabolize toluene) RNA was separated by isopycnic centrifugation. Additionally, subsamples of RNA from Heavy and Light fractions underwent linear amplification with the MessageAmp II Bacteria kit from Thermofisher to compare the effects of amplification against unamplified samples. Libraries were produced according to manufacturer instruction using the Illumina TruSeq® Stranded mRNA HT kit.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>NextSeq 500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303380036</ID><LABEL>GSM3380036</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3380036</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE119644" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA769942"><IDENTIFIERS><PRIMARY_ID>SRA769942</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE119644</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE119644" accession="SRP160141"><IDENTIFIERS><PRIMARY_ID>SRP160141</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA489848</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE119644</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Transcriptome-stable isotope probing provides targeted functional and taxonomic insights into hypoxic pollutant-degrading aquifer microbiota</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>We investigated a contaminant-degrading microbial community by sequencing total RNA (without rRNA depletion) from microcosms containing sediment from a hypoxic contaminated aquifer fed with isotopically labeled toluene. Overall design: Microcosms were made using sediment from a hypoxic, hydrocarbon-contaminated aquifer in Siklos, Hungary. They were incubated under hypoxic/microoxic conditions and provided with isotopically-labeled toluene as a substrate. RNA was extracted and subjected to isopycnic centrifugation to separated heavy (isotopically labeled) and light (unlabeled) RNA, representing microbes which did or did not metabolize toluene, respectively. Total RNA was sequenced to provide both taxonimic (16S) and functional (mRNA) data on this microbiota, the first instance of total-RNA-stable isotope probing used to investigate a contaminated environment.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE119644</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>30483229</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="GSM3380036" accession="SRS3753229"><IDENTIFIERS><PRIMARY_ID>SRS3753229</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09990289</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3380036</EXTERNAL_ID></IDENTIFIERS><TITLE>13CHamp</TITLE><SAMPLE_NAME><TAXON_ID>1704045</TAXON_ID><SCIENTIFIC_NAME>aquifer metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>489848</ID><LABEL>PRJNA489848</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Aquifer sediment (Environmental microbial community)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geographic location</TAG><VALUE>Hungary: Siklos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment</TAG><VALUE>Linear amplification</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>density</TAG><VALUE>Heavy</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm set</TAG><VALUE>Labeled (13C-toluene)</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3753229" sample_name="GSM3380036" sample_title="13CHamp" spots="23363309" bases="6244713467" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIERS><PRIMARY_ID>SRS3753229</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09990289</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3380036</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="4" bases="6244713467" spots="23363309" bytes="2909984544"><RUN alias="GSM3380036_r1" accession="SRR7804017" total_spots="5963799" total_bases="1593054711" size="735704120" load_done="true" published="2018-09-25 18:20:14" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7804017</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3380036_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4655771" refname="GSM3380036"/><Pool><Member member_name="" accession="SRS3753229" sample_name="GSM3380036" sample_title="13CHamp" spots="5963799" bases="1593054711" tax_id="1704045" organism="aquifer 