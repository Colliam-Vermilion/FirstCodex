><Bases cs_native="false" count="20579520"><Base value="A" count="4773564"/><Base value="C" count="5591906"/><Base value="G" count="5318285"/><Base value="T" count="4895765"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24796428" alias="2105ISCOC1bead_16S"><IDENTIFIERS><PRIMARY_ID>SRX24796428</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA amplicon sequencing of iron microbial mats from the Savannah River Site stream</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>DNA was extracted from iron microbial mat frozen in the field on dry ice. 16S rRNA gene libraries were prepared using the Illumina 16S Sample Preparation Guide. Amplicons were prepared using the lllumina 16S b341F and lllumina 16S 805R primers, with all preparations done at  volume. Libraries were prepared with 2 ng input DNA and 40 amplicon PCR cycles. Libraries were sequenced on an Illumina MiSeq using a Nano 500 cycle sequencing kit.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21513456"><IDENTIFIERS><PRIMARY_ID>SRS21513456</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570325</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>2105ISCOC1bead_16S</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>GENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Earth Sciences" center_name="University of Delaware" accession="SRA1888926" alias="SUB14505202"><IDENTIFIERS><PRIMARY_ID>SRA1888926</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB14505202</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Contact email="gtothero@udel.edu" sec_email="graceetothero@gmail.com"><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Name><First>Gracee</First><Last>Tothero</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1117470" accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomes of iron microbial mats from a freshwater terrestrial stream and wetlands. Metagenome</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Our work focuses on Tims Branch at the Savannah River Site (SRS), a tributary that flowsdirectly into the Savannah River in South Carolina. Macroscopic freshwater iron mats are widespread inTims Branch; furthermore, microscopy of these mats shows biomineral morphologies consistent with theknown FeOB genera Leptothrix and Gallionella. These factors make Tims Branch ideal for studying ironoxidizers. This project is designed to fill research gaps surrounding the rate and controls on environmentaliron oxidation, and the metabolism of FeOB.The research objectives are:Objective 1: Quantify microbial iron oxidation rates in terrestrial iron mats using an integratedfield and kinetics studyObjective 2: Identify and quantify dominant iron-oxidizing microorganisms in terrestrialiron mats using metagenomics and metatranscriptomicsObjective 3: Construct microbial metabolic models of iron oxidizers and iron matcommunities to link microbial iron oxidation to C, N and S cycling</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>39133000</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="2105ISCOC1bead" accession="SRS21513456"><IDENTIFIERS><PRIMARY_ID>SRS21513456</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570325</EXTERNAL_ID><SUBMITTER_ID namespace="pda|gtothero@orcid" label="Sample name">2105ISCOC1bead</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>527640</TAXON_ID><SCIENTIFIC_NAME>microbial mat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1117470</ID><LABEL>PRJNA1117470</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2021-05-20</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>35</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>260</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>freshwater stream</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: South Carolina, Savannah River Site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>33.32 N 81.71 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolate</TAG><VALUE>2105ISCOC1bead</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>iron microbial mat from freshwater stream</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.microbial</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21513456" sample_name="2105ISCOC1bead" spots="48839" bases="24907890" tax_id="527640" organism="microbial mat metagenome"><IDENTIFIE