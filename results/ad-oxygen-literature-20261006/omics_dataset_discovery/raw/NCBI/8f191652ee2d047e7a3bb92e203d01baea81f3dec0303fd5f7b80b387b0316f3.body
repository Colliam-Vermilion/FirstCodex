"/><Base value="G" count="1858306478"/><Base value="T" count="1436645801"/><Base value="N" count="7245687"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX2558332" alias="JGI-SRA-45469"><IDENTIFIERS><PRIMARY_ID>SRX2558332</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45469</EXTERNAL_ID></IDENTIFIERS><TITLE>Metatranscriptome from sulfate-stimulated peat soil microcosm, amended with propionate, incubated for 8 days (replicate 1) [RNA sample 213]</TITLE><STUDY_REF accession="SRP131522"><IDENTIFIERS><PRIMARY_ID>SRP131522</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA412438</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS2871720"><IDENTIFIERS><PRIMARY_ID>SRS2871720</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384348</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>AHZXC</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>other</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>Low Input (RNA)</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="JGI" accession="SRA537769" alias="SUB2404198"><IDENTIFIERS><PRIMARY_ID>SRA537769</PRIMARY_ID><SUBMITTER_ID namespace="JGI">SUB2404198</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" org_id="37" url="http://jgi.doe.gov/"><Name abbr="JGI">DOE Joint Genome Institute</Name><Address postal_code="94720"><Department>Genomics</Department><Institution>DOE Joint Genome Institute</Institution><Street>1 Cyclotron Road, Building 91</Street><City>Berkeley</City><Sub>CA</Sub><Country>USA</Country></Address><Contact email="jgi-genbank@lists.jgi-psf.org"><Name><First>JGI</First><Last>genbank</Last></Name></Conta