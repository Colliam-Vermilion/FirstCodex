us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="sff" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="1" nspots="189348"><Read index="0" count="189348" average="608.56" stdev="88.34"/></Statistics><Bases cs_native="false" count="115229725"><Base value="A" count="39251628"/><Base value="C" count="18024944"/><Base value="G" count="18550325"/><Base value="T" count="38733704"/><Base value="N" count="669124"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24792896" alias="2201MN3_MT"><IDENTIFIERS><PRIMARY_ID>SRX24792896</PRIMARY_ID></IDENTIFIERS><TITLE>metatranscriptome of iron microbial mat: wetland at the Savannah River Site</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>An Illumina Low Input (RNA) library was constructed and sequenced 2x151 using the Illumina NovaSeq platform. Raw reads were processed with BBDuk (version 39.01) to remove contaminants, trim adapter sequences, remove homopolymer tails with 5 Gs, and right quality trim reads where quality drops to 0. BBDuk was also used to remove reads that contained 1 or more 'N' bases, had an average quality score below 10, or had a minimum length &lt;51 bp. Reads mapped with BBMap to contaminants (human, cat, dog, mouse, common microbial contaminants, ribosomal RNA, or known spike-ins) were also removed</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21510023"><IDENTIFIERS><PRIMARY_ID>SRS21510023</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570321</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>2201MN3_MT</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>other</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq X</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Earth Sciences" center_name="University of Delaware" accession="SRA1888702" alias="SUB14505159"><IDENTIFIERS><PRIMARY_ID>SRA1888702</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB14505159</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Contact email="gtothero@udel.edu" sec_email="graceetothero@gmail.com"><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Name><First>Gracee</First><Last>Tothero</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1117470" accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomes of iron microbial mats from a freshwater terrestrial stream and wetlands. Metagenome</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Our work focuses on Tims Branch at the Savannah River Site (SRS), a tributary that flowsdirectly into the Savannah River in South Carolina. Macroscopic freshwater iron mats are widespread inTims Branch; furthermore, microscopy of these mats shows biomineral morphologies consistent with theknown FeOB genera Leptothrix and Gallionella. These factors make Tims Branch ideal for studying ironoxidizers. This project is designed to fill research gaps surrounding the rate and controls on environmentaliron oxidation, and the metabolism of FeOB.The research objectives are:Objective 1: Quantify microbial iron oxidation rates in terrestrial iron mats using an integratedfield and kinetics studyObjective 2: Identify and quantify dominant iron-oxidizing microorganisms in terrestrialiron mats using metagenomics and metatranscriptomicsObjective 3: Construct microbial metabolic models of iron oxidizers and iron matcommunities to link microbial iron oxidation to C, N and S cycling</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>39133000</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="2201MN3" accession="SRS21510023"><IDENTIFIERS><PRIMARY_ID>SRS21510023</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570321</EXTERNAL_ID><SUBMITTER_ID namespace="pda|gtothero@orcid" label="Sample name">2201MN3</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>527640</TAXON_ID><SCIENTIFIC_NAME>microbial mat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1117470</ID><LABEL>PRJNA1117470</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-01-11</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>35</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>260</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>freshwater terrestrial wetland</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: South Carolina, Savannah River Site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>33.34 N 81.72 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolate</TAG><VALUE>2201MN3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>iron microbial mat from freshwater terrestrial wetland</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.microbial</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21510023" sample_name="2201MN3" spots="27857305" bases="8061930665" tax_id="527640" organism="microbial mat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS21510023</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570321</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="8061930665" spots="27857305" bytes="1650315091"><RUN accession="SRR29275561" alias="2201MN3.filter-MTF.fastq.gz" total_spots="27857305" total_bases="8061930665" size="1650315091" load_done="true" published="2024-07-26 15:29:19" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR29275561</PRIMARY_ID><SUBMITTER_ID namespace="SUB14505159" label="0">2201MN3.filter-MTF.fastq.gz</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX24792896"><IDENTIFIERS><SUBMITTER_ID namespace="SUB14505159">2201MN3_MT</SUBMITTER_ID></IDENTIFIERS></EXPERIMENT_REF><Pool><Member member_name="" accession="SRS21510023" sample_name="2201MN3" spots="27857305" bases="8061930665" tax_id="527640" organism="microbial mat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS21510023</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570321</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="2201MN3.filter-MTF.fastq.gz" size="1748987525" date="2024-06-04 12:04:25" md5="63647d230de018ef40c8e7f6d3bc7542" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-18/SRR29275561/2201MN3.filter-MTF.fastq.gz.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR29275561" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR29275561/SRR29275561" size="1650318198" date="2024-06-04 12:04:39" md5="42ab1550fd4863c472c3a6361d408bb9" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR29275561/SRR29275561" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR29275561.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/SRR029/29275/SRR29275561/SRR29275561.lite.1" size="1226011494" date="2024-06-04 13:08:34" md5="821efa38147b484dd011ed9dec15eb71" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos11/sra-pub-zq-1140/SRR029/29275/SRR29275561/SRR29275561.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-2/SRR29275561/SRR29275561.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-100/SRR29275561/SRR29275561.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="27857305"><Read index="0" count="27857305" average="144.72" stdev="11.54"/><Read index="1" count="27857305" average="144.68" stdev="11.56"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="27857305"/><Elements count="8061930665"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="8061930665"><Base value="A" count="2076912489"/><Base value="C" count="1946835995"/><Base value="G" count="1984533795"/><Base value="T" count="2053627794"/><Base value="N" count="20592"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24792897" alias="2201DE1_MT"><IDENTIFIERS><PRIMARY_ID>SRX24792897</PRIMARY_ID></IDENTIFIERS><TITLE>metatranscriptome of iron microbial mat: wetland at the Savannah River Site</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>An Illumina Low Input (RNA) library was constructed and sequenced 2x151 using the Illumina NovaSeq platform. Raw reads were processed with BBDuk (version 39.01) to remove contaminants, trim adapter sequences, remove homopolymer tails with 5 Gs, and right quality trim reads where quality drops to 0. BBDuk was also used to remove reads that contained 1 or more 'N' bases, had an average quality score below 10, or had a minimum length &lt;51 bp. Reads mapped with BBMap to contaminants (human, cat, dog, mouse, common microbial contaminants, ribosomal RNA, or known spike-ins) were also removed</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21510024"><IDENTIFIERS><PRIMARY_ID>SRS21510024</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570293</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>2201DE1_MT</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>other</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq X</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Earth Sciences" center_name="University of Delaware" accession="SRA1888702" alias="SUB14505159"><IDENTIFIERS><PRIMARY_ID>SRA1888702</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB14505159</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Contact email="gtothero@udel.edu" sec_email="graceetothero@gmail.com"><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Name><First>Gracee</First><Last>Tothero</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1117470" accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomes of iron microbial mats from a freshwater terrestrial stream and wetlands. Metagenome</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Our work focuses on Tims Branch at the Savannah River Site (SRS), a tributary that flowsdirectly into the Savannah River in South Carolina. Macroscopic freshwater iron mats are widespread inTims Branch; furthermore, microscopy of these mats shows biomineral morphologies consistent with theknown FeOB genera Leptothrix and Gallionella. These factors make Tims Branch ideal for studying ironoxidizers. This project is designed to fill research gaps surrounding the rate and controls on environmentaliron oxidation, and the metabolism of FeOB.The research objectives are:Objective 1: Quantify microbial iron oxidation rates in terrestrial iron mats using an integratedfield and kinetics studyObjective 2: Identify and quantify dominant iron-oxidizing microorganisms in terrestrialiron mats using metagenomics and metatranscriptomicsObjective 3: Construct microbial metabolic models of iron oxidizers and iron matcommunities to link microbial iron oxidation to C, N and S cycling</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>39133000</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="2201DE1" accession="SRS21510024"><IDENTIFIERS><PRIMARY_ID>SRS21510024</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570293</EXTERNAL_ID><SUBMITTER_ID namespace="pda|gtothero@orcid" label="Sample name">2201DE1</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>527640</TAXON_ID><SCIENTIFIC_NAME>microbial mat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1117470</ID><LABEL>PRJNA1117470</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-01-11</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>35 cm</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>260</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>freshwater terrestrial wetland</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: South Carolina, Savannah River Site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>33.34 N 81.72 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolate</TAG><VALUE>2201DE1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>iron microbial mat from freshwater terrestrial wetland</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.microbial</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS21510024" sample_name="2201DE1" spots="19151693" bases="5502048665" tax_id="527640" organism="microbial mat me