<TAG>water_content_soil</TAG><VALUE>0.78 g/g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sulfate_stimulated</TAG><VALUE>no</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>amended_substrate</TAG><VALUE>formate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>incubation_time_days</TAG><VALUE>36</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm_id</TAG><VALUE>34</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>replicate</TAG><VALUE>1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS2871688" sample_name="Sb_2010_peat_soil_microcosm_34_F-S_36d" sample_title="Peat soil microcosm, amended with formate, incubated for 36 days (replicate 1)" spots="24662194" bases="7398658200" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871688</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384305</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="7398658200" spots="24662194" bytes="3031433571"><RUN accession="SRR5252778" alias="JGI-SRA-45488" total_spots="24662194" total_bases="7398658200" size="3031433571" load_done="true" published="2017-02-14 07:17:18" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR5252778</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45488</EXTERNAL_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX2558383"><IDENTIFIERS><EXTERNAL_ID namespace="JGI">JGI-SRA-45488</EXTERNAL_ID></IDENTIFIERS></EXPERIMENT_REF><RUN_ATTRIBUTES><RUN_ATTRIBUTE><TAG>loader</TAG><VALUE>latf-load</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>run_id</TAG><VALUE>8673</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>nominal_length</TAG><VALUE>270</VALUE></RUN_ATTRIBUTE></RUN_ATTRIBUTES><Pool><Member member_name="" accession="SRS2871688" sample_name="Sb_