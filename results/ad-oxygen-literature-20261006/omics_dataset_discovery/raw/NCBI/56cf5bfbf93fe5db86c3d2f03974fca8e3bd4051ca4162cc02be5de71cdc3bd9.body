bmission_comment="submission brokered by GEO" lab_name="" accession="SRA715445"><IDENTIFIERS><PRIMARY_ID>SRA715445</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115371</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115371" accession="SRP149823"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474721</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115371</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (RNA-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNAseq profiling of seeds and 7 time points during germination in rice under aerobic and anerobic conditions, as well as following re-oxygenation. Overall design: Total RNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 1 h, 3 h, 12 h, 24 h, 2 days, 3 days and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115371</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176781" accession="SRS3381433"><IDENTIFIERS><PRIMARY_ID>SRS3381433</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371418</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176781</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 12 h of anaerobic germination (12hN) Replicate 3</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAM