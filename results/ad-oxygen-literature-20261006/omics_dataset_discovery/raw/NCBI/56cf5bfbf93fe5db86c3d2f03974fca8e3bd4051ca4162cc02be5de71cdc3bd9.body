NKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice embryos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>embryos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>dry seed 0 h Replicate 3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>Oryza sativa seeds were de-hulled and embryos were immediately extracted and snap frozen.</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381415" sample_name="GSM3176763" sample_title="dry seed 0 h Replicate 3" spots="27812538" bases="2670003648" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381415</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371436</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176763</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="2670003648" spots="27812538" bytes="1080397528"><RUN alias="GSM3176763_r1" accession="SRR7265375" total_spots="27812538" total_bases="2670003648" size="1080397528" load_done="true" published="2018-06-12 16:06:12" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265375</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176763_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169470" refname="GSM3176763"/><Pool><Member member_name="" accession="SRS3381415" sample_name="GSM3176763" sample_title="dry seed 0 h Replicate 3" spots="27812538" bases="2670003648" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381415</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371436</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176763</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="0h_3_RNA_ATGTCA_L004_R1_001.fastq.gz" size="1846691678" date="2020-02-25 05:33:08" md5="f9049802c0a29cd7cb43b3d