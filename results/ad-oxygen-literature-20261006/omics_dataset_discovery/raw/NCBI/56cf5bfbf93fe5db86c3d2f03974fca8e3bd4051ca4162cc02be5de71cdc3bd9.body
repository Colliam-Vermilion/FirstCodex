<EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3176808" accession="SRX4169515"><IDENTIFIERS><PRIMARY_ID>SRX4169515</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3176808: seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3; Oryza sativa; RNA-Seq</TITLE><STUDY_REF accession="SRP149823" refname="GSE115371"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3381460"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA isolation was carried out using the Sigma Spectrum Plant Total RNA kit. TruSeq Stranded Total RNA with Ribo‐Zero Plant Sample Prep Kits were used to generate the libraries, according to manufacturer's instructions (Illumina). rRNAs removed, random fragmentation, stranded library</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176808</ID><LABEL>GSM3176808</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176808</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115371" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715445"><IDENTIFIERS><PRIMARY_ID>SRA715445</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115371</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115371" accession="SRP149823"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474721</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115371</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (RNA-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNAseq profiling of seeds and 7 time points during germination in rice under aerobic and anerobic conditions, as well as following re-oxygenation. Overall design: Total RNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 1 h, 3 h, 12 h, 24 h, 2 days, 3 days and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115371</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176808" accession="SRS3381460"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAME>Oryza sativa</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>474721</ID><LABEL>PRJNA474721</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>seeds following 3 d of anaerobic germination and 1 d under aerobic conditions (3dN1dA) Replicate 3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>De-hulled sterilised seeds were grown in MES culture medium bubbled with nitrogen gas (anaerobic-N) at 30 C in the dark for 3 d, the gas was then switched to air for 1 d (3dN1dA).</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381460" sample_name="GSM3176808" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3" spots="25667195" bases="2464050720" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="2464050720" spots="25667195" bytes="981998192"><RUN alias="GSM3176808_r1" accession="SRR7265420" total_spots="25667195" total_bases="2464050720" size="981998192" load_done="true" published="2018-06-12 16:06:13" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265420</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176808_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169515" refname="GSM3176808"/><Pool><Member member_name="" accession="SRS3381460" sample_name="GSM3176808" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3" spots="25667195" bases="2464050720" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_