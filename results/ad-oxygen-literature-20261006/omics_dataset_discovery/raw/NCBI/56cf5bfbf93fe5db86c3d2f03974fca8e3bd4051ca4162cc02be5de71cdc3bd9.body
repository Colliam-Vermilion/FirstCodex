><Statistics source="meta"><Rows count="24912022"/><Elements count="2391554112"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="2391554112"><Base value="A" count="676777119"/><Base value="C" count="571535064"/><Base value="G" count="509404691"/><Base value="T" count="633755682"/><Base value="N" count="81556"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3176775" accession="SRX4169482"><IDENTIFIERS><PRIMARY_ID>SRX4169482</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3176775: seeds following 3 h of anaerobic germination (3hN) Replicate 3; Oryza sativa; RNA-Seq</TITLE><STUDY_REF accession="SRP149823" refname="GSE115371"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3381429"><IDENTIFIERS><PRIMARY_ID>SRS3381429</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176775</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA isolation was carried out using the Sigma Spectrum Plant Total RNA kit. TruSeq Stranded Total RNA with Ribo‐Zero Plant Sample Prep Kits were used to generate the libraries, according to manufacturer's instructions (Illumina). rRNAs removed, random fragmentation, stranded library</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176775</ID><LABEL>GSM3176775</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176775</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115371" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715445"><IDENTIFIERS><PRIMARY_ID>SRA715445</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115371</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115371" accession="SRP149823"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474721</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115371</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (RNA-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNAseq profiling of seeds and 7 time points during germination in rice under aerobic and anerobic conditions, as well as following re-oxygenation. Overall design: Total RNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 1 h, 3 h, 12 h, 24 h, 2 days, 3 days and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115371</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176775" accession="SRS3381429"><IDENTIFIERS><PRIMARY_ID>SRS3381429</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371424</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176775</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 3 h of anaerobic germination (3hN) Replicate 3</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIE