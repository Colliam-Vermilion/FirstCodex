ganic matter availability has a prevailing predominance over the recovery desiccation and O2 stresses caused on methanogenic archaea by natural drying.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="SC-2128" accession="SRS9167719"><IDENTIFIERS><PRIMARY_ID>SRS9167719</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN19641899</EXTERNAL_ID><SUBMITTER_ID namespace="pda|aircus@gmail.com" label="Sample name">SC-2128</SUBMITTER_ID></IDENTIFIERS><TITLE>Bacteria</TITLE><SAMPLE_NAME><TAXON_ID>1263854</TAXON_ID><SCIENTIFIC_NAME>anaerobic digester metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>736312</ID><LABEL>PRJNA736312</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Digestate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2018-09-14</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Sweden: Uppsala</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>59.816393 N 17.660465 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS9167719" sample_name="SC-2128" sample_title="Bacteria" spots="138006" bases="83079612" tax_id="1263854" organism="anaerobic digester metagenome"><IDENTIFIERS><PRIMARY_ID>SRS9167719</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN19641899</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="83079612" spots="138006" bytes="53380088"><RUN accession="SRR14769655" alias="SC-2128-231_S176_L001_R1_001.fastq.gz" total_spots="138006" total_bases="83079612" size="53380088" load_done="true" published="2021-10-21 01:02:02" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR14769655</PRIMARY_ID><SUBMITTER_ID namespace="SUB9820177" label="66">