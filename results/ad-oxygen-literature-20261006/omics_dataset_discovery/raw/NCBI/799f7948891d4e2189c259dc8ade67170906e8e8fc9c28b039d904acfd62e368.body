ount="7046548"/><Base value="C" count="8443039"/><Base value="G" count="8325396"/><Base value="T" count="6886780"/><Base value="N" count="347591"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX11102993" alias="296"><IDENTIFIERS><PRIMARY_ID>SRX11102993</PRIMARY_ID></IDENTIFIERS><TITLE>3FW_Air_I_1</TITLE><STUDY_REF accession="SRP323442"><IDENTIFIERS><PRIMARY_ID>SRP323442</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>each sample are triplicated</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS9167719"><IDENTIFIERS><PRIMARY_ID>SRS9167719</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>296</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Department of Molecular Sciences" center_name="Swedish University of Agricultural Sciences" accession="SRA1243033" alias="SUB9820177"><IDENTIFIERS><PRIMARY_ID>SRA1243033</PRIMARY_ID><SUBMITTER_ID namespace="Swedish University of Agricultural Sciences">SUB9820177</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="https://www.slu.se/en/departments/molecular-sciences/"><Name>Swedish University of Agricultural Sciences</Name><Address postal_code="75007"><Department>Department of Aquatic Sciences and Assessment</Department><Institution>Swedish University of Agricultural Sciences</Institution><Street>Almas alle 5</Street><City>Uppsala</City><Sub>Sweden</Sub><Country>Sweden</Country></Address><Contact email="Tong.Liu@slu.se" sec_email="Tong.Liu@slu.se"><Address postal_code="75007"><Department>Department of Aquatic Sciences and Assessment</Department><Institution>Swedish University of Agricultural Sciences</Institution><Street>Almas alle 5</Street><City>Uppsala</City><Sub>Sweden</Sub><Country>Sweden</Country></Address><Name><First>Tong</First><Last>Liu</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA736312" accession="SRP323442"><IDENTIFIERS><PRIMARY_ID>SRP323442</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA736312</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Drying effect on Digestate methane potential and oxygen tolerant of methanogenic related microbial community</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>In natural systems, such as lake sediments and paddy fields drying has been shown to increases methane production. However, in contrast, the decrease in water availability and the sudden exposure to oxygen should largely inhibit methanogenesis since methanogen, without forming resting spores, is believed to be intolerant to oxygen. The aim of this research was to explore the effect on microbial communities and methane production when drying and rewetting digestate with different organic matter content under aerobic and anaerobic conditions, respectively. We hypothesize that the organic matter availability has a prevailing predominance over the recovery desiccation and O2 stresses caused on methanogenic archaea by natural drying.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="SC-2128" accession="SRS9167719"><IDENTIFIERS><PRIMARY_ID>SRS9167719</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN19641899</EXTERNAL_ID><SUBMITTER_ID namespace="pda|aircus@gmail.com" label="Sample name">SC-2128</SUBMITTER_ID></IDENTIFIERS><TITLE>Bacteria</TITLE><SAMPLE_NAME><TAXON_ID>1263854</TAXON_ID><SCIENTIFIC_NAME>anaerobic digester metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>736312</ID><LABEL>PRJNA736312</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Digestate</VALUE></SAMPLE_ATTRIBUT