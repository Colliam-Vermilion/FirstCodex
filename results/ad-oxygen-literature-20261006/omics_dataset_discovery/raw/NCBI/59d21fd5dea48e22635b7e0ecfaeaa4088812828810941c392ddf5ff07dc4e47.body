<EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM1856252" accession="SRX1156609"><IDENTIFIERS><PRIMARY_ID>SRX1156609</PRIMARY_ID></IDENTIFIERS><TITLE>GSM1856252: Sample collected aftershift from 0.4 kPa ox to 0.8 kPa ox; Malus domestica; RNA-Seq</TITLE><STUDY_REF accession="SRP062551" refname="GSE72153"><IDENTIFIERS><PRIMARY_ID>SRP062551</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS1038518"><IDENTIFIERS><PRIMARY_ID>SRS1038518</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM1856252</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>Total RNA was extracted as described by Botton et al. (2011). RNA quality and integrity were checked on a Bioanalyzer 2100 (Agilent, Santa Clara, CA) Sequencing libraries were prepared using the TruSeq RNA Sample Prep kit (Illumina Inc.) according to the manufacturer’s instructions. Sequencing was carried out on an Illumina HiSeq2000 in two lane single-read 50bp</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>301856252</ID></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM1856252</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE72153" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA289537"><IDENTIFIERS><PRIMARY_ID>SRA289537</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE72153</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">Gene Expression Omnibus</Name></Organization><STUDY center_name="GEO" alias="GSE72153" accession="SRP062551"><IDENTIFIERS><PRIMARY_ID>SRP062551</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA293208</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE72153</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Molecular responses and metabolic reset of apple fruit under postharvest low oxygen stress</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>In the present work we report data on the application of an integrated approach on apples held under two levels of low oxygen concentrations  throughout  the initial 2 months of  storage, when, in general, strict control of the effects of the extremely low oxygen concentration is  required for a successful DCA performance. Overall design: Examination of 4 different condition. Three replicates per condition</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE72153</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>26909091</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="GSM1856252" accession="SRS1038518"><IDENTIFIERS><PRIMARY_ID>SRS1038518</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN03998551</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1856252</EXTERNAL_ID></IDENTIFIERS><TITLE>Sample collected aftershift from 0.4 kPa ox to 0.8 kPa ox</TITLE><SAMPLE_NAME><TAXON_ID>3750</TAXON_ID><SCIENTIFIC_NAME>Malus domestica</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>293208</ID><LABEL>PRJNA293208</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Slices (about 1 cm thick) of cortex tissue from the equatorial part of fruit</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>cultivar</TAG><VALUE>Granny Smith</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>cortex</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS1038518" sample_name