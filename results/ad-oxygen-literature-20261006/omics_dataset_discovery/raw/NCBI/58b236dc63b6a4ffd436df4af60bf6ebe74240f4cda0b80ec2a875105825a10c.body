e="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-18/SRR13245405/QMFCE022AT_KSH1_R2.fastq.gz.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR13245405" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13245405/SRR13245405" size="1537207629" date="2020-12-16 15:00:00" md5="b1941ce752011ba6f954852ed54a2868" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13245405/SRR13245405" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR13245405.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13245/SRR13245405/SRR13245405.lite.1" size="1089849821" date="2022-08-09 22:49:05" md5="9b510318b46019d018bf12ca5be0c38f" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13245/SRR13245405/SRR13245405.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-1/SRR13245405/SRR13245405.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-105/SRR13245405/SRR13245405.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="27222142"><Read index="0" count="27222142" average="74.83" stdev="2.14"/><Read index="1" count="27222142" average="74.84" stdev="2.06"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="m