icates). Library preparation including bacterial ribodepletion (NuGen Universal Prokaryotic RNA-Seq kit incl. bacterial ribodepletion) and Illumina NextSeq v2.5 sequencing with PE 75 bp and 21 to 62 Mio clusters per sample were performed by Microsynth AG (Balgach, Switzerland).</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>34020935</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="QMFCE051A8" accession="SRS7832279"><IDENTIFIERS><PRIMARY_ID>SRS7832279</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN16998557</EXTERNAL_ID><SUBMITTER_ID namespace="pda|geomicro" label="Sample name">QMFCE051A8</SUBMITTER_ID></IDENTIFIERS><TITLE>Culture KS heterotrophic D09</TITLE><SAMPLE_NAME><TAXON_ID>556182</TAXON_ID><SCIENTIFIC_NAME>freshwater sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>Enrichment culture KS published 1996, DOI: 10.1128/AEM.62.4.1458-1460.1996</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>682552</ID><LABEL>PRJNA682552</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>1996</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>1 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>terrestrial biome [ENVO:00000446]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>sediment [ENVO:00002007]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Bremen, pond</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>53.11 N 8.847 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>growth</TAG><VALUE>heterotrophic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>substrate</TAG><VALUE>Acetate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>time_po