="" accession="SRS7832291" sample_name="QMFCE044AP" sample_title="Culture KS autotrophic D7" spots="96367" bases="47960263" tax_id="556182" organism="freshwater sediment metagenome"><IDENTIFIERS><PRIMARY_ID>SRS7832291</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN16998550</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="QMFCE044AP_YHA10_S93_R1_001.fastq.gz" size="8511559" date="2020-12-04 09:56:39" md5="9c013b14f8fa72274ab3f8eeb3376225" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-17/SRR13197585/QMFCE044AP_YHA10_S93_R1_001.fastq.gz.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="QMFCE044AP_YHA10_S93_R2_001.fastq.gz" size="9873833" date="2020-12-04 09:56:40" md5="cc413e5e5cc28c612ab12d2c33ec53a5" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-17/SRR13197585/QMFCE044AP_YHA10_S93_R2_001.fastq.gz.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR13197585" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13197585/SRR13197585" size="24635383" date="2020-12-04 09:56:47" md5="5b25e65569795abf197d617d689fc490" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13197585/SRR13197585" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR13197585.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13197/SRR13197585/SRR13197585.lite.1" size="11936171" date="2022-08-09 22:32:09" md5="fab1d4415af380aa7e1d5b5530ec7820" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13197/SRR13197585/S