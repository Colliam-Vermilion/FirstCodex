-922/SRR012/12244/SRR12244048/SRR12244048.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-4/SRR12244048/SRR12244048.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-107/SRR12244048/SRR12244048.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="44755287"><Read index="0" count="44755287" average="101" stdev="0"/><Read index="1" count="44755287" average="101" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="44755287"/><Elements count="9040567974"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="9040567974"><Base value="A" count="2464853072"/><Base value="C" count="2082487853"/><Base value="G" count="2101684688"/><Base value="T" count="2391490086"/><Base value="N" count="52275"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX9631698" alias="Culture KS autotrophic D0 1"><IDENTIFIERS><PRIMARY_ID>SRX9631698</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene amplicon sequencing of freshwater sediment core metagenome</TITLE><STUDY_REF accession="SRP295852"><IDENTIFIERS><PRIMARY_ID>SRP295852</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Microbial 16S rRNA genes were amplified using primers 515F and 806R targeting the V4 region. Nextera 2 nd step PCR incl. pooling. Sequencing on Illumina MiSeq, v2, 2x250 bp.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS7832271"><IDENTIFIERS><PRIMARY_ID>SRS7832271</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Culture KS autotrophic D0 1</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Center for Applied Geoscience" center_name="University of Tuebingen" accession="SRA1166855" alias="SUB8684742"><IDENTIFIERS><PRIMARY_ID>SRA1166855</PRIMARY_ID><SUBMITTER_ID namespace="University of Tuebingen">SUB8684742</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Tuebingen</Name><Address postal_code="72076"><Department>Quantitative Biology Center (QBiC)</Department><Institution>University of Tuebingen</Institution><Street>Ottfried-Mueller-Strasse 37</Street><City>Tuebingen</City><Country>Germany</Country></Address><Contact email="daniel.straub@qbic.uni-tuebingen.de" sec_email="d4straub@gmail.com"><Address postal_code="72076"><Department>Quantitative Biology Center (QBiC)</Department><Institution>University of Tuebingen</Institution><Street>Ottfried-Mueller-Strasse 37</Street><City>Tuebingen</City><Country>Germany</Country></Address><Name><First>Daniel</First><Last>Straub</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA682552" accession="SRP295852"><IDENTIFIERS><PRIMARY_ID>SRP295852</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA682552</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Multi-omics of the nitrate-reducing iron(II)-oxidizing culture KS</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Nitrate-reducing iron(II)-oxidizing bacteria are widespread in the environment contribute to nitrate removal and influence the fate of the greenhouse gases nitrous oxide and carbon dioxide. The autotrophic growth of nitrate-reducing iron(II)-oxidizing bacteria is rarely investigated and poorly understood. The most prominent model system for this type of studies is enrichment culture KS, which originates from a freshwater sediment in Bremen, Germany. To gain insights in the metabolism of nitrate reduction coupled to iron(II) oxidation under in the absence of organic carbon and oxygen limited conditions, we performed metagenomic, metatranscriptomic and metaproteomic analyses of culture KS.This dataset contains: (1) Raw sequencing data of 16S (V4 region, primers 515f and 806r) rRNA amplicon sequencing of the microbial community composition of the autotrophic NRFeOx enrichment culture KS. Illumina MiSeq sequencing (Illumina, San Diego, CA, USA) using PE 250 bp MiSeq Reagent Kit v2 (500 cycles kit) were performed at Microsynth AG (Balgach, Switzerland). (2) Raw sequencing data of shotgun metagenomics. For short reads, library was prepared with TruSeq DNA PCR-Free Kit (Illumina) and sequenced with PE 150 bp on a NovaSeq 6000 totalling 55 and 48 Gbp by CeGaT, Tuebingen, Germany. For long read sequencing, library preparation with ONT Native Ligation Kit was followed by sequencing with PromethION (Oxford Nanopore Technologies) flow cell (version 9.4.1) for 72h with standard settings (basecalling with HAC mode, bias voltage -180 mV) yielding 53 Gbp in 5 million reads by the NGS Competence Center Tuebingen (NCCT) of the University of Tuebingen, Germany. (3) Short and long reads were assembled with metaSPAdes v3.13.1 using https://github.com/nf-core/mag v1.0.0. (4) Raw sequencing data of shotgun metatranscriptomes (2 conditions, triplicates). Library preparation including bacterial ribodepletion (NuGen Universal Prokaryotic RNA-Seq kit incl. bacterial ribodepletion) and Illumina NextSeq v2.5 sequencing with PE 75 bp and 21 to 62 Mio clusters per sample were performed by Microsynth AG (Balgach, Switzerland).</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>34020935</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="QMFCE035AQ" accession="SRS7832271"><IDENTIFIERS><PRIMARY_ID>SRS7832271</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN16998541</EXTERNAL_ID><SUBMITTER_ID namespace="pda|geomicro" label="Sample name">QMFCE035AQ</SUBMITTER_ID></IDENTIFIERS><TITLE>Culture KS autotrophic D0</TITLE><SAMPLE_NAME><TAXON_ID>556182</TAXON_ID><SCIENTIFIC_NAME>freshwater sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>Enrichment culture KS published 1996, DOI: 10.1128/AEM.62.4.1458-1460.1996</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>682552</ID><LABEL>PRJNA682552</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>1996</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>missing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>1 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>terrestrial biome [ENVO:00000446]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>sediment [ENVO:00002007]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Bremen, pond</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>53.11 N 8.847 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>growth</TAG><VALUE>autotrophic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>substrate</TAG><VALUE>Fe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>time_point</TAG><VALUE>D0</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Replicate</TAG><VALUE>1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation-source</TAG><VALUE>freshwater sediment enrichment culture KS</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.sediment</VALUE></SAMPL