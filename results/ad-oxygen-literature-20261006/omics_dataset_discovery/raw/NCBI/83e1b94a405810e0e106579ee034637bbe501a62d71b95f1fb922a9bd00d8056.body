ssion="SRS12060104" sample_name="GSM5908644" sample_title="MSR1_MaxMag, 2" spots="9972763" bases="747957225" tax_id="431944" organism="Magnetospirillum gryphiswaldense MSR-1"><IDENTIFIERS><PRIMARY_ID>SRS12060104</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN26135438</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM5908644</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="MaxMag_2.fastq.gz" size="452289059" date="2022-02-23 11:13:37" md5="b9fe11343948b06a59446c9e0dfb6c2b" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-18/SRR18087886/MaxMag_2.fastq.gz.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR18087886" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR18087886/SRR18087886" size="310919949" date="2022-02-23 11:13:53" md5="4139d6669015bbe1634c55eab16d76d4" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR18087886/SRR18087886" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR18087886.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR018/18087/SRR18087886/SRR18087886.lite.1" size="210650049" date="2022-10-22 11:46:54" md5="d4fa1487b4b546d692b8c5aaeb6eea35" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR018/18087/SRR18087886/SRR18087886.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-5/SRR18087886/SRR18087886.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-108/SRR18087886/SRR18087886.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><Cl