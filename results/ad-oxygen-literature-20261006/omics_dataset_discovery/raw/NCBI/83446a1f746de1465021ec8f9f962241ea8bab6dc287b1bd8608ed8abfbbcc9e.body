om/sra/SRR18048383/SRR18048383" size="45704638" date="2022-02-17 19:03:19" md5="cce70c32a3d159dac82acb2877792814" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR18048383/SRR18048383" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR18048383.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos8/sra-pub-zq-820/SRR018/18048/SRR18048383/SRR18048383.lite.1" size="19950403" date="2022-10-27 19:15:47" md5="43c0780134e8cad0e2935935f48b9a7b" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos8/sra-pub-zq-820/SRR018/18048/SRR18048383/SRR18048383.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-5/SRR18048383/SRR18048383.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-103/SRR18048383/SRR18048383.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="131847"><Read index="0" count="131847" average="300" stdev="0"/><Read index="1" count="131847" average="300" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="131847"/><Elements count="79108200"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="79108200"><Base value="A" count="18012165"/><Base value="C" count="20563331"/><Base value="G" count="22607513"/><Base value="T" count="17924827"/><Base value="N" count="364"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX14200659" alias="Bottle2_Day156"><IDENTIFIERS><PRIMARY_ID>SRX14200659</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene amplicon sequencing of Bottle 2: treated with 0.1 mL air (Day 53) + 10 mL air (Day 94), 156 days of incubation</TITLE><STUDY_REF accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The cell pellet (10,000 x g centrifugation, 15 min) from 1 mL culture was frozen at -80 C for later DNA extraction using the Dneasy PowerSoil Kit (Qiagen) according to the manufacturer's procedure. Amplification and Illumina sequencing (MiSeq 300PE; paired-end) of extracted gDNA was carried out by McGill University at the Genome Quebec Innovation Centre. All amplicon sequences reads were generated using modified, staggered end primers 926F (AAACTYAAAKGAATWGRCGG) and 1392R (ACGGGCGGTGWGTRC), where 0- 3 random bases were inserted between both primer and Illumina adaptor sequences.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS12021238"><IDENTIFIERS><PRIMARY_ID>SRS12021238</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Bottle2_Day156</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Biological Sciences" center_name="University of Toronto" accession="SRA1373587" alias="SUB11086720"><IDENTIFIERS><PRIMARY_ID>SRA1373587</PRIMARY_ID><SUBMITTER_ID namespace="University of Toronto">SUB11086720</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Toronto</Name><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Contact email="courtney.toth@utoronto.ca"><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Name><First>Courtney</First><Last>Toth</Last><Middle>R. A.</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA807302" accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA807302</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Oxygen tolerance testing of DGG-B, a methanogenic benzene-degrading enrichment culture</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>DGG-B is a strictly anaerobic methanogenic benzene-degrading enrichment culture originally derived decades ago from oil-contaminated sediment. A 1,200-day study was performed to test how small amounts of oxygen would affect degradation rates and impact its microbial community composition. The culture includes a benzene fermenter from Deltaproteobacteria Candidate clade Sva0485 (referred to as ORM2) and methanogenic archaea. Adding oxygen caused drastic perturbation of the microbial community. A benzene-degrading Pseudomonas became highly enriched and consumed all available oxygen. The number of ORM2 cells plummeted during this time and re-growth and associated recovery of methanogenic benzene degradation took almost one year. These results have quite profound implications when considering impact of transient oxygen exposure in field environments. Moreover, the methanogenic benzene degrading pathway is fundamentally different from reported aerobic pathways, carried out by distinct microbial communities, and without oxygen involvement.</STUDY_ABSTRACT></DESCRI