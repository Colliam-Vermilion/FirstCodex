te.1" size="11840341" date="2022-08-30 01:52:40" md5="2482f62df057f020fa03b2c6d1c870bf" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos1/sra-pub-zq-38/SRR018/18048/SRR18048378/SRR18048378.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-5/SRR18048378/SRR18048378.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-102/SRR18048378/SRR18048378.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="78081"><Read index="0" count="78081" average="300" stdev="0"/><Read index="1" count="78081" average="300" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="78081"/><Elements count="46848600"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="46848600"><Base value="A" count="10632387"/><Base value="C" count="12115873"/><Base value="G" count="13588565"/><Base value="T" count="10511754"/><Base value="N" count="21"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX14200664" alias="Bottle2_Day585"><IDENTIFIERS><PRIMARY_ID>SRX14200664</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene amplicon sequencing of Bottle 2: treated with 0.1 mL air (Day 53) + 10 mL air (Day 94) + 10 mL air (Day 224), 585 days of incubation</TITLE><STUDY_REF accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The cell pellet (10,000 x g centrifugation, 15 min) from 1 mL culture was frozen at -80 C for later DNA extraction using the Dneasy PowerSoil Kit (Qiagen) according to the manufacturer's procedure. Amplification and Illumina sequencing (MiSeq 300PE; paired-end) of extracted gDNA was carried out by McGill University at the Genome Quebec Innovation Centre. All amplicon sequences reads were generated using modified, staggered end primers 926F (AAACTYAAAKGAATWGRCGG) and 1392R (ACGGGCGGTGWGTRC), where 0- 3 random bases were inserted between both primer and Illumina adaptor sequences.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS12021243"><IDENTIFIERS><PRIMARY_ID>SRS12021243</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Bottle2_Day585</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Biological Sciences" center_name="University of Toronto" accession="SRA1373587" alias="SUB11086720"><IDENTIFIERS><PRIMARY_ID>SRA1373587</PRIMARY_ID><SUBMITTER_ID namespace="University of Toronto">SUB11086720</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Toronto</Name><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Contact email="courtney.toth@utoronto.ca"><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Name><First>Courtney</First><Last>Toth</Last><Middle>R. A.</Middle><