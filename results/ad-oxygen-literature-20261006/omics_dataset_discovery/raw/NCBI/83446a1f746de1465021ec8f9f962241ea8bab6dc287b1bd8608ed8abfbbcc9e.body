535"><Read index="0" count="141535" average="300" stdev="0"/><Read index="1" count="141535" average="300" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="141535"/><Elements count="84921000"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="84921000"><Base value="A" count="19794478"/><Base value="C" count="21563188"/><Base value="G" count="24576416"/><Base value="T" count="18986497"/><Base value="N" count="421"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX14200671" alias="Bottle3_Day137"><IDENTIFIERS><PRIMARY_ID>SRX14200671</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene amplicon sequencing of Bottle 3: treated with 0.1 mL air (Day 53), 137 days of incubation</TITLE><STUDY_REF accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The cell pellet (10,000 x g centrifugation, 15 min) from 1 mL culture was frozen at -80 C for later DNA extraction using the Dneasy PowerSoil Kit (Qiagen) according to the manufacturer's procedure. Amplification and Illumina sequencing (MiSeq 300PE; paired-end) of extracted gDNA was carried out by McGill University at the Genome Quebec Innovation Centre. All amplicon sequences reads were generated using modified, staggered end primers 926F (AAACTYAAAKGAATWGRCGG) and 1392R (ACGGGCGGTGWGTRC), where 0- 3 random bases were inserted between both primer and Illumina adaptor sequences.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS12021250"><IDENTIFIERS><PRIMARY_ID>SRS12021250</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Bottle3_Day137</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Biological Sciences" center_name="University of Toronto" accession="SRA1373587" alias="SUB11086720"><IDENTIFIERS><PRIMARY_ID>SRA1373587</PRIMARY_ID><SUBMITTER_ID namespace="University of Toronto">SUB11086720</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Toronto</Name><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Contact email="courtney.toth@utoronto.ca"><Address postal_code="M5S 3E5"><Department>Chemical Engineering &amp; Applied Chemistry</Department><Institution>University of Toronto</Institution><Street>200 College Street</Street><City>Toronto</City><Sub>ON</Sub><Country>Canada</Country></Address><Name><First>Courtney</First><Last>Toth</Last><Middle>R. A.</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA807302" accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA807302</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Oxygen tolerance testing of DGG-B, a methanogenic benzene-degrading enrichment culture</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>DGG-B is a strictly anaerobic methanogenic benzene-degrading enrichment culture originally derived decades ago from oil-contaminated sediment. A 1,200-day study was performed to test how small amounts of oxygen would affect degradation rates and impact its microbial community composition. The culture includes a benzene fermenter from Deltaproteobacteria Candidate clade Sva0485 (referred to as ORM2) and methanogenic archaea. Adding oxygen caused drastic perturbation of the microbial community. A benzene-degrading Pseudomonas became highly enriched and consumed all available oxygen. The number of ORM2 cells plummeted during this time and re-growth and associated recovery of methanogenic benzene degradation took almost one year. These results have quite profound implications when considering impact of transient oxygen exposure in field environments. Moreover, the methanogenic benzene degrading pathway is fundamentally different from reported aerobic pathways, carried out by distinct microbial communities, and without oxygen involvement.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="Bottle3_Day137" accession="SRS12021250"><IDENTIFIERS><PRIMARY_ID>SRS12021250</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN25976529</EXTERNAL_ID><SUBMITTER_ID namespace="pda|ctot" label="Sample name">Bottle3_Day137</SUBMITTER_ID></IDENTIFIERS><TITLE>Bottle3_Day137</TITLE><SAMPLE_NAME><TAXON_ID>1704045</TAXON_ID><SCIENTIFIC_NAME>aquifer metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>Bottle 3; active microcosm containing the methanogenic benzene-degrading enrichment culture DGG-B, 137 days of incuabtion, amended with 0.1 mL air on Day 53, bottle presentally anaerobic, methanogenic benzene degradation continues</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>807302</ID><LABEL>PRJNA807302</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2018-08-03</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0.3 - 0.7 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>300 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>Groundwater aquifer [ENVO:00012408]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>Petroleum-enriched sediments [ENVO:00002115]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>Sediment [ENVO:00002007]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Oklahoma, oil refinery</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>36 N 97 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Contaminated sediments from an oil refinery in Oklahoma, USA (Nales et al., 1998; Bioremediat J 2). The site was described as being from a saturated, highly anaerobic zone that had been chronically exposed to hydrocarbons.</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>oxy_stat_samp</TAG><VALUE>anaerobic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>The cell pellet (10,000 x g centrifugation, 15 min) from 1 mL culture was frozen at -80 C for later DNA extraction using the Dneasy PowerSoil Kit (Qiagen) according to the manufacturer's procedure.</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_store_dur</TAG><VALUE>-80</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>temp</TAG><VALUE>23 C</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Benzene degradation activity</TAG><VALUE>Methanogenic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Total bacteria (16S rRNA gene copies/mL)</TAG><VALUE>8.91E+07</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Total archaea (16S rRNA gene copies/mL)</TAG><VALUE>1.58E+07</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ORM2 (16S rRNA gene copies/mL)</TAG><VALUE>8.75E+07</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>OD1 (16S rRNA gene copies/mL)</TAG><VALUE>8.73E+06</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.sediment</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS12021250" sample_name="Bottle3_Day137" sample_title="Bottle3_Day137" spots="129587" bases="77752200" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIERS><PRIMARY_ID>SRS12021250</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN25976529</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="7775220