/><Read index="1" count="117140" average="300" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="117140"/><Elements count="70284000"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="70284000"><Base value="A" count="16444629"/><Base value="C" count="17894022"/><Base value="G" count="20316084"/><Base value="T" count="15629248"/><Base value="N" count="17"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX14200641" alias="Bottle3_Day401"><IDENTIFIERS><PRIMARY_ID>SRX14200641</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA gene amplicon sequencing of Bottle 3: treated with 0.1 mL air (Day 53), 401 days of incubation</TITLE><STUDY_REF accession="SRP360083"><IDENTIFIERS><PRIMARY_ID>SRP360083</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The cell pellet (10,000 x g centrifugation, 15 min) from 1 mL culture was frozen at -80 C for later DNA extraction using the Dneasy PowerSoil Kit (Qiagen) according to the manufacturer's procedure. Amplification and Illumina sequencing (MiSeq 300PE; paired-end) of extracted gDNA was carried out by McGill University at the Genome Quebec Innovation Centre. All amplicon sequences reads were generated using modified, staggered end primers 926F (AAACTYAAAKGAATWGRCGG) and 1392R (ACGGGCGGTGWGTRC), where 0- 3 random bases were inserted between both primer and Illumina adaptor sequences.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS12021220"><IDENTIFIERS><PRIMARY_ID>SRS12021220</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Bottle3_Day401</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_