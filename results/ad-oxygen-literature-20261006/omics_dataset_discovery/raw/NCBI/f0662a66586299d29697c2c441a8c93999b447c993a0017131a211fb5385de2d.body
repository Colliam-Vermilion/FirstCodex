alue="T" count="20184326"/><Base value="N" count="2327"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX4125061" alias="Ando-t0-R2_S33_L001_R1_001.fastq.Ando_t0_R2"><IDENTIFIERS><PRIMARY_ID>SRX4125061</PRIMARY_ID></IDENTIFIERS><TITLE/><STUDY_REF accession="SRP148981"><IDENTIFIERS><PRIMARY_ID>SRP148981</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3339477"><IDENTIFIERS><PRIMARY_ID>SRS3339477</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>Ando-t0-R2_S33_L001_R1_001.fastq.Ando_t0_R2</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>"Sequencing was performed on a MiSeq system with the bacterial primers 27F and 357R. PCR conditions: 98�C for 5 min; 98�C for 10 s / 60�C for 30 s / 72�C for 30 s (30 cycles); 72�C for 5 min. PCR reaction (total 25 �l): 1�NEBNext High Fidelity Master Mix, 5 pmol of each primer, 2 �l 3% BSA, 5 ng of template DNA. Sample purification: Gel and PCR Cleanup Kit (Macherey Nagel). Indexing PCR (Nextera� XT Index Kit v2 Set B): 98�C for 30 s; 98�C for 10 s / 55�C for 30 s / 72�C for 30 s (8 cycles); 72�C for 5 min. Sample purification: Gel and PCR Cleanup Kit (Macherey Nagel)."</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="mothur" accession="SRA710668" alias="SUB4076595"><IDENTIFIERS><PRIMARY_ID>SRA710668</PRIMARY_ID><SUBMITTER_ID namespace="mothur">SUB4076595</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" org_id="136" url=""><Name abbr="mothur">mothur</Name><Address postal_code="48109"><Department>Department of Microbiology &amp; Immunology</Department><Institution>mothur</Institution><Street>1520A Medical Science Research Bldg. I</Street><City>Ann Arbor</City><Sub>Mi</Sub><Country>USA</Country></Address><Contact email="pschloss@umich.edu"><Name><First>Patrick</First><Last>Schloss</Last></Name></Contact></Organization><STUDY center_name="Helmholtz Zentrum Muenchen" alias="Impact of redox fluctuations on soil organic matter formation and microbiomes" accession="SRP148981"><IDENTIFIERS><PRIMARY_ID>SRP148981</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA473143</EXTERNAL_ID><SUBMITTER_ID namespace="Helmholtz Zentrum Muenchen">Impact of redox fluctuations on soil organic matter formation and microbiomes</SUBMITTER_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Formation of soil organic matter under redox fluctuations depends on soil type</STUDY_TITLE><STUDY_TYPE existing_study_type="Metagenomics"/><STUDY_ABSTRACT>Here, we mimicked paddy soil development in the laboratory by exposing two soil types with contrasting mineral assemblage to 8 anoxic-oxic cycles over 1 year. A second set of samples with static oxic conditions was used as control. Soils received rice straw labelled with 13C at the beginning of each cycle. Fresh bulk samples were analyzed for their microbial diversity and microbial community composition using 16S rRNA gene sequencing and revealed a strong influence of soil type on the microbial community developing under redox fluctuation.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>Impact of redox fluctuations on soil organic matter formation and microbiomes</CENTER_PROJECT_NAME></DESCRIPTOR></STUDY><SAMPLE alias="Ando_t0_R2" accession="SRS3339477"><IDENTIFIERS><PRIMARY_ID>SRS3339477</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09260793</EXTERNAL_ID><SUBMITTER_ID namespace="Helmholtz Zentrum Muenchen">Ando_t0_R2</SUBMITTER_ID></IDENTIFIERS><TITLE>Ando - NP 2</TITLE><SAMPLE_NAME><TAXON_ID>410658</TAXON_ID><SCIENTIFIC_NAME>soil metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>Andosol control soil collected at t