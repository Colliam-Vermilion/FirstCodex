enomic DNA was extracted using the Mag-Bind Soil DNA Kit. DNA extract was fragmented to an average size of about 400 bp using Covaris M220 for paired-end library construction. Adapters containing the full complement of sequencing primer hybridization sites were ligated to the blunt-end of fragments. Paired-end sequencing was performed on Illumina NovaSeq 6003</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq 6000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><URL_LINK><LABEL>GSA CRX1716066, NGDC</LABEL><URL>https://ngdc.cncb.ac.cn/gsa/browse/CRA025609/CRX1716066</URL></URL_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>NGDC_submission_date</TAG><VALUE>2025-05-12</VALUE></EXPERIMENT_ATTRIBUTE><EXPERIMENT_ATTRIBUTE><TAG>NGDC_release_date</TAG><VALUE>2025-05-25</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION lab_name="" alias="CRA025609" accession="DRA023064"><IDENTIFIERS><PRIMARY_ID>DRA023064</PRIMARY_ID><SUBMITTER_ID namespace="NGDC">CRA025609</SUBMITTER_ID><SUBMITTER_ID namespace="Research Center for Eco-Environmental Sciences, Chinese Academy of Sciences">DRA023064</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="Jiangsu Collaborative Innovation Center for Solid ">NGDC</Name></Organization><STUDY alias="PRJDB36680" accession="DRP014737"><IDENTIFIERS><PRIMARY_ID>DRP014737</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="BioProject ID">PRJDB36680</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>wastewater sludge microbiome (PRJCA039809)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>wastewater sludge microbiome relation with microoxic</STUDY_ABSTRACT><STUDY_DESCRIPTION>wastewater sludge microbiome relation with microoxic</STUDY_DESCRIPTION></DESCRIPTOR></STUDY><SAMPLE alias="SAMD01675405" accession="DRS542518"><IDENTIFIERS><PRIMARY_ID>D