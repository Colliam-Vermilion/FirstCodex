7/sra-pub-zq-41/SRR032/32837/SRR32837996/SRR32837996.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-6/SRR32837996/SRR32837996.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-100/SRR32837996/SRR32837996.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="42440"><Read index="0" count="42440" average="300.93" stdev="3.20"/><Read index="1" count="42440" average="299.98" stdev="3.17"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="42440"/><Elements count="25502481"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="25502481"><Base value="A" count="5581541"/><Base value="C" count="7480111"/><Base value="G" count="6682191"/><Base value="T" count="5758567"/><Base value="N" count="71"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX28120612" alias="13C-_H_2_A"><IDENTIFIERS><PRIMARY_ID>SRX28120612</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA of river sediment</TITLE><STUDY_REF accession="SRP572702"><IDENTIFIERS><PRIMARY_ID>SRP572702</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>16S rRNA Bacteria/Archaea amplicon</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS24476359"><IDENTIFIERS><PRIMARY_ID>SRS24476359</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>13C-_H_2_A</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Center for Nuclear Energy in Agriculture" center_name="University of Sao Paulo" accession="SRA2099362" alias="SUB15197119"><IDENTIFIERS><PRIMARY_ID>SRA2099362</PRIMARY_ID><SUBMITTER_ID namespace="University of Sao Paulo">SUB15197119</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Sao Paulo</Name><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Contact email="lucaswmendes@gmail.com" sec_email="lwmendes@cena.usp.br"><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Name><First>Lucas</First><Last>Mendes</Last><Middle>William</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1241260" accession="SRP572702"><IDENTIFIERS><PRIMARY_ID>SRP572702</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1241260</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Oxygen fluctuation legacy alters the methane-driven interaction network</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This study investigates how fluctuating oxygen levels, driven by environmental and biological factors, affect aerobic methane-oxidizing bacteria (methanotrophs) and their microbial partners. While methanotrophs typically thrive at oxic-anoxic interfaces, their ability to adapt to dynamic oxygen shifts (e.g., hypoxia or transient anoxia) remains poorly understood. Using molecular tools like stable isotope probing and network analysis, we explore their metabolic resilience, interactions with surrounding microbes, and role in methane cycling under oxygen-variable conditions. By uncovering how these microbes persist and function in fluctuating environments, our work sheds light on their ecological impact and potential for mitigating methane emissions in natural habitats like wetlands and soils.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="AH55" accession="SRS24476359"><IDENTIFIERS><PRIMARY_ID>SRS24476359</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549501</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lucaswmendes@gmail.com" label="Sample name">AH55</SUBMITTER_ID></IDENTIFIERS><TITLE>13C-_H_2_A</TITLE><SAMPLE_NAME><TAXON_ID>1646512</TAXON_ID><SCIENTIFIC_NAME>riverine metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1241260</ID><LABEL>PRJNA1241260</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>River sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>A_13C-H_end_b</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-08-15</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Hannover</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>52.37 N 9.70 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS24476359" sample_name="AH55" sample_title="13C-_H_2_A" spots="42957" bases="25811950" tax_id="1646512" organism="riverine metagenome"><IDENTIFIERS><PRIMARY_ID>SRS24476359</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549501</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="25811950" spots="42957" bytes="16608469"><RUN accession="SRR32837997" alias="55_R1.fastq.gz" total