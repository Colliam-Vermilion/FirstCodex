><IDENTIFIERS><PRIMARY_ID>SRA2099362</PRIMARY_ID><SUBMITTER_ID namespace="University of Sao Paulo">SUB15197119</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Sao Paulo</Name><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Contact email="lucaswmendes@gmail.com" sec_email="lwmendes@cena.usp.br"><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Name><First>Lucas</First><Last>Mendes</Last><Middle>William</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1241260" accession="SRP572702"><IDENTIFIERS><PRIMARY_ID>SRP572702</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1241260</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Oxygen fluctuation legacy alters the methane-driven interaction network</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This study investigates how fluctuating oxygen levels, driven by environmental and biological factors, affect aerobic methane-oxidizing bacteria (methanotrophs) and their microbial partners. While methanotrophs typically thrive at oxic-anoxic interfaces, their ability to adapt to dynamic oxygen shifts (e.g., hypoxia or transient anoxia) remains poorly understood. Using molecular tools like stable isotope probing and network analysis, we explore their metabolic resilience, interactions with surrounding microbes, and role in methane cycling under oxygen-variable conditions. By uncovering how these microbes persist and function in fluctuating environments, our work sheds light on their ecological impact and potential for mitigating methane emissions in natural habitats like wetlands and soils.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="AH88" accession="SRS24476395"><IDENTIFIERS><PRIMARY_ID>SRS24476395</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549534</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lucaswmendes@gmail.com" label="Sample name">AH88</SUBMITTER_ID></IDENTIFIERS><TITLE>13C-L_1_D</TITLE><SAMPLE_NAME><TAXON_ID>1646512</TAXON_ID><SCIENTIFIC_NAME>riverine metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1241260</ID><LABEL>PRJNA1241260</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>River sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>D_13C-L_end_a</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-08-15</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Hannover</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>52.37 N 9.70 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS24476395" sample_name="AH88" sample_title="13C-L_1_D" spots="48860" bases="29336569" tax_id="1646512" organism="riverine metagenome"><IDENTIFIERS><PRIMARY_ID>SRS24476395</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549534</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="29336569" spots="48860" bytes="19291382"><RUN accession="SRR32837960" alias="88_R1.fastq.gz" total_spots="48860" total_bases="29336569" size="19291382" load_done="true" published="2025-03-24 15:53:57" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR32837960</PRIMARY_ID><SUBMITTER_ID namespace="SUB15197119" label="50">88_R1.fa