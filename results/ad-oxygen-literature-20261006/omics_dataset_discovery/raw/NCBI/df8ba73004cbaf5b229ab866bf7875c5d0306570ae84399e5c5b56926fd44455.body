 and potential for mitigating methane emissions in natural habitats like wetlands and soils.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="AH83" accession="SRS24476389"><IDENTIFIERS><PRIMARY_ID>SRS24476389</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549529</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lucaswmendes@gmail.com" label="Sample name">AH83</SUBMITTER_ID></IDENTIFIERS><TITLE>12C-L_4_C</TITLE><SAMPLE_NAME><TAXON_ID>1646512</TAXON_ID><SCIENTIFIC_NAME>riverine metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1241260</ID><LABEL>PRJNA1241260</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>River sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>C_12C-L_end_b</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-08-15</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Hannover</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>52.37 N 9.70 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS24476389" sample_name="AH83" sample_title="12C-L_4_C" spots="52507" bases="31532834" tax_id="1646512" organism="riverine metagenome"><IDENTIFIERS><PRIMARY_ID>SRS24476389</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549529</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="31532834" spots="52507" bytes="20777466"><RUN accession="SRR32837966" alias="83_R1.fastq.gz" total_spots="52507" total_bases="31532834" size="20777466" load_done="true" published="2025-03-24 15:53:57" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR32837966</PRIMARY_ID><SUBMITTER_ID namespace="SUB15197119" label="45">83_R1.fastq.gz</SUBMI