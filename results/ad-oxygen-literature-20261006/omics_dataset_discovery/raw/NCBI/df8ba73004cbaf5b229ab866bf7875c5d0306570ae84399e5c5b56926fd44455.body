UT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Center for Nuclear Energy in Agriculture" center_name="University of Sao Paulo" accession="SRA2099362" alias="SUB15197119"><IDENTIFIERS><PRIMARY_ID>SRA2099362</PRIMARY_ID><SUBMITTER_ID namespace="University of Sao Paulo">SUB15197119</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Sao Paulo</Name><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Contact email="lucaswmendes@gmail.com" sec_email="lwmendes@cena.usp.br"><Address postal_code="13416-000"><Department>Center for Nuclear Energy in Agriculture</Department><Institution>University of Sao Paulo</Institution><Street>Avenida Centenario 303</Street><City>Piracicaba</City><Sub>Sao Paulo</Sub><Country>Brazil</Country></Address><Name><First>Lucas</First><Last>Mendes</Last><Middle>William</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1241260" accession="SRP572702"><IDENTIFIERS><PRIMARY_ID>SRP572702</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1241260</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Oxygen fluctuation legacy alters the methane-driven interaction network</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This study investigates how fluctuating oxygen levels, driven by environmental and biological factors, affect aerobic methane-oxidizing bacteria (methanotrophs) and their microbial partners. While methanotrophs typically thrive at oxic-anoxic interfaces, their ability to adapt to dynamic oxygen shifts (e.g., hypoxia or transient anoxia) remains poorly understood. Using molecular tools like stable isotope probing and network analysis, we explore their metabolic resilience, interactions with surrounding microbes, and role in methane cycling under oxygen-variable conditions. By uncovering how these microbes persist and function in fluctuating environments, our work sheds light on their ecological impact and potential for mitigating methane emissions in natural habitats like wetlands and soils.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="AH77" accession="SRS24476382"><IDENTIFIERS><PRIMARY_ID>SRS24476382</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549523</EXTERNAL_ID><SUBMITTER_ID namespace="pda|lucaswmendes@gmail.com" label="Sample name">AH77</SUBMITTER_ID></IDENTIFIERS><TITLE>13C-H_4_C</TITLE><SAMPLE_NAME><TAXON_ID>1646512</TAXON_ID><SCIENTIFIC_NAME>riverine metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1241260</ID><LABEL>PRJNA1241260</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>River sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>C_13C-H_end_d</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2023-08-15</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Hannover</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>52.37 N 9.70 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS24476382" sample_name="AH77" sample_title="13C-H_4_C" spots="54329" bases="32633492" tax_id="1646512" organism="riverine metagenome"><IDENTIFIERS><PRIMARY_ID>SRS24476382</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN47549523</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="32633492" spots="54329" bytes="20846686"><RUN accession="SRR32837973" alias="77_R1.