                <Objectives>
                    <Data data_type="eRawSequenceReads"/>
                </Objectives>
                <IntendedDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
