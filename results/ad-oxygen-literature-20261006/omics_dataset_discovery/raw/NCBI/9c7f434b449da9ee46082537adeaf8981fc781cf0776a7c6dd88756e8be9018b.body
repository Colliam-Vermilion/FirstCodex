<DocumentSummary uid="1491653">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJNA1491653" archive="NCBI" id="1491653"/>
            <LocalID>bp0</LocalID>
            <LocalID>bp0</LocalID>
        </ProjectID>
        <ProjectDescr>
            <Title>Microbial community dynamics during anaerobic digestion of high-ammonia livestock wastewater under different aeration pretreatments</Title>
            <Description>This BioProject contains Illumina 16S rRNA gene amplicon sequencing data generated to characterize bacterial and archaeal community dynamics during anaerobic digestion of high-ammonia livestock wastewater.&lt;/p&gt;&lt;p&gt;Three pretreatment strategies were investigated, including nanobubble aeration pretreatment, conventional aeration pretreatment, and non-aerated control. Samples were collected from anaerobic digestion systems at different incubation stages.&lt;/p&gt;&lt;p&gt;The V3-V4 region of bacterial 16S rRNA genes and archaeal 16S rRNA genes were amplified and sequenced separately. Sequencing data were used to investigate microbial succession, nitrogen transformation-related microorganisms, methanogenic archaea, and their relationships with methane production performance during anaerobic digestion.&lt;/p&gt;&lt;p&gt;This dataset provides raw sequencing reads for studying microbial mechanisms involved in anaerobic treatment of livestock wastewater under different aeration strategies.</Description>
            <Relevance>
                <Environmental>yes</Environmental>
            </Relevance>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eWhole" material="eGenome" sample_scope="eMultispecies"/>
