<DocumentSummary uid="293548">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJNA293548" archive="NCBI" id="293548"/>
            <LocalID>bp0</LocalID>
            <LocalID>bp0</LocalID>
        </ProjectID>
        <ProjectDescr>
            <Name>marine sediment metagenome</Name>
            <Title>identification of the microbial genes and pathway induced in response to petroleum and oxygen oscillations in marine coastal sediments</Title>
            <Description>Identification of the genes induced in response to petroleum by metatranscriptomic approach: this characterization will be performed on simplified microbial communities focusing on anaerobic prokaryotes inhabiting the hydrocarbon compounds (HC)-degrading bacterial communities with special interest on the sulfate reducing prokaryotes (SRP). These bacterial communities will be characterized by metatranscriptomic approaches in order to characterize the specific genes induced according the crucial adaptative steps to pollutant and redox conditions.&lt;/p&gt;&lt;p&gt;We perform the analysis at whole community and functional groups levels, an innovative approach that allows understanding the overall assembly and functioning of the bacterial communities. Although the partners have a long experience on determining gene diversity and expression level, the challenge is to combine the information obtained at several organization levels from several bacterial communities. Thus, through the main structuring groups, their relationships and their behavior against oxygen and redox oscillations, we will be able to describe the global functioning of sediments’ bacterial communities. Furthermore the comparisons of the behavior of the different bacterial communities will provide valuable information to understand the structuring of microbial communities exposed to petroleum under oxygen and redox oscillations.</Description>
            <ExternalLink label="Project presentation">
                <URL>http://iprem-eem.univ-pau.fr/live/DECAPAGE</URL>
            </ExternalLink>
            <Grant GrantId="ANR-11-CESA-0006">
                <Title>Décapage</Title>
                <Agency abbr="ANR">Agence nationale de la recherche</Agency>
            </Grant>
            <Relevance>
                <Environmental>yes</Environmental>
            </Relevance>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eWhole" material="eTranscriptome" sample_scope="eEnvironment">
                    <Organism species="412755" taxID="412755">
                        <OrganismName>marine sediment metagenome</OrganismName>
                        <Supergroup>eOther</Supergroup>
                        <BiologicalProperties>
                            <Environment>
                                <OptimumTemperature>C</OptimumTemperature>
                                <Habitat>eMultiple</Habitat>
                            </Environment>
                        </BiologicalProperties>
                        <Organization>eUnicellular</Organization>
                    </Organism>
                    <Description>RNA sequencing of microbial communities in petroleum polluted sediment</Description>
                </Target>
                <Method method_type="eSequencing"/>
                <Objectives>
                    <Data data_type="eOther"/>
                </Objectives>
                <IntendedDataTypeSet>
                    <DataType>transcriptome</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>transcriptome</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
