<DocumentSummary uid="1426923">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJNA1426923" archive="NCBI" id="1426923"/>
            <LocalID>bp0</LocalID>
            <LocalID>bp0</LocalID>
        </ProjectID>
        <ProjectDescr>
            <Title>Shotgun metagenomic sequencing of anoxic and reoxygenated marine sediments from Paddehavet (Norway)</Title>
            <Description>Artificial oxygenation can be used to restore oxygen-depleted coastal basins, yet key microbial responses and oxygen-consumption pathways remain poorly understood. The aim of this study was to investigate the initial consumption of oxygen and sulfides in Paddehavet during a reoxygenation experiment. Shotgun metagenomic sequencing was performed both on samples from a laboratory based oxygenation experiment, on samples from Paddehavet prior to oxygenation and after 4 months of oxygenation. Paddehavet is located in the Oslofjord (Norway). The project was carried out in collaboration with The Norwegian Institute for Water Research (NIVA) and funded by Hafslund.</Description>
            <Relevance>
                <Environmental>yes</Environmental>
            </Relevance>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eWhole" material="eGenome" sample_scope="eMultispecies"/>
                <Method method_type="eSequencing"/>
                <Objectives>
                    <Data data_type="eRawSequenceReads"/>
                </Objectives>
                <IntendedDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
