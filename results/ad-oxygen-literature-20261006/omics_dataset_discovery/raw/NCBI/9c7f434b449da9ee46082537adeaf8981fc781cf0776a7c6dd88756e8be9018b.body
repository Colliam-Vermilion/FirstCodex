<?xml version="1.0" ?>
<RecordSet><DocumentSummary uid="551662">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJNA551662" archive="NCBI" id="551662"/>
            <LocalID>bp0</LocalID>
            <LocalID>bp0</LocalID>
        </ProjectID>
        <ProjectDescr>
            <Title>The role of oxygen in stimulating methane production in wetlands</Title>
            <Description>Emissions of the potent greenhouse gas methane by wetland peats are a key uncertainty in the modern methane budget. Recent observations indicating wetland regions exposed to oxygen (O2) are large CH4 sources pose a paradox as methanogenesis is an anaerobic process. Here, we use incubations of Sphagnum peat to directly demonstrate that peat exposed to O2 dramatically increases its CH4 yields (~20-2000 fold) during subsequent anoxic incubation compared to peat remaining anoxic. O2 initiates efficient degradation of peat polyphenolic constituents by microbial aromatic oxygenases, which enhances peat carbon lability during later anaerobic microbial processing, yielding additional methanogenic precursors that stimulate methane production. The results indicate a critical role for spatiotemporal oxic-anoxic transitions in modulating wetland CH4 production, with implications for carbon-climate feedbacks and wetland management.</Description>
            <Grant GrantId="CMI-Methane">
                <Title>Carbon Mitigation Initiative</Title>
                <Agency abbr="CMI">Carbon Mitigation Initiative</Agency>
            </Grant>
            <Relevance>
                <Environmental>yes</Environmental>
            </Relevance>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eWhole" material="eGenome" sample_scope="eMultispecies"/>
                <Method method_type="eSequencing"/>
                <Objectives>
                    <Data data_type="eRawSequenceReads"/>
                </Objectives>
                <IntendedDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
