uster="public" filename="SRR13197585" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13197585/SRR13197585" size="24635383" date="2020-12-04 09:56:47" md5="5b25e65569795abf197d617d689fc490" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR13197585/SRR13197585" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR13197585.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13197/SRR13197585/SRR13197585.lite.1" size="11936171" date="2022-08-09 22:32:09" md5="fab1d4415af380aa7e1d5b5530ec7820" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1301/SRR013/13197/SRR13197585/SRR13197585.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-1/SRR13197585/SRR13197585.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-105/SRR13197585/SRR13197585.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="96367"><Read index="0" count="96367" average="248.84" stdev="4.69"/><Read index="1" count="96367" average="248.84" stdev="4.61"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="96367"/><Elements count="47960263"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="47960263"><Base value="A" count="10521035"/><Base value="C" count="12949599"/><Base value="G" c