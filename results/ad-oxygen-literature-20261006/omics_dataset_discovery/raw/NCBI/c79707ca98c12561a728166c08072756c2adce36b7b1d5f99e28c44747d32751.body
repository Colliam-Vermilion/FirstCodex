AFile cluster="public" filename="TS16_day16_R2" size="47458658" date="2026-01-19 08:50:49" md5="ffa4d030c08ca27841bf7236101c8525" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-18/SRR36885033/TS16_day16_R2.1" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR36885033" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR36885033/SRR36885033" size="13203735" date="2026-01-19 08:50:58" md5="1a5dc1969ec2dbccb1d9f88e625e01c1" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR36885033/SRR36885033" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR36885033.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1214/SRR036/36885/SRR36885033/SRR36885033.lite.1" size="10374675" date="2026-01-19 10:00:46" md5="7702d7301bc4db90c595d29bd487d60b" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1214/SRR036/36885/SRR36885033/SRR36885033.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-2/SRR36885033/SRR36885033.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-108/SRR36885033/SRR36885033.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="93348"><Read index="0" count="93348" average="219.99" stdev="1.08"/><Read index="1" count="93348" average="219.97" stdev="2.06"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="93348"/><Elements count="41069258"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="41069258"><Base value="A" count="9191300"/><Base value="C" count="11515333"/><Base value="G" count="10738452"/><Base value="T" count="9624122"/><Base value="N" count="51"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX31856756" alias="TS16_day3_lib"><IDENTIFIERS><PRIMARY_ID>SRX31856756</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA sequencing of anaerobic digestion metagenome: micro-aerated food waste anaerobic digestion under different total solids contents</TITLE><STUDY_REF accession="SRP664476"><IDENTIFIERS><PRIMARY_ID>SRP664476</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>16S rRNA gene V3V4 region</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS27813646"><IDENTIFIERS><PRIMARY_ID>SRS27813646</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>TS16_day3_lib</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="College of environmental science and engineering" center_name="Beijing University of Technology" accession="SRA2317834" alias="SUB15941032"><IDENTIFIERS><PRIMARY_ID>SRA2317834</PRIMARY_ID><SUBMITTER_ID namespace="Beijing University of Technology">SUB15941032</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Beijing University of Technology</Name><Address postal_code="100124"><Department>College of environmental science and engineering</Department><Institution>Beijing University of Technology</Institution><Street>No. 100 Pingleyuan, Chaoyang District</Street><City>Beijing</City><Country>China</Country></Address><Contact email="nilxyne@gmail.com" sec_email="2351572268@qq.com"><Address postal_code="100124"><Department>College of environmental science and engineering</Department><Institution>Beijing University of Technology</Institution><Street>No. 100 Pingleyuan, Chaoyang District</Street><City>Beijing</City><Country>China</Country></Address><Name><First>Xinyu</First><Last>Lv</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1405076" accession="SRP664476"><IDENTIFIERS><PRIMARY_ID>SRP664476</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1405076</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Modulation of methanogenic pathways by total solids in micro-aerated anaerobic digestion of food waste: Performance and microbial community dynamics</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This project focuses on the micro-aerated anaerobic digestion (AD) of food waste, investigating how total solids (TS) contents (7%, 10%, 13%, 16%) modulate methane production, microbial community dynamics, and methanogenic pathways. Sequencing batch AD reactors were operated with a staged micro-aeration strategy, and process performance was evaluated via methane yield monitoring, intermediate metabolite analysis, and kinetic modeling. High-throughput sequencing of bacterial and archaeal 16S rRNA genes was conducted to characterize microbial community structure, while PICRUSt2 was used to predict functional metabolic pathways related to acidogenesis, acetogenesis, methanogenesis, and oxidative stress response. Results reveal that moderate TS (10%) enhances microbial synergy and acetoclastic methanogenesis (dominated by Methanosaeta) for optimal methane yield and system stability, whereas high TS (13%, 16%) leads to accumulation of inhibitory intermediates (volatile fatty acids, ammonium nitrogen) and a metabolic shift toward methylotrophic methanogenesis. This study provides insights for optimizing TS content to improve the performance of food waste micro-aerated AD systems, supporting sustainable waste management and renewable energy recovery.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="TS16_day3" accession="SRS27813646"><IDENTIFIERS><PRIMARY_ID>SRS27813646</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN54734159</EXTERNAL_ID><SUBMITTER_ID namespace="pda|nilxyne@gmail.com" label="Sample name">TS16_day3</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1405076</ID><LABEL>PRJNA1405076</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-07-13</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>anaerobic digester sludge [ENVO:00003965]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China: Beijing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>40.0080 N 116.3050 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>alkalinity</TAG><VALUE>2.22 ± 0.66</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>temp</TAG><VALUE>35 ± 1 °C</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.wastewater</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS27813646" sample_name="TS16_day3" spots="84193" bases="37038520" tax_id="256318" organism="metagenome"><IDENTIFIERS><PRIMARY_ID>SRS27813646</PRIMARY_ID><EXTE