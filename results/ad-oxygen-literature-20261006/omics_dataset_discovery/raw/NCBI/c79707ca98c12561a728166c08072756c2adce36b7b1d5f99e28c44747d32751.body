jing University of Technology" accession="SRA2317834" alias="SUB15941032"><IDENTIFIERS><PRIMARY_ID>SRA2317834</PRIMARY_ID><SUBMITTER_ID namespace="Beijing University of Technology">SUB15941032</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Beijing University of Technology</Name><Address postal_code="100124"><Department>College of environmental science and engineering</Department><Institution>Beijing University of Technology</Institution><Street>No. 100 Pingleyuan, Chaoyang District</Street><City>Beijing</City><Country>China</Country></Address><Contact email="nilxyne@gmail.com" sec_email="2351572268@qq.com"><Address postal_code="100124"><Department>College of environmental science and engineering</Department><Institution>Beijing University of Technology</Institution><Street>No. 100 Pingleyuan, Chaoyang District</Street><City>Beijing</City><Country>China</Country></Address><Name><First>Xinyu</First><Last>Lv</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1405076" accession="SRP664476"><IDENTIFIERS><PRIMARY_ID>SRP664476</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1405076</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Modulation of methanogenic pathways by total solids in micro-aerated anaerobic digestion of food waste: Performance and microbial community dynamics</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This project focuses on the micro-aerated anaerobic digestion (AD) of food waste, investigating how total solids (TS) contents (7%, 10%, 13%, 16%) modulate methane production, microbial community dynamics, and methanogenic pathways. Sequencing batch AD reactors were operated with a staged micro-aeration strategy, and process performance was evaluated via methane yield monitoring, intermediate metabolite analysis, and kinetic modeling. High-throughput sequencing of bacterial and archaeal 16S rRNA genes was conducted to characterize microbial community structure, while PICRUSt2 was used to predict functional metabolic pathways related to acidogenesis, acetogenesis, methanogenesis, and oxidative stress response. Results reveal that moderate TS (10%) enhances microbial synergy and acetoclastic methanogenesis (dominated by Methanosaeta) for optimal methane yield and system stability, whereas high TS (13%, 16%) leads to accumulation of inhibitory intermediates (volatile fatty acids, ammonium nitrogen) and a metabolic shift toward methylotrophic methanogenesis. This study provides insights for optimizing TS content to improve the performance of food waste micro-aerated AD systems, supporting sustainable waste management and renewable energy recovery.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="TS13_day3" accession="SRS27813641"><IDENTIFIERS><PRIMARY_ID>SRS27813641</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN54734154</EXTERNAL_ID><SUBMITTER_ID namespace="pda|nilxyne@gmail.com" label="Sample name">TS13_day3</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1405076</ID><LABEL>PRJNA1405076</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-07-13</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>anaerobic digester sludge [ENVO:00003965]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China: Beijing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>40.0080 N 116.3050 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>alkalinity</TAG><VALUE>2.24 ± 0.72</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>temp</TAG><V