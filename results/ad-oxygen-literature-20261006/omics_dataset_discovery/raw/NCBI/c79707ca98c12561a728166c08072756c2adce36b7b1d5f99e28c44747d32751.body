nagement and renewable energy recovery.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="TS13_day0" accession="SRS27813640"><IDENTIFIERS><PRIMARY_ID>SRS27813640</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN54734153</EXTERNAL_ID><SUBMITTER_ID namespace="pda|nilxyne@gmail.com" label="Sample name">TS13_day0</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1405076</ID><LABEL>PRJNA1405076</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2022-07-10</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>anaerobic bioreactor [ENVO:00002124]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>anaerobic digester sludge [ENVO:00003965]</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China: Beijing</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>40.0080 N 116.3050 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>alkalinity</TAG><VALUE>10.91 ± 0.25</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMARKS.survey</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.wastewater</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS27813640" sample_name="TS13_day0" spots="84041" bases="36976377" tax_id="256318" organism="metagenome"><IDENTIFIERS><PRIMARY_ID>SRS27813640</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN54734153</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="36976377" spots="84041" bytes="11855800"><RUN accession="SRR36885040" alias="TS13_day0_R1.gz" total_spots="84041" total_bases="36976377" size="11855800" load_done="true