<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX3303106" alias="JGI-SRA-45643"><IDENTIFIERS><PRIMARY_ID>SRX3303106</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45643</EXTERNAL_ID></IDENTIFIERS><TITLE>Metatranscriptome from peat soil microcosm, amended with propionate, incubated for 36 days (replicate 3) [RNA sample 264]</TITLE><STUDY_REF accession="SRP131522"><IDENTIFIERS><PRIMARY_ID>SRP131522</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA412438</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS2871849"><IDENTIFIERS><PRIMARY_ID>SRS2871849</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384375</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>AAUCG</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>other</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>Low Input (RNA)</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="" center_name="JGI" accession="SRA618963" alias="SUB3120775"><IDENTIFIERS><PRIMARY_ID>SRA618963</PRIMARY_ID><SUBMITTER_ID namespace="JGI">SUB3120775</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" org_id="37" url="http://jgi.doe.gov/"><Name abbr="JGI">DOE Joint Genome Institute</Name><Address postal_code="94720"><Department>Genomics</Department><Institution>DOE Joint Genome Institute</Institution><Street>1 Cyclotron Road, Building 91</Street><City>Berkeley</City><Sub>CA</Sub><Country>USA</Country></Address><Contact email="jgi-genbank@lists.jgi-psf.org"><Name><First>JGI</First><Last>genbank</Last></Name></Contact><Contact email="jgi-biosample@quagmire.jgi-psf.org"><Name><First>JGI</First><Last>biosample</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA412438" accession="SRP131522"><IDENTIFIERS><PRIMARY_ID>SRP131522</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA412438</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Schlöppnerbrunnen omics: single-substrates peat soil microcosm incubation experiment metatranscriptomes</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>The Schlöppnerbrunnen fens are a long studied model system for peatland/wetland research. This BioProject includes metatranscriptomic data from a peat soil microcosm incubation experiment with different substrates and with or without sulphate.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>peat metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>29476143</ID></XREF_LINK></STUDY_LINK><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>30755506</ID></XREF_LINK></STUDY_LINK><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>29098760</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA412159</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="Sb_2010_peat_soil_microcosm_24_P-S_36d" accession="SRS2871849"><IDENTIFIERS><PRIMARY_ID>SRS2871849</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384375</EXTERNAL_ID><SUBMITTER_ID namespace="pda|belahausmann" label="Sample name">Sb_2010_peat_soil_microcosm_24_P-S_36d</SUBMITTER_ID></IDENTIFIERS><TITLE>Peat soil microcosm, amended with propionate, incubated for 36 days (replicate 3)</TITLE><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2010-09-21</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0.1-0.2 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>713 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_biome</TAG><VALUE>fen</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_feature</TAG><VALUE>long-term experimental site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_material</TAG><VALUE>peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Schloeppnerbrunnen fen II, Fichtel Mountains, northeastern Bavaria</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>50.131881 N 11.881046 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ph</TAG><VALUE>4.1-5.0</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ref_biomaterial</TAG><VALUE>27015005</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>anaerobe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_mat_process</TAG><VALUE>Excerpt from PMID 27015005: Peat soil microcosms were set up by mixing 30 g of fresh soil (10-20 cm depth) with 60 ml of filter-sterilized (0.2 μm) and anoxic peat water in 250 ml sterile glass bottles. Microcosms were sealed under 100 % N₂ with butyl rubber septa and incubated for 53 days in the dark at 14 °C. Microcosms were periodically amended from the first day of incubation with formate, acetate, propionate, lactate, or butyrate, or incubated without any external substrate. Half of the substrate-amended and -unamended microcosms additionally received periodic amendments of sulfate. These microcosms were initially spiked with sulfate, and, thereafter, were periodically amended with small amounts of sulfate. Triplicate microcosms were set up per incubation condition (36 microcosms in total).</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_size</TAG><VALUE>30 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_vol_we_dna_ext</TAG><VALUE>0.3 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Sb_2010.microcosm_24.day_36</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>water_content_soil</TAG><VALUE>0.78 g/g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sulfate_stimulated</TAG><VALUE>no</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>amended_substrate</TAG><VALUE>propionate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>incubation_time_days</TAG><VALUE>36</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm_id</TAG><VALUE>24</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>replicate</TAG><VALUE>3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS2871849" sample_name="Sb_2010_peat_soil_microcosm_24_P-S_36d" sample_title="Peat soil microcosm, amended with propionate, incubated for 36 days (replicate 3)" spots="22542978" bases="6762893400" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871849</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384375</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="6762893400" spots="22542978" bytes="2821578616"><RUN accession="SRR6193152" alias="JGI-SRA-45643" total_spots="22542978" total_bases="6762893400" size="2821578616" load_done="true" published="2017-10-20 10:48:12" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR6193152</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45643</EXTERNAL_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX3303106"><IDENTIFIERS><EXTERNAL_ID namespace="JGI">JGI-SRA-45643</EXTERNAL_ID></IDENTIFIERS></EXPERIMENT_REF><RUN_ATTRIBUTES><RUN_ATTRIBUTE><TAG>loader</TAG><VALUE>latf-load</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>run_id</TAG><VALUE>8650</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>nominal_length</TAG><VALUE>270</VALUE></RUN_ATTRIBUTE></RUN_ATTRIBUTES><Pool><Member member_name="" accession="SRS2871849" sample_name="Sb_2010_peat_soil_microcosm_24_P-S_36d" sample_title="Peat soil microcosm, amended with propionate, incubated for 36 days (replicate 3)" spots="22542978" bases="6762893400" tax_id="1799672" organism=