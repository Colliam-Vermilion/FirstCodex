re a long studied model system for peatland/wetland research. This BioProject includes metatranscriptomic data from a peat soil microcosm incubation experiment with different substrates and with or without sulphate.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>peat metagenome</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>29476143</ID></XREF_LINK></STUDY_LINK><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>30755506</ID></XREF_LINK></STUDY_LINK><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>29098760</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA412159</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="Sb_2010_peat_soil_microcosm_13_L+S_36d" accession="SRS2871845"><IDENTIFIERS><PRIMARY_ID>SRS2871845</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384380</EXTERNAL_ID><SUBMITTER_ID namespace="pda|belahausmann" label="Sample name">Sb_2010_peat_soil_microcosm_13_L+S_36d</SUBMITTER_ID></IDENTIFIERS><TITLE>Sulfate-stimulated peat soil microcosm, amended with lactate, incubated for 36 days (replicate 1)</TITLE><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2010-09-21</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>0.1-0.2 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>713 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_biome</TAG><VALUE>fen</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_feature</TAG><VALUE>long-term experimental site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_material</TAG><VALUE>peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Schloeppnerbrunnen fen II, Fichtel Mountains, northeastern Bavaria</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>50.131881 N 11.881046 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ph</TAG><VALUE>4.1-5.0</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ref_biomaterial</TAG><VALUE>27015005</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>anaerobe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_mat_process</TAG><VALUE>Excerpt from PMID 27015005: Peat soil microcosms were set up by mixing 30 g of fresh soil (10-20 cm depth) with 60 ml of filter-sterilized (0.2 μm) and anoxic peat water in 250 ml sterile glass bottles. Microcosms were sealed under 100 % N₂ with butyl rubber septa and incubated for 53 days in the dark at 14 °C. Microcosms were periodically amended from the first day of incubation with formate, acetate, propionate, lactate, or butyrate, or incubated without any external substrate. Half of the substrate-amended and -unamended microcosms additionally received periodic amendments of sulfate. These microcosms were initially spiked with sulfate, and, thereafter, were periodically amended with small amounts of sulfate. Triplicate microcosms were set up per incubation condition (36 microcosms in total).</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_size</TAG><VALUE>30 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_vol_we_dna_ext</TAG><VALUE>0.3 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Sb_2010.microcosm_13.day_36</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>water_content_soil</TAG><VALUE>0.78 g/g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sulfate_stimulated</TAG><VALUE>yes</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>amended_substrate</TAG><VALUE>lactate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>incubation_time_days</TAG><VALUE>36</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm_id</TAG><VALUE>13</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>replicate</TAG><VALUE>1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS2871845" sample_name="Sb_2010_peat_soil_microcosm_13_L+S_36d" sample_title="Sulfate-stimulated peat soil microcosm, amended with lactate, incubated for 36 days (replicate 1)" spots="24327596" bases="7298278800" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871845</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384380</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="7298278800" spots="24327596" bytes="2980778574"><RUN accession="SRR5252710" alias="JGI-SRA-45457" total_spots="24327596" total_bases="7298278800" size="2980778574" load_done="true" published="2017-02-14 06:15:20" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR5252710</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45457</EXTERNAL_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX2558337"><IDENTIFIERS><EXTERNAL_ID namespace="JGI">JGI-SRA-45457</EXTERNAL_ID></IDENTIFIERS></EXPERIMENT_REF><RUN_ATTRIBUTES><RUN_ATTRIBUTE><TAG>loader</TAG><VALUE>latf-load</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>run_id</TAG><VALUE>8650</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>nominal_length</TAG><VALUE>270</VALUE></RUN_ATTRIBUTE></RUN_ATTRIBUTES><Pool><Member member_name="" accession="SRS2871845" sample_name="Sb_2010_peat_soil_microcosm_13_L+S_36d" sample_title="Sulfate-stimulated peat soil microcosm, amended with lactate, incubated for 36 days (replicate 1)" spots="24327596" bases="7298278800" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871845</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384380</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="8650.3.107825.ACTGAT.fastq.gz" size="4022026577" date="2020-03-31 23:07:10" md5="259cbf10dbffd1749d4bcdb999e7488b" version="1" semantic_name="fastq" sup