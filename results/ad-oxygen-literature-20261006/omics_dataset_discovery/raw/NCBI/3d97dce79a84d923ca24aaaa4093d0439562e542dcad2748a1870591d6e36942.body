TAG>elev</TAG><VALUE>713 m</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_biome</TAG><VALUE>fen</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_feature</TAG><VALUE>long-term experimental site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_material</TAG><VALUE>peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Germany: Schloeppnerbrunnen fen II, Fichtel Mountains, northeastern Bavaria</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>50.131881 N 11.881046 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ph</TAG><VALUE>4.1-5.0</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>ref_biomaterial</TAG><VALUE>27015005</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>rel_to_oxygen</TAG><VALUE>anaerobe</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_mat_process</TAG><VALUE>Excerpt from PMID 27015005: Peat soil microcosms were set up by mixing 30 g of fresh soil (10-20 cm depth) with 60 ml of filter-sterilized (0.2 μm) and anoxic peat water in 250 ml sterile glass bottles. Microcosms were sealed under 100 % N₂ with butyl rubber septa and incubated for 53 days in the dark at 14 °C. Microcosms were periodically amended from the first day of incubation with formate, acetate, propionate, lactate, or butyrate, or incubated without any external substrate. Half of the substrate-amended and -unamended microcosms additionally received periodic amendments of sulfate. These microcosms were initially spiked with sulfate, and, thereafter, were periodically amended with small amounts of sulfate. Triplicate microcosms were set up per incubation condition (36 microcosms in total).</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_size</TAG><VALUE>30 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_vol_we_dna_ext</TAG><VALUE>0.3 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Sb_2010.microcosm_16.day_08</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>water_content_soil</TAG><VALUE>0.78 g/g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sulfate_stimulated</TAG><VALUE>no</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>amended_substrate</TAG><VALUE>lactate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>incubation_time_days</TAG><VALUE>8</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm_id</TAG><VALUE>16</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>replicate</TAG><VALUE>1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS2871834" sample_name="Sb_2010_peat_soil_microcosm_16_L-S_08d" sample_title="Peat soil microcosm, amended with lactate, incubated for 8 days (replicate 1)" spots="36448836" bases="10934650800" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871834</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384393</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="10934650800" spots="36448836" bytes="4342141411"><RUN accession="SRR5252712" alias="JGI-SRA-45463" total_spots="36448836" total_bases="10934650800" size="4342141411" load_done="true" published="2017-02-14 06:17:18" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR5252712</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45463</EXTERNAL_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX2558339"><IDENTIFIERS><EXTERNAL_ID namespace="JGI">JGI-SRA-45463</EXTERNAL_ID></IDENTIFIERS></EXPERIMENT_REF><RUN_ATTRIBUTES><RUN_ATTRIBUTE><TAG>loader</TAG><VALUE>latf-load</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>run_id</TAG><VALUE>8673</VALUE></RUN_ATTRIBUTE><RUN_ATTRIBUTE><TAG>nominal_length</TAG><VALUE>270</VALUE></RUN_ATTRIBUTE></RUN_ATTRIBUTES><Pool><Member member_name="" accession="SRS2871834" sample_name="Sb_2010_peat_soil_microcosm_16