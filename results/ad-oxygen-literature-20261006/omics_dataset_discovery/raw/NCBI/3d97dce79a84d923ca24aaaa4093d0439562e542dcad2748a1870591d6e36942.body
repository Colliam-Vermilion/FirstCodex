BI"/><Alternatives url="s3://sra-pub-zq-1/SRR5252779/SRR5252779.sralite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-104/SRR5252779/SRR5252779.zq.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="13733122"><Read index="0" count="13733122" average="150" stdev="0"/><Read index="1" count="13733122" average="150" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="13733122"/><Elements count="4119936600"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="4119936600"><Base value="A" count="934978534"/><Base value="C" count="1125349685"/><Base value="G" count="1148979632"/><Base value="T" count="907498258"/><Base value="N" count="3130491"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX2558383" alias="JGI-SRA-45488"><IDENTIFIERS><PRIMARY_ID>SRX2558383</PRIMARY_ID><EXTERNAL_ID namespace="JGI">JGI-SRA-45488</EXTERNAL_ID></IDENTIFIERS><TITLE>Metatranscriptome from peat soil microcosm, amended with formate, incubated for 36 days (replicate 1) [RNA sample 224]</TITLE><STUDY_REF accession="SRP131522"><IDENTIFIERS><PRIMARY_ID>SRP131522</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA412438</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS2871688"><IDENTIFIERS><PRIMARY_ID>SRS2871688</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384305</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>AATYW</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRAR