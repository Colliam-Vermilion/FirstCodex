iles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="126085"><Read index="0" count="126085" average="253" stdev="0"/><Read index="1" count="126085" average="253" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="126085"/><Elements count="63799010"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="63799010"><Base value="A" count="14319634"/><Base value="C" count="17552750"/><Base value="G" count="16698016"/><Base value="T" count="15228610"/><Base value="N" count="0"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX24796422" alias="2201MN3E_16S"><IDENTIFIERS><PRIMARY_ID>SRX24796422</PRIMARY_ID></IDENTIFIERS><TITLE>16S rRNA amplicon sequencing of iron microbial mats from the Savannah River Site wetland</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>DNA was extracted from iron microbial mat that was fresh (never frozen) within hours of sampling. 16S rRNA gene libraries were prepared using the Illumina 16S Sample Preparation Guide. Amplicons were prepared using the lllumina 16S b341F and lllumina 16S 805R primers, with all preparations done at  volume. Libraries were prepared with 12.5 ng input DNA and 30 PCR cycles. Libraries were sequenced on an Illumina MiSeq using a Nano 500 cycle sequencing kit.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21510023"><IDENTIFIERS><PRIMARY_ID>SRS21510023</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570321</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR>