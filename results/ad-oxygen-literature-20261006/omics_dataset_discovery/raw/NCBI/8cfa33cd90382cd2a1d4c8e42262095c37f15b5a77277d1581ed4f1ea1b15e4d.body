S3381460</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA isolation was carried out using the Sigma Spectrum Plant Total RNA kit. TruSeq Stranded Total RNA with Ribo‐Zero Plant Sample Prep Kits were used to generate the libraries, according to manufacturer's instructions (Illumina). rRNAs removed, random fragmentation, stranded library</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176808</ID><LABEL>GSM3176808</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176808</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115371" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715445"><IDENTIFIERS><PRIMARY_ID>SRA715445</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115371</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115371" accession="SRP149823"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474721</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115371</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (RNA-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNAseq profiling of seeds and 7 time points during germination in rice under aerobic and anerobic conditions, as well as following re-oxygenation. Overall design: Total RNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 1 h, 3 h, 12 h, 24 h, 2 days, 3 days and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115371</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176808" accession="SRS3381460"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAME>Oryza sativa</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>474721</ID><LABEL>PRJNA474721</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>seeds following 3 d of anaerobic germination and 1 d under aerobic conditions (3dN1dA) Replicate 3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>De-hulled sterilised seeds were grown in MES culture medium bubbled with nitrogen gas (anaerobic-N) at 30 C in the dark for 3 d, the gas was then switched to air for 1 d (3dN1dA).</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381460" sample_name="GSM3176808" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3" spots="25667195" bases="2464050720" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="2464050720" spots="25667195" bytes="981998192"><RUN alias="GSM3176808_r1" accession="SRR7265420" total_spots="25667195" total_bases="2464050720" size="981998192" load_done="true" published="2018-06-12 16:06:13" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265420</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176808_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169515" refname="GSM3176808"/><Pool><Member member_name="" accession="SRS3381460" sample_name="GSM3176808" sample_title="seeds following 3 d of anaerobic germination, followed by 1 d under aerobic conditions (3dN1dA) Replicate 3" spots="25667195" bases="2464050720" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381460</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371461</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176808</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="3N1A_48_RNA_GTGAAA_L004_R1_001.fastq.gz" size="1727111704" date="2020-02-25 05:52:29" md5="c856e29235e80a7399a869860d87fd81" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-5/SRR7265420/3N1A_48_RNA_GTGAAA_L004_R1_001.fastq.gz" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR7265420" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR7265420/SRR7265420" size="981999419" date="2018-06-05 16:00:27" md5="d5ec36ab295450cf199130a3c723aac0" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR7265420/SRR7265420" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR7265420.sralite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/SRR007/265/SRR7265420.sralite.1" size="617202991" date="2020-06-21 09:06:00" md5="243f829fb33726b21b374b5418d7d49b" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-922/SRR007/265/SRR7265420.sralite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-8/SRR7265420/SRR7265420.sralite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-103/SRR7265420/SRR7265420.zq.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="25667195"><Read index="0" count="25667195" average="96" stdev="0"/><Read index="1" count="0" average="0" stdev="0"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="25667195"/><Elements count="2464050720"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="2464050720"><Base value="A" count="689961656"/><Base value="C" count="590677225"/><Base value="G" count="529628977"/><Base value="T" count="653674204"/><Base value="N" count="108658"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3176809" accession="SRX4169516"><IDENTIFIERS><PRIMARY_ID>SRX4169516</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3176809: dry seed 0 h Methyl-Seq Replicate 1; Oryza sativa; Bisulfite-Seq</TITLE><STUDY_REF accession="SRP149824" refname="GSE115372"><IDENTIFIERS><PRIMARY_ID>SRP149824</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3381461"><IDENTIFIERS><PRIMARY_ID>SRS3381461</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176809</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>Bisulfite-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>GENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>gDNA was extracted from the seeds/seedlings using the Qiagen DNeasy Plant minikit and 600ng of purified gDNA was used for MethylC-seq library preparation after spiking in 0.5% lambda DNA (N6-methyladenine-free) (New England BioLabs). MethylC-seq library preparation was carried out as described previously (Urich et al., 2015 - http://www.nature.com/nprot/journal/v10/n3/full/nprot.2014.114.html).</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176809</ID><LABEL>GSM3176809</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176809</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115372" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715446"><IDENTIFIERS><PRIMARY_ID>SRA715446</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115372</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115372" accession="SRP149824"><IDENTIFIERS><PRIMARY_ID>SRP149824</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474723</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115372</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (Methyl-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>methylC-seq profiling of seeds, at 0 h and 24 h after imbibition and following 4-d of growth under aerobic and anerobic conditions, as well as following re-oxygenation (3dN1dA) in rice. Overall design: gDNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 24 h and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115372</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176809" accession="SRS3381461"><IDENTIFIERS><PRIMARY_ID>SRS3381461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371452</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176809</EXTERNAL_ID></IDENTIFIERS><TITLE>dry seed 0 h Methyl-Seq Replicate 1</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAME>Oryza sativa</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>474723</ID><LABEL>PRJNA474723</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice embryos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>embryos</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>dry seed 0 h Replicate 1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>Oryza sativa seeds were de-hulled and embryos were immediately extracted and snap frozen.</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381461" sample_name="GSM3176809" sample_title="dry seed 0 h Methyl-Seq Replicate 1" spots="103415153" bases="20889860906" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371452</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176809</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="20889860906" spots="103415153" bytes="9743094223"><RUN alias="GSM3176809_r1" accession="SRR7265421" total_spots="103415153" total_bases="20889860906" size="9743094223" load_done="true" published="2018-06-12 16:06:14" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265421</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176809_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169516" refname="GSM3176809"/><Pool><Member member_name="" accession="SRS3381461" sample_name="GSM3176809" sample_title="dry seed 0 h Methyl-Seq Replicate 1" spots="103415153" bases="20889860906" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371452</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176809</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="Sample_0h_1_mC.fastq" size="54498370924" date="2020-02-25 03:48:53" md5="08dda38782edb5be46c03730b848a226" version="1" semantic_name="fastq" supertype="O