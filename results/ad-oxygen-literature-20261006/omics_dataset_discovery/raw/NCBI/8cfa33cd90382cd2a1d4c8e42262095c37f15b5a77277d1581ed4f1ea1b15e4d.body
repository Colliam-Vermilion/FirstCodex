<EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM3176789" accession="SRX4169496"><IDENTIFIERS><PRIMARY_ID>SRX4169496</PRIMARY_ID></IDENTIFIERS><TITLE>GSM3176789: seeds following 2 d of aerobic germination (2dA) Replicate 2; Oryza sativa; RNA-Seq</TITLE><STUDY_REF accession="SRP149823" refname="GSE115371"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS3381441"><IDENTIFIERS><PRIMARY_ID>SRS3381441</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM3176789</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA isolation was carried out using the Sigma Spectrum Plant Total RNA kit. TruSeq Stranded Total RNA with Ribo‐Zero Plant Sample Prep Kits were used to generate the libraries, according to manufacturer's instructions (Illumina). rRNAs removed, random fragmentation, stranded library</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 1500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>303176789</ID><LABEL>GSM3176789</LABEL></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM3176789</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE115371" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA715445"><IDENTIFIERS><PRIMARY_ID>SRA715445</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE115371</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">NCBI</Name><Contact email="geo-group@ncbi.nlm.nih.gov"><Name><First>Geo</First><Last>Curators</Last></Name></Contact></Organization><STUDY center_name="GEO" alias="GSE115371" accession="SRP149823"><IDENTIFIERS><PRIMARY_ID>SRP149823</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA474721</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE115371</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>RNA-seq and DNA methylomes of germinating rice and developing coleoptiles (RNA-Seq)</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>RNAseq profiling of seeds and 7 time points during germination in rice under aerobic and anerobic conditions, as well as following re-oxygenation. Overall design: Total RNA was extracted from samples collected at each time point in triplicate. The time points were: 0 h (dry seed), 1 h, 3 h, 12 h, 24 h, 2 days, 3 days and 4 days under aerobic (A) and anaerobic (N) conditions, as well as 3-day-old seedlings grown under anaerobic conditions that were switched to air for 1 day.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE115371</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>27859855</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS><STUDY_ATTRIBUTES><STUDY_ATTRIBUTE><TAG>parent_bioproject</TAG><VALUE>PRJNA474719</VALUE></STUDY_ATTRIBUTE></STUDY_ATTRIBUTES></STUDY><SAMPLE alias="GSM3176789" accession="SRS3381441"><IDENTIFIERS><PRIMARY_ID>SRS3381441</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371480</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176789</EXTERNAL_ID></IDENTIFIERS><TITLE>seeds following 2 d of aerobic germination (2dA) Replicate 2</TITLE><SAMPLE_NAME><TAXON_ID>4530</TAXON_ID><SCIENTIFIC_NAME>Oryza sativa</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>474721</ID><LABEL>PRJNA474721</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Rice coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>tissue</TAG><VALUE>coleoptile</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype</TAG><VALUE>WT(Oryza sativa cv Amaroo)</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>age</TAG><VALUE>seeds following 2 d of aerobic germination (2dA) Replicate 2</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>treatment/conditions</TAG><VALUE>De-hulled sterilised seeds were grown in MES culture medium bubbled with air (aerobic-A) at 30 C in the dark for 2 d.</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS3381441" sample_name="GSM3176789" sample_title="seeds following 2 d of aerobic germination (2dA) Replicate 2" spots="41696575" bases="4002871200" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381441</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371480</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176789</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="4002871200" spots="41696575" bytes="1798612644"><RUN alias="GSM3176789_r1" accession="SRR7265401" total_spots="41696575" total_bases="4002871200" size="1798612644" load_done="true" published="2018-06-12 16:06:13" is_public="true" cluster_name="public" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR7265401</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM3176789_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX4169496" refname="GSM3176789"/><Pool><Member member_name="" accession="SRS3381441" sample_name="GSM3176789" sample_title="seeds following 2 d of aerobic germination (2dA) Replicate 2" spots="41696575" bases="4002871200" tax_id="4530" organism="Oryza sativa"><IDENTIFIERS><PRIMARY_ID>SRS3381441</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN09371480</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM3176789</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="2dA_29_RNA_TGACCA_L004_R1_001.fastq.gz" url="https://sra-pub-src-1.s3.amazonaws.com/SRR7265401/2dA_29_RNA_TGACCA_L004_R1_001.fastq.gz.1" size="3071200060" date="2020-02-24 21:36:33" md5="