ion of fruit and vegetable waste into functional agricultural products, including soil conditioners, plant growth promoters, and biocontrol agents. This work provides scientific guidance for household users to optimize fermentation timing and application strategies for sustainable agricultural practices and organic waste utilization.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="GS_2" accession="SRS26419470"><IDENTIFIERS><PRIMARY_ID>SRS26419470</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN51184017</EXTERNAL_ID><SUBMITTER_ID namespace="pda|3510863917@qq.com" label="Sample name">GS_2</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1320941</ID><LABEL>PRJNA1320941</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>fermented fruit and vegetable residues</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2024-06-21</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>China: Guizhou Province, Guiyang</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>26.6 N 106.7 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS26419470" sample_name="GS_2" spots="21530672" bases="6502262944" tax_id="256318" organism="metagenome"><IDENTIFIERS><PRIMARY_ID>SRS26419470</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN51184017</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="6502262944" spots="21530672" bytes="1873446072"><RUN accession="SRR35277008" alias="GS_2_R1.raw.fastq.gz" total_spots="21530672" total_bases="6502262944" size="1873446072" load_done="true" pu