<EXPERIMENT_PACKAGE_SET>
<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX30379105" alias="GS_4_LIB1"><IDENTIFIERS><PRIMARY_ID>SRX30379105</PRIMARY_ID></IDENTIFIERS><TITLE>Metagenome of fruit and vegetable residue fermentation at 28 days</TITLE><STUDY_REF accession="SRP617935"><IDENTIFIERS><PRIMARY_ID>SRP617935</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>Metagenomic shotgun sequencing of microbial communities during natural fermentation of fruit and vegetable residues. DNA extracted using CTAB method, libraries prepared with NEBNext Ultra DNA Library Prep Kit, PE150 sequencing targeting 6Gb per sample.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS26419472"><IDENTIFIERS><PRIMARY_ID>SRS26419472</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>GS_4_LIB1</LIBRARY_NAME><LIBRARY_STRATEGY>WGS</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq 6000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Guizhou University" center_name="Guizhou University" accession="SRA2215757" alias="SUB15602869"><IDENTIFIERS><PRIMARY_ID>SRA2215757</PRIMARY_ID><SUBMITTER_ID namespace="Guizhou University">SUB15602869</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Guizhou University</Name><Address postal_code="550025"><Department>Guizhou University</Department><Institution>Guizhou University</Institution><Street>Guizhou University</Street><City>Guiyang</City><Sub>Guizhou</Sub><Country>China</Country></Address><Contact email="3510863917@qq.com" sec_email="gs.pliu23@gzu.edu.cn"><Address postal_code="550025"><Department>Guizhou University</Department><Institution>Guizhou University</Institution><Street>Guizhou University</Street><City>Guiyang</City><Sub>Guizhou</Sub><Country>China</Country></Address><Name><First>Piao</First><Last>Liu</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1320941" accession="SRP617935"><IDENTIFIERS><PRIMARY_ID>SRP617935</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1320941</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomics analysis of microbial community succession during natural fermentation of fruit and vegetable residues for agricultural applications</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>This study investigates the microbial community dynamics and metabolic pathways during a 28-day natural fermentation process of fruit and vegetable residues in household-scale fermentation systems. Using shotgun metagenomic sequencing, we analyzed the temporal succession of microbial communities and their functional genomic characteristics to understand the formation mechanisms of bioactive compounds. The research aims to reveal the phased transformation of fruit and vegetable waste into functional agricultural products, including soil conditioners, plant growth promoters, and biocontrol agents. This work provides scientific guidance for household users to optimize fermentation timing and application strategies for sustainable agricultural practices and organic waste utilization.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="GS_4" accession="SRS26419472"><IDENTIFIERS><PRIMARY_ID>SRS26419472</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN51184019</EXTERNAL_ID><SUBMITTER_ID namespace="pda|3510863917@qq.com" label="Sample name">GS_4</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>256318</TAXON_ID><SCIENTIFIC_NAME>metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1320941</ID><LABEL>PRJNA1320941</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>fermented fruit and vegetable 