MARY_ID>SRA2337980</PRIMARY_ID><SUBMITTER_ID namespace="Norwegian University of Life Sciences">SUB16005227</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Norwegian University of Life Sciences</Name><Address postal_code="1432"><Department>Faculty of Chemistry, Biotechnology and Food Sciences</Department><Institution>Norwegian University of Life Sciences</Institution><Street>Chr. M. Falsens vei 18</Street><City>Aas</City><Country>Norway</Country></Address><Contact email="matildesterling@gmail.com" sec_email="matilde.kolstad.sterling@nmbu.no"><Address postal_code="1432"><Department>Faculty of Chemistry, Biotechnology and Food Sciences</Department><Institution>Norwegian University of Life Sciences</Institution><Street>Chr. M. Falsens vei 18</Street><City>Aas</City><Country>Norway</Country></Address><Name><First>Matilde</First><Last>Sterling</Last><Middle>Kolstad</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1426923" accession="SRP678656"><IDENTIFIERS><PRIMARY_ID>SRP678656</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1426923</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Shotgun metagenomic sequencing of anoxic and reoxygenated marine sediments from Paddehavet (Norway)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Artificial oxygenation can be used to restore oxygen-depleted coastal basins, yet key microbial responses and oxygen-consumption pathways remain poorly understood. The aim of this study was to investigate the initial consumption of oxygen and sulfides in Paddehavet during a reoxygenation experiment. Shotgun metagenomic sequencing was performed both on samples from a laboratory based oxygenation experiment, on samples from Paddehavet prior to oxygenation and after 4 months of oxygenation. Paddehavet is located in the Oslofjord (Norway). The project was carried out in collaboration with The Norwegian Institute for Water Research (NIVA) and funded by Hafslund.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="PD5" accession="SRS28168754"><IDENTIFIERS><PRIMARY_ID>SRS28168754</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN55898897</EXTERNAL_ID><SUBMITTER_ID namespace="pda|matildesterling@gmail.com" label="Sample name">PD5</SUBMITTER_ID></IDENTIFIERS><TITLE>PD5_A</TITLE><SAMPLE_NAME><TAXON_ID>749907</TAXON_ID><SCIENTIFIC_NAME>sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1426923</ID><LABEL>PRJNA1426923</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>marine sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2024-04-11</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Norway: Oslofjorden,Paddehavet</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>59.874293 N 10.766674 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>Van Veen grab</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Sample_no</TAG><VALUE>5</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS28168754" sample_name="PD5" sample_title="PD5_A" spots="64603363" bases="19381008900" tax_id="749907" organism="sediment metagenome"><IDENTIFIERS><PRIMARY_ID>SRS28168754</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN55898897</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="19381008900" spots="64603363" bytes="6530843265"><RUN accession="SRR37325124" alias="Unknown_s84BMK240624-CC576-ZX01-010001-01_1.fq.gz" total_spots="64603363" total_bases="19381008900" size="6530843265" load_done="true" published="2026-09-17 10:08:43" is_public="true" cluster_name="public" ha