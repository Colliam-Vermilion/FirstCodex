<EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX32472796" alias="4A - time 24 hours, day 1"><IDENTIFIERS><PRIMARY_ID>SRX32472796</PRIMARY_ID></IDENTIFIERS><TITLE>Shotgun sequencing of marine sediment samples</TITLE><STUDY_REF accession="SRP678656"><IDENTIFIERS><PRIMARY_ID>SRP678656</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1426923</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>NA</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS28369288"><IDENTIFIERS><PRIMARY_ID>SRS28369288</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>4A - time 24 hours, day 1</LIBRARY_NAME><LIBRARY_STRATEGY>WGS</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq X</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Faculty of Chemistry, Biotechnology and Food Scien" center_name="Norwegian University of Life Sciences" accession="SRA2350725" alias="SUB16034633"><IDENTIFIERS><PRIMARY_ID>SRA2350725</PRIMARY_ID><SUBMITTER_ID namespace="Norwegian University of Life Sciences">SUB16034633</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>Norwegian University of Life Sciences</Name><Address postal_code="1432"><Department>Faculty of Chemistry, Biotechnology and Food Sciences</Department><Institution>Norwegian University of Life Sciences</Institution><Street>Chr. M. Falsens vei 18</Street><City>Aas</City><Country>Norway</Country></Address><Contact email="matildesterling@gmail.com" sec_email="matilde.kolstad.sterling@nmbu.no"><Address postal_code="1432"><Department>Faculty of Chemistry, Biotechnology and Food Sciences</Department><Institution>Norwegian University of Life Sciences</Institution><Street>Chr. M. Falsens vei 18</Street><City>Aas</City><Country>Norway</Country></Address><Name><First>Matilde</First><Last>Sterling</Last><Middle>Kolstad</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1426923" accession="SRP678656"><IDENTIFIERS><PRIMARY_ID>SRP678656</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1426923</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Shotgun metagenomic sequencing of anoxic and reoxygenated marine sediments from Paddehavet (Norway)</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Artificial oxygenation can be used to restore oxygen-depleted coastal basins, yet key microbial responses and oxygen-consumption pathways remain poorly understood. The aim of this study was to investigate the initial consumption of oxygen and sulfides in Paddehavet during a reoxygenation experiment. Shotgun metagenomic sequencing was performed both on samples from a laboratory based oxygenation experiment, on samples from Paddehavet prior to oxygenation and after 4 months of oxygenation. Paddehavet is located in the Oslofjord (Norway). The project was carried out in collaboration with The Norwegian Institute for Water Research (NIVA) and funded by Hafslund.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="4A" accession="SRS28369288"><IDENTIFIERS><PRIMARY_ID>SRS28369288</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN56464314</EXTERNAL_ID><SUBMITTER_ID namespace="pda|matildesterling@gmail.com" label="Sample name">4A</SUBMITTER_ID></IDENTIFIERS><TITLE>4A</TITLE><SAMPLE_NAME><TAXON_ID>749907</TAXON_ID><SCIENTIFIC_NAME>sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><DESCRIPTION>4A - time 24 hours, day 1</DESCRIPTION><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1426923</ID><LABEL>PRJNA1426923</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>marine sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><