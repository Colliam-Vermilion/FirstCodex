xygenation and after 4 months of oxygenation. Paddehavet is located in the Oslofjord (Norway). The project was carried out in collaboration with The Norwegian Institute for Water Research (NIVA) and funded by Hafslund.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="27" accession="SRS28234040"><IDENTIFIERS><PRIMARY_ID>SRS28234040</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN56219669</EXTERNAL_ID><SUBMITTER_ID namespace="pda|matildesterling@gmail.com" label="Sample name">27</SUBMITTER_ID></IDENTIFIERS><TITLE>PD3_B_surf</TITLE><SAMPLE_NAME><TAXON_ID>749907</TAXON_ID><SCIENTIFIC_NAME>sediment metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1426923</ID><LABEL>PRJNA1426923</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>marine sediment</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2024-08-21</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>Norway: Oslofjorden,Paddehavet</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>59.874745 N 10.764723 E</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_collect_device</TAG><VALUE>Van Veen grab</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Sample_no</TAG><VALUE>27</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS28234040" sample_name="27" sample_title="PD3_B_surf" spots="60556829" bases="18167048700" tax_id="749907" organism="sediment metagenome"><IDENTIFIERS><PRIMARY_ID>SRS28234040</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN56219669</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="18167048700" spots="60556829" bytes="6054408707"><RUN accession="SRR37404358" alias