26.86" stdev="4.44"/><Read index="1" count="43616" average="228.01" stdev="3.95"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="43616"/><Elements count="19839544"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="19839544"><Base value="A" count="4465153"/><Base value="C" count="5340256"/><Base value="G" count="5219422"/><Base value="T" count="4813386"/><Base value="N" count="1327"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6380328" alias="metagenome_19"><IDENTIFIERS><PRIMARY_ID>SRX6380328</PRIMARY_ID></IDENTIFIERS><TITLE>metagenome of Sphagnum peat microorganisms: soil incubation</TITLE><STUDY_REF accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The RNeasy PowerSoil DNA Elution Kit (QIAGEN) was used to isolate metagenomic DNA from Sphagnum peat soil. The isolated DNA was then prepared for sequencing on the Illumina HiSeq platform.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5040878"><IDENTIFIERS><PRIMARY_ID>SRS5040878</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>metagenome_19</LIBRARY_NAME><LIBRARY_STRATEGY>WGS</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Princeton Env Inst / Geosciences" center_name="Princeton University" accession="SRA915420" alias="SUB5867921"><IDENTIFIERS><PRIMARY_ID>SRA915420</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB5867921</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="https://scholar.princeton.edu/xinningz/home"><Name>Princeton University</Name><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Contact email="jwilmoth@princeton.edu"><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Name><First>Jared</First><Last>Wilmoth</Last><Middle>Lee</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA551662" accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA551662</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>The role of oxygen in stimulating methane production in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Emissions of the potent greenhouse gas methane by wetland peats are a key uncertainty in the modern methane budget. Recent observations indicating wetland regions exposed to oxygen (O2) are large CH4 sources pose a paradox as methanogenesis is an anaerobic process. Here, we use incubations of Sphagnum peat to directly demonstrate that peat exposed to O2 dramatically increases its CH4 yields (~20-2000 fold) during subsequent anoxic incubation compared to peat remaining anoxic. O2 initiates efficient degradation of peat polyphenolic constituents by microbial aromatic oxygenases, which enhances peat carbon lability during later anaerobic microbial processing, yielding additional methanogenic precursors that stimulate methane production. The results indicate a critical role for spatiotemporal oxic-anoxic transitions in modulating wetland CH4 production, with implications for carbon-climate feedbacks and wetland management.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="10_O2_sample23_T5_BWT_metagenome" accession="SRS5040878"