"worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-5/SRR9617316/SRR9617316.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-102/SRR9617316/SRR9617316.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="6656349"><Read index="0" count="6656349" average="126.04" stdev="34.73"/><Read index="1" count="6656349" average="124.89" stdev="35.16"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="6656349"/><Elements count="1670230282"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="1670230282"><Base value="A" count="334834740"/><Base value="C" count="500227634"/><Base value="G" count="499292641"/><Base value="T" count="331332240"/><Base value="N" count="4543027"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6380336" alias="metagenome_11"><IDENTIFIERS><PRIMARY_ID>SRX6380336</PRIMARY_ID></IDENTIFIERS><TITLE>metagenome of Sphagnum peat microorganisms: soil incubation</TITLE><STUDY_REF accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The RNeasy PowerSoil DNA Elution Kit (QIAGEN) was used to isolate metagenomic DNA from Sphagnum peat soil. The isolated DNA was then prepared for sequencing on the Illumina HiSeq platform.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5040886"><IDENTIFIERS><PRIMARY_ID>SRS5040886</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>metagenome_11</LIBRARY_NAME><LIBRARY_STRATEGY>WGS</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>RANDOM</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2500</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Princeton Env Inst / Geosciences" center_name="Princeton University" accession="SRA915420" alias="SUB5867921"><IDENTIFIERS><PRIMARY_ID>SRA915420</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB5867921</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="https://scholar.princeton.edu/xinningz/home"><Name>Princeton University</Name><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Contact email="jwilmoth@princeton.edu"><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Name><First>Jared</First><Last>Wilmoth</Last><Middle>Lee</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA551662" accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA551662</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>The role of oxygen in stimulating methane production in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Emissions of the potent greenhouse gas methane by wetland peats are a key uncertainty in the modern methane budget. Recent observations indicating wetland regions exposed to oxygen (O2) are large CH4 sources pose a paradox as methanogenesis is an anaerobic process. Here, we use incubations of Sphagnum peat to directly demonstrate that peat exposed to O2 dramatically increases its CH4 yields (~20-2000 fold) during subsequent anoxic incubation compared to peat remaining anoxic. O2 initiates efficient degradation of peat polyphenolic constituents by microbial aromatic oxygenases, which enhances peat carbon lability during later anaerobic microbial processing, yielding additional methanogenic precursors that stimulate methane production. The results indicate a critical role for spatiotemporal oxic-anoxic transitions in modulating wetland CH4 production, with implications for carbon-climate feedbacks and wetland management.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="5_O2_sample21_T5_BWT_metagenome" accession="SRS5040886"><IDENTIFIERS><PRIMARY_ID>SRS5040886</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162605</EXTERNAL_ID><SUBMITTER_ID namespace="pda|zhanglabprinceton2019" label="Sample name">5_O2_sample21_T5_BWT_metagenome</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>551662</ID><LABEL>PRJNA551662</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Sphagnum peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-06-01</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Andover, MA, Ward Reservation</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>42.38 N 71.06 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Time Point</TAG><VALUE>5</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Layer</TAG><VALUE>BWT</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>%O2 Treatment</TAG><VALUE>5</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Sample Key order</TAG><VALUE>11</VALUE></SAMPLE_ATTRIBUTE><SAM