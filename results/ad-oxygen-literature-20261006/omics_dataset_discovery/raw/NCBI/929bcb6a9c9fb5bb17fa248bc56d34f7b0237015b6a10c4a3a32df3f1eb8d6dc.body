" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos9/sra-pub-zq-924/SRR009/9617/SRR9617318/SRR9617318.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-5/SRR9617318/SRR9617318.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-102/SRR9617318/SRR9617318.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="7431382"><Read index="0" count="7431382" average="128.66" stdev="32.61"/><Read index="1" count="7431382" average="128.69" stdev="32.61"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="7431382"/><Elements count="1912493765"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="1912493765"><Base value="A" count="407979598"/><Base value="C" count="547363377"/><Base value="G" count="546957262"/><Base value="T" count="405999120"/><Base value="N" count="4194408"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6380334" alias="16S_V4_11"><IDENTIFIERS><PRIMARY_ID>SRX6380334</PRIMARY_ID></IDENTIFIERS><TITLE>16S amplicons of Sphagnum peat microorganisms: soil incubation</TITLE><STUDY_REF accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The RNeasy PowerSoil DNA Elution Kit (QIAGEN) was used to isolate metagenomic DNA from Sphagnum peat soil. PCR amplification, starting with the peat metagenomic DNA, was then carried out on the V4 region of the 16S rRNA gene sequences in each sample. The resulting 16S amplicons were then prepared for sequencing on the Illumina MiSeq platform.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5040883"><IDENTIFIERS><PRIMARY_ID>SRS5040883</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>16S_V4_11</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Princeton Env Inst / Geosciences" center_name="Princeton University" accession="SRA915420" alias="SUB5867921"><IDENTIFIERS><PRIMARY_ID>SRA915420</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB5867921</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="https://scholar.princeton.edu/xinningz/home"><Name>Princeton University</Name><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Contact email="jwilmoth@princeton.edu"><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Name><First>Jared</First><Last>Wilmoth</Last><Middle>Lee</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA551662" accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA551662</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>The role of oxygen in stimulating methane production in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Emissions of the potent greenhouse gas methane by wetland peats are a key uncertainty in the modern methane budget. Recent observations indicating wetland regions exposed to oxygen (O2) are large CH4 sources pose a paradox as methanogenesis is an anaerobic process. Here, we use incubations of Sphagnum peat to directly demonstrate that peat exposed to O2 dramatically increases its CH4 yields (~20-2000 fold) during subsequent anoxic incubation compared to peat remaining anoxic. O2 initiates efficient degradation of peat polyphenolic constituents by microbial aromatic oxygenases, which enhances peat carbon lability during later anaerobic microbial processing, yielding additional methanogenic precursors that stimulate methane production. The results indicate a critical role for spatiotemporal oxic-anoxic transitions in modulating wetland CH4 production, with implications for carbon-climate feedbacks and wetland management.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="7.16.AWT_16S_V4" accession="SRS5040883"><IDENTIFIERS><PRIMARY_ID>SRS5040883</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162625</EXTERNAL_ID><SUBMITTER_ID namespace="pda|zhanglabprinceton2019" label="Sample name">7.16.AWT_16S_V4</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>551662</ID><LABEL>PRJNA551662</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Sphagnum peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-06-01</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Andover, MA, Ward Reservation</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>42.38 N 71.06 W</VALUE></SAMP