4 production, with implications for carbon-climate feedbacks and wetland management.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="8.18.AWT_16S_V4" accession="SRS5040884"><IDENTIFIERS><PRIMARY_ID>SRS5040884</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162626</EXTERNAL_ID><SUBMITTER_ID namespace="pda|zhanglabprinceton2019" label="Sample name">8.18.AWT_16S_V4</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>551662</ID><LABEL>PRJNA551662</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Sphagnum peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-06-01</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Andover, MA, Ward Reservation</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>42.38 N 71.06 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Time Point</TAG><VALUE>5</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Layer</TAG><VALUE>AWT</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>%O2 Treatment</TAG><VALUE>0</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Sample Key order</TAG><VALUE>32</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS5040884" sample_name="8.18.AWT_16S_V4" spots="61468" bases="27961831" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS5040884</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162626</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="27961831" spots="61468" bytes="13432539"><RUN accession="SRR9617320" alias="8.18.AWT_12_L001_R1_001.fastq.gz" total_sp