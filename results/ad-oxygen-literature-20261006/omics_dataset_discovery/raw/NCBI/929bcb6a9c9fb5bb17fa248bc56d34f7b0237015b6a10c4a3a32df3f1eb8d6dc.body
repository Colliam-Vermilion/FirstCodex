SEQUENCE"><Statistics source="meta"><Rows count="79032"/><Elements count="35953255"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="35953255"><Base value="A" count="7957636"/><Base value="C" count="9687091"/><Base value="G" count="9613210"/><Base value="T" count="8692992"/><Base value="N" count="2326"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6380344" alias="16S_V4_31"><IDENTIFIERS><PRIMARY_ID>SRX6380344</PRIMARY_ID></IDENTIFIERS><TITLE>16S amplicons of Sphagnum peat microorganisms: soil incubation</TITLE><STUDY_REF accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The RNeasy PowerSoil DNA Elution Kit (QIAGEN) was used to isolate metagenomic DNA from Sphagnum peat soil. PCR amplification, starting with the peat metagenomic DNA, was then carried out on the V4 region of the 16S rRNA gene sequences in each sample. The resulting 16S amplicons were then prepared for sequencing on the Illumina MiSeq platform.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5040894"><IDENTIFIERS><PRIMARY_ID>SRS5040894</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>16S_V4_31</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Princeton Env Inst / Geosciences" center_name="Princeton University" accession="SRA915420" alias="SUB5867921"><IDENTIFIERS><PRIMARY_ID>SRA915420</PRIMARY_ID><SUBMITTER_ID namespace="Princeton University">SUB5867921</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute" url="https://scholar.princeton.edu/xinningz/home"><Name>Princeton University</Name><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Contact email="jwilmoth@princeton.edu"><Address postal_code="08544"><Department>Princeton Env Inst / Geosciences</Department><Institution>Princeton University</Institution><Street>Guyot Hall</Street><City>Princeton</City><Sub>NJ</Sub><Country>United States of America</Country></Address><Name><First>Jared</First><Last>Wilmoth</Last><Middle>Lee</Middle></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA551662" accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA551662</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>The role of oxygen in stimulating methane production in wetlands</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Emissions of the potent greenhouse gas methane by wetland peats are a key uncertainty in the modern methane budget. Recent observations indicating wetland regions exposed to oxygen (O2) are large CH4 sources pose a paradox as methanogenesis is an anaerobic process. Here, we use incubations of Sphagnum peat to directly demonstrate that peat exposed to O2 dramatically increases its CH4 yields (~20-2000 fold) during subsequent anoxic incubation compared to peat remaining anoxic. O2 initiates efficient degradation of peat polyphenolic constituents by microbial aromatic oxygenases, which enhances peat carbon lability during later anaerobic microbial processing, yielding additional methanogenic precursors that stimulate methane production. The results indicate a critical role for spatiotemporal oxic-anoxic transitions in modulating wetland CH4 production, with implications for carbon-climate feedbacks and wetland management.</STUDY_ABSTRACT></DESCRIPTOR></STUDY><SAMPLE alias="5.all.DNA_16S_V4" accession="SRS5040894"><IDENTIFIERS><PRIMARY_ID>SRS5040894</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162645</EXTERNAL_ID><SUBMITTER_ID namespace="pda|zhanglabprinceton2019" label="Sample name">5.all.DNA_16S_V4</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>1799672</TAXON_ID><SCIENTIFIC_NAME>peat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>551662</ID><LABEL>PRJNA551662</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>host</TAG><VALUE>not applicable</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>Sphagnum peat soil</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2017-06-01</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: Andover, MA, Ward Reservation</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>42.38 N 71.06 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Time Point</TAG><VALUE>5</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Layer</TAG><VALUE>UNS</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>%O2 Treatment</TAG><VALUE>10</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>Sample Key order</TAG><VALUE>51</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>Metagenome or environmental</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS5040894" sample_name="5.all.DNA_16S_V4" spots="92811" bases="42221237" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS5040894</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN12162645</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="42221237" spots="92811" bytes="19081996"><RUN accession="SRR9617309" alias="5.all.DNA_4_L001_R1_001.fastq.gz" total_spots="92811" total_bases="42221237" size="19081996" load_done="true" published="2020-07-24 00:01:53" is_public="true" cluster_name="public" has_taxanalysis="1" static_data