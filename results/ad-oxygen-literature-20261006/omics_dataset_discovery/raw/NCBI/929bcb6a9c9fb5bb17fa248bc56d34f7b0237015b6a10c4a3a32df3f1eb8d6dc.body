ation="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="7254989"><Read index="0" count="7254989" average="129.34" stdev="33.84"/><Read index="1" count="7254989" average="129.43" stdev="33.81"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="7254989"/><Elements count="1877400742"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="1877400742"><Base value="A" count="386180898"/><Base value="C" count="551563274"/><Base value="G" count="551089721"/><Base value="T" count="382636320"/><Base value="N" count="5930529"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX6380326" alias="16S_V4_19"><IDENTIFIERS><PRIMARY_ID>SRX6380326</PRIMARY_ID></IDENTIFIERS><TITLE>16S amplicons of Sphagnum peat microorganisms: soil incubation</TITLE><STUDY_REF accession="SRP212436"><IDENTIFIERS><PRIMARY_ID>SRP212436</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>The RNeasy PowerSoil DNA Elution Kit (QIAGEN) was used to isolate metagenomic DNA from Sphagnum peat soil. PCR amplification, starting with the peat metagenomic DNA, was then carried out on the V4 region of the 16S rRNA gene sequences in each sample. The resulting 16S amplicons were then prepared for sequencing on the Illumina MiSeq platform.</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS5040876"><IDENTIFIERS><PRIMARY_ID>SRS5040876</PRIMARY_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>16S_V4_19</LIBRARY_NAME><LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY><LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>PCR</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Princeton Env Inst / Geosciences" center_name="Princeton Univers