unt="60021908" average="125.57" stdev="36.52"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="60021908"/><Elements count="15073540728"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="15073540728"><Base value="A" count="3597684085"/><Base value="C" count="3936868590"/><Base value="G" count="3981441428"/><Base value="T" count="3557520291"/><Base value="N" count="26334"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM4152245" accession="SRX7114588"><IDENTIFIERS><PRIMARY_ID>SRX7114588</PRIMARY_ID></IDENTIFIERS><TITLE>GSM4152245: CL4Light; aquifer metagenome; RNA-Seq</TITLE><STUDY_REF accession="SRP229066" refname="GSE140055"><IDENTIFIERS><PRIMARY_ID>SRP229066</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS5625444"><IDENTIFIERS><PRIMARY_ID>SRS5625444</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM4152245</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>RNA was extracted using a bead-beating phenol-chloroform protocol modified from (Schmitt et al. 1990), shaken with a Tissuelyzer II (QIAgen) instead of a beadbeater and precipitated using 1 vol isopropanol and 0.5 vol 7.5 M ammonium acetate. After isopycnic centrifugation, RNA was converted to double stranded cDNA using the SuperScript IV First-Strand Synthesis System and SuperScript Double-Stranded cDNA Synthesis Kit (Thermofisher). Library preparation was performed using the Nextera XT kit (Illumina) according to manufacturer protocols.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq 6000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><XREF_