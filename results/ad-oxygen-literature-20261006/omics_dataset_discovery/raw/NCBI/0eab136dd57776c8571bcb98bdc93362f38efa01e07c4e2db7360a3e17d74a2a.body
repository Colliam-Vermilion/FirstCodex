ene as substrate, and extracted RNA was separated into heavy (labeled) and light (unlabeled) fractions, which were sequenced to determine the identity of toluene-degraders in the 4 experimental conditions.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE140055</CENTER_PROJECT_NAME></DESCRIPTOR></STUDY><SAMPLE alias="GSM4152232" accession="SRS5625431"><IDENTIFIERS><PRIMARY_ID>SRS5625431</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN13229246</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM4152232</EXTERNAL_ID></IDENTIFIERS><TITLE>GEO accession GSM4152232 is currently private and is scheduled to be released on Nov 08, 2019.</TITLE><SAMPLE_NAME><TAXON_ID>1704045</TAXON_ID><SCIENTIFIC_NAME>aquifer metagenome</SCIENTIFIC_NAME></SAMPLE_NAME></SAMPLE><Pool><Member member_name="" accession="SRS5625431" sample_name="GSM4152232" sample_title="GEO accession GSM4152232 is currently private and is scheduled to be released on Nov 08, 2019." spots="68961057" bases="16312248230" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIERS><PRIMARY_ID>SRS5625431</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN13229246</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM4152232</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="16312248230" spots="68961057" bytes="5495996976"><RUN alias="GSM4152232_r1" accession="SRR10416370" total_spots="68961057" total_bases="16312248230" size="5495996976" load_done="true" published="2019-11-12 00:39:19" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR10416370</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM4152232_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX7114575" refname="GSM4152232"/><Pool><Member member_name="" accession="SRS5625431" sample_name="GSM4152232" sample_title="GEO accession GSM4152232 is currently private and is scheduled to be released on Nov 08, 2019." spots="68961057" bases="16312248230" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIER