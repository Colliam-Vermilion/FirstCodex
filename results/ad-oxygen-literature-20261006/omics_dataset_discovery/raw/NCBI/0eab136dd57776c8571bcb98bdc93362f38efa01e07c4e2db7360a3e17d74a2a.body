osm experiment using hydrocarbon-contaminated sediment incubated under 4 redox conditions: aerobic, microoxic, microoxic with nitrate, and anoxic with nitrate. Microcosms were provided with 13C-labeled toluene as substrate, and extracted RNA was separated into heavy (labeled) and light (unlabeled) fractions, which were sequenced to determine the identity of toluene-degraders in the 4 experimental conditions.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>GSE140055</CENTER_PROJECT_NAME></DESCRIPTOR></STUDY><SAMPLE alias="GSM4152234" accession="SRS5625433"><IDENTIFIERS><PRIMARY_ID>SRS5625433</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN13229244</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM4152234</EXTERNAL_ID></IDENTIFIERS><TITLE>GEO accession GSM4152234 is currently private and is scheduled to be released on Nov 08, 2019.</TITLE><SAMPLE_NAME><TAXON_ID>1704045</TAXON_ID><SCIENTIFIC_NAME>aquifer metagenome</SCIENTIFIC_NAME></SAMPLE_NAME></SAMPLE><Pool><Member member_name="" accession="SRS5625433" sample_name="GSM4152234" sample_title="GEO accession GSM4152234 is currently private and is scheduled to be released on Nov 08, 2019." spots="59226971" bases="14069844694" tax_id="1704045" organism="aquifer metagenome"><IDENTIFIERS><PRIMARY_ID>SRS5625433</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN13229244</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM4152234</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="14069844694" spots="59226971" bytes="4836443601"><RUN alias="GSM4152234_r1" accession="SRR10416372" total_spots="59226971" total_bases="14069844694" size="4836443601" load_done="true" published="2019-11-12 00:39:19" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR10416372</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM4152234_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX7114577" refname="GSM4152234"/><Pool><Member member_name="" accession="SRS5625433" sample_name="GSM4152234"