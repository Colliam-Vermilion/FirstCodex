                    <DataType>metagenome</DataType>
                </IntendedDataTypeSet>
                <ProjectDataTypeSet>
                    <DataType>raw sequence reads</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
