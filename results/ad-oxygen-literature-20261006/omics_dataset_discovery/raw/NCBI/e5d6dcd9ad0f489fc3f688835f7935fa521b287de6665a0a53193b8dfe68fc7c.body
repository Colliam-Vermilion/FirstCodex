<RecordSet><DocumentSummary uid="1483160">
    <Project>
        <ProjectID>
            <ArchiveID accession="PRJDB37862" archive="DDBJ" id="1483160"/>
        </ProjectID>
        <ProjectDescr>
            <Name>activated sludge metagenome</Name>
            <Title>Low dissolved oxygen and low pH driven effective start-up of microaerobic activated sludge process to convert nitrogen compounds in fermentation industrial wastewater to ammonium</Title>
            <Description>This study focuses on the microaerobic activated sludge (MAS) process developed to convert and retain ammonium in industrial fermentation wastewater. We aim to examine microbial community dynamics by amplifying 16S and 18S rRNA genes from DNA extracted from activated sludge in a continuous-flow cultivation reactor during the MAS process. Understanding these communities will shed light on mechanisms that enable efficient ammonium conversion and maintain stability under microaerobic conditions. The findings are expected to help optimize MAS performance and support sustainable nitrogen recovery in industrial fermentation wastewater treatment. Experiments were carried out under controlled conditions, with key operational parameters (e.g., dissolved oxygen concentration, pH) deliberately varied to evaluate their effects on microbial community structure and ammonium conversion efficiency.</Description>
            <ProjectReleaseDate>2026-06-16T22:03:28Z</ProjectReleaseDate>
        </ProjectDescr>
        <ProjectType>
            <ProjectTypeSubmission>
                <Target capture="eTargetedLocusLoci" material="eGenome" sample_scope="eEnvironment">
                    <Organism species="942017" taxID="942017">
                        <OrganismName>activated sludge metagenome</OrganismName>
                        <Supergroup>eOther</Supergroup>
                    </Organism>
                </Target>
                <Method method_type="eSequencing"/>
                <Objectives>
                    <Data data_type="eRawSequenceReads"/>
                </Objectives>
                <ProjectDataTypeSet>
                    <DataType>Targeted Locus (Loci)</DataType>
                </ProjectDataTypeSet>
            </ProjectTypeSubmission>
        </ProjectType>
    </Project>
