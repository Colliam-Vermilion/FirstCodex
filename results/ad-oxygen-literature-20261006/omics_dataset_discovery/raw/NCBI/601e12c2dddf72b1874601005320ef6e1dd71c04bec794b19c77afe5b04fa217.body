ce><Reference><Citation>Gao J., Gu F., NH A., Ruan H., He G. Investigation on Culturable Microflora in Tibetan Kefir Grains from Different Areas of China. J. Food Sci. 2012;77:M425&#x2013;M433. doi: 10.1111/j.1750-3841.2012.02805.x.</Citation><ArticleIdList><ArticleId IdType="doi">10.1111/j.1750-3841.2012.02805.x</ArticleId><ArticleId IdType="pubmed">22860591</ArticleId></ArticleIdList></Reference><Reference><Citation>P&#xe9;rez V., Dorador C., Molina V., Y&#xe1;&#xf1;ez C., Hengst M. Rhodobacter Sp. Rb3, an Aerobic Anoxygenic Phototroph which Thrives in the Polyextreme Ecosystem of the Salar de Huasco, in the Chilean Altiplano. Antonie Van Leeuwenhoek. 2018;111:1449&#x2013;1465. doi: 10.1007/s10482-018-1067-z.</Citation><ArticleIdList><ArticleId IdType="doi">10.1007/s10482-018-1067-z</ArticleId><ArticleId IdType="pubmed">29569108</ArticleId></ArticleIdList></Reference><Reference><Citation>Zhang W., Tang Y., Liu H., Li Y., Zhang Z., Yu Y. Prokaryotic Taxonomy and Functional Diversity Assessment of Different Sequencing Platform in a Hyper-Arid Gobi Soil in Xinjiang Turpan Basin, China. Front. Microbiol. 2023;14:1125137. doi: 10.3389/fmicb.2023.1211915.</Citation><ArticleIdList><ArticleId IdType="doi">10.3389/fmicb.2023.1211915</ArticleId><ArticleId IdType="pmc">PMC10682777</ArticleId><ArticleId IdType="pubmed">38033567</ArticleId></ArticleIdList></Reference><Reference><Citation>Bonetti G., Trevathan-Tackett S.M., Carnell P.E., Macreadie P.I. Implication of Viral Infections for Greenhouse Gas Dynamics in Freshwater Wetlands: Challenges and Perspectives. Front. Microbiol. 2019;10:1962. doi: 10.3389/fmicb.2019.01962.</Citation><ArticleIdList><ArticleId IdType="doi">10.3389/fmicb.2019.01962</ArticleId><ArticleId IdType="pmc">PMC6718870</ArticleId><ArticleId IdType="pubmed">31507569</ArticleId></ArticleIdList></Reference><Reference><Citation>Cubillos C.F., Aguilar P., Moreira D., Bertolino P., Iniesto M., Dorador C., L&#xf3;pez-Garc&#xed;a P. Exploring the Prokaryote-Euka