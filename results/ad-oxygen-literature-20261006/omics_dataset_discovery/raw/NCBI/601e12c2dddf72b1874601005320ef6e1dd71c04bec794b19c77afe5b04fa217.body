thods</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D010084" MajorTopicYN="N">Oxidation-Reduction</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D001419" MajorTopicYN="N">Bacteria</DescriptorName><QualifierName UI="Q000145" MajorTopicYN="N">classification</QualifierName><QualifierName UI="Q000235" MajorTopicYN="N">genetics</QualifierName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D042083" MajorTopicYN="N">Methylocystaceae</DescriptorName><QualifierName UI="Q000235" MajorTopicYN="N">genetics</QualifierName><QualifierName UI="Q000378" MajorTopicYN="N">metabolism</QualifierName></MeshHeading></MeshHeadingList><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">Methylocella</Keyword><Keyword MajorTopicYN="N">Stable Isotope Probing</Keyword><Keyword MajorTopicYN="N">pmoA gene</Keyword><Keyword MajorTopicYN="N">aerobic methane oxidation</Keyword><Keyword MajorTopicYN="N">crop rotations</Keyword><Keyword MajorTopicYN="N">intensification</Keyword><Keyword MajorTopicYN="N">rice rhizosphere</Keyword></KeywordList><CoiStatement>None declared.</CoiStatement></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="received"><Year>2025</Year><Month>2</Month><Day>18</Day></PubMedPubDate><PubMedPubDate PubStatus="revised"><Year>2025</Year><Month>10</Month><Day>12</Day></PubMedPubDate><PubMedPubDate PubStatus="accepted"><Year>2025</Year><Month>11</Month><Day>10</Day></PubMedPubDate><PubMedPubDate PubStatus="medline"><Year>2025</Year><Month>11</Month><Day>29</Day><Hour>6</Hour><Minute>28</Minute></PubMedPubDate><PubMedPubDate PubStatus="pubmed"><Year>2025</Year><Month>11</Month><Day>13</Day><Hour>18</Hour><Minute>30</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2025</Year><Month>11</Month><Day>13</Day><Hour>12</Hour><Minute>14</Minute></PubMedPubDate><PubMedPubDate PubStatus="pmc-release"><Year>2025</Year><Month>11</Month><Day>13</Day></PubMedPubDate>