0032" MajorTopicYN="N">analysis</QualifierName></MeshHeading><MeshHeading><DescriptorName UI="D059014" MajorTopicYN="N">High-Throughput Nucleotide Sequencing</DescriptorName></MeshHeading><MeshHeading><DescriptorName UI="D002947" MajorTopicYN="N">Cities</DescriptorName></MeshHeading></MeshHeadingList><KeywordList Owner="NOTNLM"><Keyword MajorTopicYN="N">Jialing River</Keyword><Keyword MajorTopicYN="N">aerobic methanotrophs</Keyword><Keyword MajorTopicYN="N">high&#x2010;throughput sequencing</Keyword><Keyword MajorTopicYN="N">microbial community</Keyword><Keyword MajorTopicYN="N">urban river sediment</Keyword></KeywordList><CoiStatement>The authors declare no conflicts of interest.</CoiStatement></MedlineCitation><PubmedData><History><PubMedPubDate PubStatus="revised"><Year>2025</Year><Month>6</Month><Day>19</Day></PubMedPubDate><PubMedPubDate PubStatus="received"><Year>2025</Year><Month>1</Month><Day>8</Day></PubMedPubDate><PubMedPubDate PubStatus="accepted"><Year>2025</Year><Month>7</Month><Day>17</Day></PubMedPubDate><PubMedPubDate PubStatus="medline"><Year>2025</Year><Month>7</Month><Day>30</Day><Hour>6</Hour><Minute>30</Minute></PubMedPubDate><PubMedPubDate PubStatus="pubmed"><Year>2025</Year><Month>7</Month><Day>30</Day><Hour>0</Hour><Minute>29</Minute></PubMedPubDate><PubMedPubDate PubStatus="entrez"><Year>2025</Year><Month>7</Month><Day>29</Day><Hour>20</Hour><Minute>4</Minute></PubMedPubDate><PubMedPubDate PubStatus="pmc-release"><Year>2025</Year><Month>7</Month><Day>29</Day></PubMedPubDate></History><PublicationStatus>ppublish</PublicationStatus><ArticleIdList><ArticleId IdType="pubmed">40730357</ArticleId><ArticleId IdType="pmc">PMC12307030</ArticleId><ArticleId IdType="doi">10.1111/1758-2229.70167</ArticleId></ArticleIdList><ReferenceList><Reference><Citation>Ahmadi, F. , and Lackner M.. 2024. &#x201c;Recent Findings in Methanotrophs: Genetics, Molecular Ecology, and Biopotential.&#x201d; Applied Microbiology and Biotechnology 108: 60. 10.1007/s00253-023-