cation="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="17001556"><Read index="0" count="17001556" average="144.83" stdev="11.49"/><Read index="1" count="17001556" average="144.65" stdev="11.57"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="17001556"/><Elements count="4921722028"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="4921722028"><Base value="A" count="1270272874"/><Base value="C" count="1200501731"/><Base value="G" count="1224441984"/><Base value="T" count="1226493109"/><Base value="N" count="12330"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX29870047" alias="2201DE2_1.05.1234_MT"><IDENTIFIERS><PRIMARY_ID>SRX29870047</PRIMARY_ID></IDENTIFIERS><TITLE>Metatranscriptome of iron mat microcosm - Mat DE2; replicate 1; time: 5 minutes</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>An Illumina Low Input (RNA) library was constructed and sequenced 2x151 using the Illumina NovaSeq platform. Raw reads were processed with BBDuk (version 39.01) to remove contaminants, trim adapter sequences, remove homopolymer tails with 5 Gs, and right quality trim reads where quality drops to 0. BBDuk was also used to remove reads that contained 1 or more 'N' bases, had an average quality score below 10, or had a minimum length &lt;51 bp. Reads mapped with BBMap to contaminants (human, cat, dog, mouse, common microbial contaminants, ribosomal RNA, or known spike-ins) were also removed</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21513453"><IDENTIFIERS><PRIMARY_ID>SRS21513453</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570303</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>2201DE2