R34735826" size="878759476" date="2025-07-28 13:15:24" md5="e788fc895226785451a60672476dea79" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR34735826/SRR34735826" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR34735826.lite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1307/SRR034/34735/SRR34735826/SRR34735826.lite.1" size="633632368" date="2025-07-28 15:06:34" md5="f39490ba202e71b48e9295347486c77b" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos13/sra-pub-zq-1307/SRR034/34735/SRR34735826/SRR34735826.lite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-9/SRR34735826/SRR34735826.lite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-102/SRR34735826/SRR34735826.lite.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="2" nspots="12496448"><Read index="0" count="12496448" average="146.05" stdev="10.00"/><Read index="1" count="12496448" average="146.02" stdev="10.01"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="12496448"/><Elements count="3649821479"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="3649821479"><Base value="A" count="898916792"/><Base value="C" count="921308859"/><Base value="G" count="937772540"/><Base value="T" count="891819338"/><Base value="N" count="3950"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM1181833" accession="SRX318576" center_name="GEO"><IDENTIFIERS><PRIMARY_ID>SRX318576</PRIMARY_ID></IDENTIFIERS><TITLE>GSM1181833: H111 wt aeobic; Burkholderia cenocepacia H111; RNA-Seq</TITLE><STUDY_REF accession="SRP026606" refname="GSE48585"><IDENTIFIERS><PRIMARY_ID>SRP026606</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS455461"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM1181833</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>Cells were flash frozen on dry ice, and RNA was harvested using hot phenol protocol (Pessi et al. 2007) and DNA was removed. First-strand cDNA synthesis was performed using an oligo(dT)-adapter primer and the M-MLV reverse transcriptase. The resulting cDNA was PCR-amplified to about 20-30 ng/μl using a high fidelity DNA polymerase. The cDNA was purified using the Agencourt AMPure XP kit (Beckman Coulter Genomics) and was analyzed by capillary electrophoresis. The primers used for PCR amplification were designed for TruSeq sequencing according to the instructions of Illumina. The following adapter sequences flank the cDNA inserts: TrueSeq_Sense_primer 5' ́-AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCT-3'; TrueSeq_Antisense_NNNNNN_primer Barcode 5'-CAAGCAGAAGACGGCATACGAGAT-NNNNNN-GTGACTGGAGTTCAGACGTGTGCTCTTCCGATC(dT25)-3'.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><URL_LINK><LABEL>GEO Sample</LABEL><URL>http://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSM1181833</URL></URL_LINK></EXPERIMENT_LINK><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>301181833</ID></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM1181833</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE48585" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA092244"><IDENTIFIERS><PRIMARY_ID>SRA092244</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE48585</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">Gene Expression Omnibus</Name></Organization><STUDY center_name="GEO" alias="GSE48585" accession="SRP026606"><IDENTIFIERS><PRIMARY_ID>SRP026606</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA210753</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE48585</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Response of Burkholderia cenocepacia H111 to micro-oxia</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>B. cenocepacia is an opportunistic human pathogen that is particularly problematic for patients suffering from cystic fibrosis (CF). In the CF lung, bacteria grow to high densities within the viscous mucus that is limited in oxygen. Pseudomonas aeruginosa, the dominant pathogen in CF patients, is known to grow and survive under oxygen-limited to anaerobic conditions by using micro-oxic respiration, denitrification and fermentative pathways. In contrast, inspection of the genome sequences of available B. cenocepacia strains suggested that B. cenocepacia is an obligate aerobic and non-fermenting bacterium. In accordance with the bioinformatics analysis, we observed that B. cenocepacia H111 is able to grow with as little as 0.1% O2 but not under strictly anoxic conditions. Phenotypic analyses revealed that H111 produced larger amounts of biofilm, pellicle and proteases under micro-oxic conditions (0.5% - 5% O2, i.e. conditions that mimic those encountered in CF lung infection), and was more resistant to several antibiotics. RNA-Seq and shotgun proteomics analyses of cultures of B. cenocepacia H111 grown under micro-oxic and aerobic conditions showed up-regulation of genes involved in the synthesis of the exopolysaccharide (EPS) cepacian as well as several proteases, two isocitrate lyases and other genes potentially important for life in micro-oxia. Overall design: Oxygen regulation in Burkholderia cenocepacia was investigated using RNA-Seq of cells grown under aerobic or micro-oxic conditions.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>Burkholderia cenocepacia H111</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>24023794</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE center_name="GEO" alias="GSM1181833" accession="SRS455461"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN02228109</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1181833</EXTERNAL_ID></IDENTIFIERS><TITLE>H111 wt aeobic</TITLE><SAMPLE_NAME><TAXON_ID>1055524</TAXON_ID><SCIENTIFIC_NAME>Burkholderia cenocepacia H111</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>210753</ID><LABEL>PRJNA210753</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Bc H111 planktonic cells, aerobic conditions</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain/background</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype/variation</TAG><VALUE>wild-type</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>growth condition</TAG><VALUE>aerobic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>cell type</TAG><VALUE>planktonic cells, OD600 equal 0.8</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>medium</TAG><VALUE>complex medium LB</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS455461" sample_name="GSM1181833" sample_title="H111 wt aeobic" spots="3019150" bases="274742650" tax_id="1055524" organism="Burkholderia cenocepacia H111"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN02228109</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1181833</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="274742650" spots="3019150" bytes="177843832"><RUN alias="GSM1181833_r1" accession="SRR926845" center_name="GEO" total_spots="3019150" total_bases="274742650" size="177843832" load_done="true" published="2013-07-15 16:18:59" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR926845</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM1181833_r1</SUBMITTER_ID></IDENTIFIERS><EXPERIMENT_REF accession="SRX318576" refname="GSM1181833"><IDENTIFIERS><PRIMARY_ID>SRX318576</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GSM1181833</SUBMITTER_ID></IDENTIFIERS></EXPERIMENT_REF><Pool><Member member_name="" accession="SRS455461" sample_name="GSM1181833" sample_title="H111 wt aeobic" spots="3019150" bases="274742650" tax_id="1055524" organism="Burkholderia cenocepacia H111"><IDENTIFIERS><PRIMARY_ID>SRS455461</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN02228109</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1181833</EXTERNAL_ID></IDENTIFIERS></Member></Pool><SRAFiles><SRAFile cluster="public" filename="Burkholderia_cenocepacia_RNA_aerob_A_minus_TEX.fq" size="732127203" date="2020-05-23 13:45:33" md5="a20230e9ddf14dc5abae8a947c747304" version="1" semantic_name="fastq" supertype="Original" sratoolkit="0"><Alternatives url="s3://sra-pub-src-9/SRR926845/Burkholderia_cenocepacia_RNA_aerob_A_minus_TEX.fq" free_egress="-" access_type="Use Cloud Data Delivery" org="AWS"/></SRAFile><SRAFile cluster="public" filename="SRR926845.sralite" url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR000/926/SRR926845/SRR926845.sralite.1" size="76043826" date="2020-06-22 03:59:42" md5="850ecadf105b655991fc1fcd1cbde57a" version="1" semantic_name="SRA Lite" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos12/sra-pub-zq-1211/SRR000/926/SRR926845/SRR926845.sralite.1" free_egress="worldwide" access_type="anonymous" org="NCBI"/><Alternatives url="s3://sra-pub-zq-2/SRR926845/SRR926845.sralite.1" free_egress="s3.us-east-1" access_type="aws identity" org="AWS"/><Alternatives url="gs://sra-pub-zq-106/SRR926845/SRR926845.zq.1" free_egress="gs.us-east1" access_type="gcp identity" org="GCP"/></SRAFile><SRAFile cluster="public" filename="SRR926845" url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR926845/SRR926845" size="177845581" date="2013-07-08 11:23:35" md5="e20bcc11dd0c9746a3e27fc91919e623" version="1" semantic_name="SRA Normalized" supertype="Primary ETL" sratoolkit="1"><Alternatives url="https://sra-pub-run-odp.s3.amazonaws.com/sra/SRR926845/SRR926845" free_egress="worldwide" access_type="anonymous" org="AWS"/></SRAFile></SRAFiles><CloudFiles><CloudFile filetype="fastq" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run" provider="s3" location="s3.us-east-1"/><CloudFile filetype="run.zq" provider="gs" location="gs.us-east1"/><CloudFile filetype="run.zq" provider="s3" location="s3.us-east-1"/></CloudFiles><Statistics nreads="1" nspots="3019150"><Read index="0" count="3019150" average="91" stdev="0"/></Statistics><Bases cs_native="false" count="274742650"><Base value="A" count="110241859"/><Base value="C" count="61861720"/><Base value="G" count="61252505"/><Base value="T" count="41367968"/><Base value="N" count="18598"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT alias="GSM1181834" accession="SRX318577" center_name="GEO"><IDENTIFIERS><PRIMARY_ID>SRX318577</PRIMARY_ID></IDENTIFIERS><TITLE>GSM1181834: H111 wt micro-oxic; Burkholderia cenocepacia H111; RNA-Seq</TITLE><STUDY_REF accession="SRP026606" refname="GSE48585"><IDENTIFIERS><PRIMARY_ID>SRP026606</PRIMARY_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION/><SAMPLE_DESCRIPTOR accession="SRS472331"><IDENTIFIERS><PRIMARY_ID>SRS472331</PRIMARY_ID><EXTERNAL_ID namespace="GEO">GSM1181834</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>TRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>cDNA</LIBRARY_SELECTION><LIBRARY_LAYOUT><SINGLE/></LIBRARY_LAYOUT><LIBRARY_CONSTRUCTION_PROTOCOL>Cells were flash frozen on dry ice, and RNA was harvested using hot phenol protocol (Pessi et al. 2007) and DNA was removed. First-strand cDNA synthesis was performed using an oligo(dT)-adapter primer and the M-MLV reverse transcriptase. The resulting cDNA was PCR-amplified to about 20-30 ng/μl using a high fidelity DNA polymerase. The cDNA was purified using the Agencourt AMPure XP kit (Beckman Coulter Genomics) and was analyzed by capillary electrophoresis. The primers used for PCR amplification were designed for TruSeq sequencing according to the instructions of Illumina. The following adapter sequences flank the cDNA inserts: TrueSeq_Sense_primer 5' ́-AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCT-3'; TrueSeq_Antisense_NNNNNN_primer Barcode 5'-CAAGCAGAAGACGGCATACGAGAT-NNNNNN-GTGACTGGAGTTCAGACGTGTGCTCTTCCGATC(dT25)-3'.</LIBRARY_CONSTRUCTION_PROTOCOL></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina HiSeq 2000</INSTRUMENT_MODEL></ILLUMINA></PLATFORM><EXPERIMENT_LINKS><EXPERIMENT_LINK><URL_LINK><LABEL>GEO Sample</LABEL><URL>http://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSM1181834</URL></URL_LINK></EXPERIMENT_LINK><EXPERIMENT_LINK><XREF_LINK><DB>gds</DB><ID>301181834</ID></XREF_LINK></EXPERIMENT_LINK></EXPERIMENT_LINKS><EXPERIMENT_ATTRIBUTES><EXPERIMENT_ATTRIBUTE><TAG>GEO Accession</TAG><VALUE>GSM1181834</VALUE></EXPERIMENT_ATTRIBUTE></EXPERIMENT_ATTRIBUTES></EXPERIMENT><SUBMISSION alias="GEO: GSE48585" broker_name="GEO" center_name="GEO" submission_comment="submission brokered by GEO" lab_name="" accession="SRA092244"><IDENTIFIERS><PRIMARY_ID>SRA092244</PRIMARY_ID><SUBMITTER_ID namespace="GEO">GEO: GSE48585</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="center"><Name abbr="GEO">Gene Expression Omnibus</Name></Organization><STUDY center_name="GEO" alias="GSE48585" accession="SRP026606"><IDENTIFIERS><PRIMARY_ID>SRP026606</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA210753</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSE48585</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Response of Burkholderia cenocepacia H111 to micro-oxia</STUDY_TITLE><STUDY_TYPE existing_study_type="Transcriptome Analysis"/><STUDY_ABSTRACT>B. cenocepacia is an opportunistic human pathogen that is particularly problematic for patients suffering from cystic fibrosis (CF). In the CF lung, bacteria grow to high densities within the viscous mucus that is limited in oxygen. Pseudomonas aeruginosa, the dominant pathogen in CF patients, is known to grow and survive under oxygen-limited to anaerobic conditions by using micro-oxic respiration, denitrification and fermentative pathways. In contrast, inspection of the genome sequences of available B. cenocepacia strains suggested that B. cenocepacia is an obligate aerobic and non-fermenting bacterium. In accordance with the bioinformatics analysis, we observed that B. cenocepacia H111 is able to grow with as little as 0.1% O2 but not under strictly anoxic conditions. Phenotypic analyses revealed that H111 produced larger amounts of biofilm, pellicle and proteases under micro-oxic conditions (0.5% - 5% O2, i.e. conditions that mimic those encountered in CF lung infection), and was more resistant to several antibiotics. RNA-Seq and shotgun proteomics analyses of cultures of B. cenocepacia H111 grown under micro-oxic and aerobic conditions showed up-regulation of genes involved in the synthesis of the exopolysaccharide (EPS) cepacian as well as several proteases, two isocitrate lyases and other genes potentially important for life in micro-oxia. Overall design: Oxygen regulation in Burkholderia cenocepacia was investigated using RNA-Seq of cells grown under aerobic or micro-oxic conditions.</STUDY_ABSTRACT><CENTER_PROJECT_NAME>Burkholderia cenocepacia H111</CENTER_PROJECT_NAME></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>24023794</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE center_name="GEO" alias="GSM1181834" accession="SRS472331"><IDENTIFIERS><PRIMARY_ID>SRS472331</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN02228106</EXTERNAL_ID><EXTERNAL_ID namespace="GEO">GSM1181834</EXTERNAL_ID></IDENTIFIERS><TITLE>H111 wt micro-oxic</TITLE><SAMPLE_NAME><TAXON_ID>1055524</TAXON_ID><SCIENTIFIC_NAME>Burkholderia cenocepacia H111</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>210753</ID><LABEL>PRJNA210753</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>source_name</TAG><VALUE>Bc H111 planktonic cells, micro-oxic conditions</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain/background</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>genotype/variation</TAG><VALUE>wild-type</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>growth condition</TAG><VALUE>micro-oxic</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>cell type</TAG><VALUE>planktonic cells, OD600 equal 0.4</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>medium</TAG><VALUE>complex medium LB</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>strain</TAG><VALUE>H111</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS472331" sample_name="GSM1181834" sample_title="H111 wt micro-oxic" spots="2822229" bases="256822839" tax_id="1055524" organism="Burkholderia cenocepacia H111"><IDENTIFIERS><PRIMARY_ID>SRS472331</PRIMARY_ID><EXTERNA