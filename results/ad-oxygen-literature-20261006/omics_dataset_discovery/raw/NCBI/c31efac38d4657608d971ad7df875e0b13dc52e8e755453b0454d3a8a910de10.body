nitially spiked with sulfate, and, thereafter, were periodically amended with small amounts of sulfate. Triplicate microcosms were set up per incubation condition (36 microcosms in total).</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_size</TAG><VALUE>30 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>samp_vol_we_dna_ext</TAG><VALUE>0.3 g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>source_material_id</TAG><VALUE>Sb_2010.microcosm_30.day_08</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>water_content_soil</TAG><VALUE>0.78 g/g</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>sulfate_stimulated</TAG><VALUE>no</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>amended_substrate</TAG><VALUE>butyrate</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>incubation_time_days</TAG><VALUE>8</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>microcosm_id</TAG><VALUE>30</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>replicate</TAG><VALUE>3</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIMS.me</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>BioSampleModel</TAG><VALUE>MIGS/MIMS/MIMARKS.soil</VALUE></SAMPLE_ATTRIBUTE></SAMPLE_ATTRIBUTES></SAMPLE><Pool><Member member_name="" accession="SRS2871873" sample_name="Sb_2010_peat_soil_microcosm_30_B-S_08d" sample_title="Peat soil microcosm, amended with butyrate, incubated for 8 days (replicate 3)" spots="23672800" bases="7101840000" tax_id="1799672" organism="peat metagenome"><IDENTIFIERS><PRIMARY_ID>SRS2871873</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN05384433</EXTERNAL_ID></IDENTIFIERS></Member></Pool><RUN_SET runs="1" bases="7101840000" spots="23672800" bytes="4050905431"><RUN accession="SRR5253613" alias="JGI-SRA-12438" total_spots="23672800" total_bases="7101840000" size="4050905431" load_done="true" published="2017-02-14 12:11:18" is_public="true" cluster_name="public" has_taxanalysis="1" static_data_available="1"><IDENTIFIERS><PRIMARY_ID>SRR5253613</PRIMARY_ID><EXTERNAL_ID namesp