05" average="143.50" stdev="13.05"/></Statistics><Databases><Database><Table name="SEQUENCE"><Statistics source="meta"><Rows count="11286305"/><Elements count="3240102374"/></Statistics></Table></Database></Databases><Bases cs_native="false" count="3240102374"><Base value="A" count="832274263"/><Base value="C" count="789586181"/><Base value="G" count="805245315"/><Base value="T" count="812993149"/><Base value="N" count="3466"/></Bases></RUN></RUN_SET></EXPERIMENT_PACKAGE><EXPERIMENT_PACKAGE><EXPERIMENT accession="SRX29870062" alias="2105ISCOC1_1.0.1_MT"><IDENTIFIERS><PRIMARY_ID>SRX29870062</PRIMARY_ID></IDENTIFIERS><TITLE>Metatranscriptome of iron mat microcosm - Mat ISCOC1; replicate 1; time: 0 minutes</TITLE><STUDY_REF accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS></STUDY_REF><DESIGN><DESIGN_DESCRIPTION>An Illumina Low Input (RNA) library was constructed and sequenced 2x151 using the Illumina NovaSeq platform. Raw reads were processed with BBDuk (version 39.01) to remove contaminants, trim adapter sequences, remove homopolymer tails with 5 Gs, and right quality trim reads where quality drops to 0. BBDuk was also used to remove reads that contained 1 or more 'N' bases, had an average quality score below 10, or had a minimum length &lt;51 bp. Reads mapped with BBMap to contaminants (human, cat, dog, mouse, common microbial contaminants, ribosomal RNA, or known spike-ins) were also removed</DESIGN_DESCRIPTION><SAMPLE_DESCRIPTOR accession="SRS21513455"><IDENTIFIERS><PRIMARY_ID>SRS21513455</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570324</EXTERNAL_ID></IDENTIFIERS></SAMPLE_DESCRIPTOR><LIBRARY_DESCRIPTOR><LIBRARY_NAME>2105ISCOC1_1.0.1_MT</LIBRARY_NAME><LIBRARY_STRATEGY>RNA-Seq</LIBRARY_STRATEGY><LIBRARY_SOURCE>METATRANSCRIPTOMIC</LIBRARY_SOURCE><LIBRARY_SELECTION>other</LIBRARY_SELECTION><LIBRARY_LAYOUT><PAIRED/></LIBRARY_LAYOUT></LIBRARY_DESCRIPTOR></DESIGN><PLATFORM><ILLUMINA><INSTRUMENT_MODEL>Illumina NovaSeq X</INSTRUMENT_MODEL></ILLUMINA></PLATFORM></EXPERIMENT><SUBMISSION lab_name="Earth Sciences" center_name="University of Delaware" accession="SRA2181357" alias="SUB15496401"><IDENTIFIERS><PRIMARY_ID>SRA2181357</PRIMARY_ID><SUBMITTER_ID namespace="University of Delaware">SUB15496401</SUBMITTER_ID></IDENTIFIERS></SUBMISSION><Organization type="institute"><Name>University of Delaware</Name><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Contact email="gtothero@udel.edu" sec_email="graceetothero@gmail.com"><Address postal_code="19713"><Department>Earth Sciences</Department><Institution>University of Delaware</Institution><Street>590 Avenue 1743</Street><City>Newark</City><Sub>DE</Sub><Country>USA</Country></Address><Name><First>Gracee</First><Last>Tothero</Last></Name></Contact></Organization><STUDY center_name="BioProject" alias="PRJNA1117470" accession="SRP511621"><IDENTIFIERS><PRIMARY_ID>SRP511621</PRIMARY_ID><EXTERNAL_ID namespace="BioProject" label="primary">PRJNA1117470</EXTERNAL_ID></IDENTIFIERS><DESCRIPTOR><STUDY_TITLE>Metagenomes of iron microbial mats from a freshwater terrestrial stream and wetlands. Metagenome</STUDY_TITLE><STUDY_TYPE existing_study_type="Other"/><STUDY_ABSTRACT>Our work focuses on Tims Branch at the Savannah River Site (SRS), a tributary that flowsdirectly into the Savannah River in South Carolina. Macroscopic freshwater iron mats are widespread inTims Branch; furthermore, microscopy of these mats shows biomineral morphologies consistent with theknown FeOB genera Leptothrix and Gallionella. These factors make Tims Branch ideal for studying ironoxidizers. This project is designed to fill research gaps surrounding the rate and controls on environmentaliron oxidation, and the metabolism of FeOB.The research objectives are:Objective 1: Quantify microbial iron oxidation rates in terrestrial iron mats using an integratedfield and kinetics studyObjective 2: Identify and quantify dominant iron-oxidizing microorganisms in terrestrialiron mats using metagenomics and metatranscriptomicsObjective 3: Construct microbial metabolic models of iron oxidizers and iron matcommunities to link microbial iron oxidation to C, N and S cycling</STUDY_ABSTRACT></DESCRIPTOR><STUDY_LINKS><STUDY_LINK><XREF_LINK><DB>pubmed</DB><ID>39133000</ID></XREF_LINK></STUDY_LINK></STUDY_LINKS></STUDY><SAMPLE alias="2105ISCOC1" accession="SRS21513455"><IDENTIFIERS><PRIMARY_ID>SRS21513455</PRIMARY_ID><EXTERNAL_ID namespace="BioSample">SAMN41570324</EXTERNAL_ID><SUBMITTER_ID namespace="pda|gtothero@orcid" label="Sample name">2105ISCOC1</SUBMITTER_ID></IDENTIFIERS><SAMPLE_NAME><TAXON_ID>527640</TAXON_ID><SCIENTIFIC_NAME>microbial mat metagenome</SCIENTIFIC_NAME></SAMPLE_NAME><SAMPLE_LINKS><SAMPLE_LINK><XREF_LINK><DB>bioproject</DB><ID>1117470</ID><LABEL>PRJNA1117470</LABEL></XREF_LINK></SAMPLE_LINK></SAMPLE_LINKS><SAMPLE_ATTRIBUTES><SAMPLE_ATTRIBUTE><TAG>collection_date</TAG><VALUE>2021-05-19</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>depth</TAG><VALUE>35</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>elev</TAG><VALUE>260</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_broad_scale</TAG><VALUE>freshwater stream</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_local_scale</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>env_medium</TAG><VALUE>iron microbial mat</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>geo_loc_name</TAG><VALUE>USA: South Carolina, Savannah River Site</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>lat_lon</TAG><VALUE>33.32 N 81.71 W</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolate</TAG><VALUE>2105ISCOC1</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_ATTRIBUTE><TAG>isolation_source</TAG><VALUE>iron microbial mat from freshwater stream</VALUE></SAMPLE_ATTRIBUTE><SAMPLE_